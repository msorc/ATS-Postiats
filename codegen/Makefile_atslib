######
#
# This is for generating atslib source code
# [atslib] currently includes the following ones:
# [prelude], [libc] and [libats]
#
#
######

ROOT="."

######
#
all:: prelude
#
######
#
prelude:: \
prelude_sats
prelude_sats:: ; \
  make -C $(ROOT)/prelude/SATS/SRCGEN -f Makefile.gen
prelude_sats:: ; \
  make -C $(ROOT)/prelude/SATS/SRCGEN -f Makefile all
#
prelude:: \
prelude_dats
prelude_dats:: ; \
  make -C $(ROOT)/prelude/DATS/SRCGEN -f Makefile.gen
prelude_dats:: ; \
  make -C $(ROOT)/prelude/DATS/SRCGEN -f Makefile all
prelude_dats:: ; \
  make -C $(ROOT)/prelude/DATS/SHARE/SRCGEN -f Makefile.gen
prelude_dats:: ; \
  make -C $(ROOT)/prelude/DATS/SHARE/SRCGEN -f Makefile all
#
prelude:: \
prelude_cats
prelude_cats:: ; \
  make -C $(ROOT)/prelude/CATS/SRCGEN -f Makefile.gen
prelude_cats:: ; \
  make -C $(ROOT)/prelude/CATS/SRCGEN -f Makefile all
#
######

clean:: ; \
make -C $(ROOT)/prelude/SATS/SRCGEN -f Makefile clean
clean:: ; \
make -C $(ROOT)/prelude/DATS/SRCGEN -f Makefile clean
clean:: ; \
make -C $(ROOT)/prelude/CATS/SRCGEN -f Makefile clean

######

cleanall:: ; \
make -C $(ROOT)/prelude/SATS/SRCGEN -f Makefile cleanall
cleanall:: ; \
make -C $(ROOT)/prelude/DATS/SRCGEN -f Makefile cleanall
cleanall:: ; \
make -C $(ROOT)/prelude/CATS/SRCGEN -f Makefile cleanall

