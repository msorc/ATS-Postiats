######

HERE:=$(dir $(abspath $(lastword $(MAKEFILE_LIST))))

include $(HERE)Makefile_vars

######

all:: libatsynmark

######

SATS=$(HERE)SATS
DATS=$(HERE)DATS

######

GENHATS=$(SATS)/libatsynmark_gen.hats $(DATS)/libatsynmark_gen_dats.hats

$(SATS)/libatsynmark_gen.hats: $(HERE)libatsynmark.spec $(PATSHOME)/utils/arenagen/arenagen.py
	python3 $(PATSHOME)/utils/arenagen/arenagen.py --global sats $< > $@
$(DATS)/libatsynmark_gen_dats.hats: $(HERE)libatsynmark.spec $(PATSHOME)/utils/arenagen/arenagen.py
	python3 $(PATSHOME)/utils/arenagen/arenagen.py --global --compact dats $< > $@

gen:: ; $(RMF) $(GENHATS)
gen:: $(GENHATS)

######

# the modules of the library (every module is compiled by itself)
MODULES=libatsynmark libatsynmark_psynmark libatsynmark_pats2xhtml \
  libatsynmark_pats2xhtml_bground libatsynmark_pats2xhtml_embedded

OBJECTS=$(addsuffix _dats.o,$(MODULES)) dynloadall_dats.o

libatsynmark:: libatsynmark.a

libatsynmark.a: $(OBJECTS)
	$(RMF) $@; $(AR) rcs $@ $^

######

%_dats.c: $(DATS)/%.dats $(SATS)/libatsynmark.sats $(GENHATS)
	$(PATSOPT) --output $@ --dynamic $<

dynloadall_dats.c: $(HERE)dynloadall.dats $(SATS)/libatsynmark.sats
	$(PATSOPT) --output $@ --dynamic $<

# the template instantiations of the clients need the .dats of the others
libatsynmark_pats2xhtml_bground_dats.c libatsynmark_pats2xhtml_embedded_dats.c: \
  $(DATS)/libatsynmark_psynmark.dats $(DATS)/libatsynmark_pats2xhtml.dats

%_dats.o: %_dats.c
	$(PATSCC) -fPIC -c -o $@ $<

.PRECIOUS: %_dats.c

######

check:: $(GENHATS)
	@for f in $(SATS)/libatsynmark.sats; do echo "typecheck $$f"; $(PATSOPT) --typecheck -s $$f >/dev/null || exit 1; done
	@for f in $(addprefix $(DATS)/,$(addsuffix .dats,$(MODULES))) $(HERE)dynloadall.dats; do \
	  echo "typecheck $$f"; $(PATSOPT) --typecheck -d $$f >/dev/null || exit 1; done

######

clean:: ; $(RMF) *~
clean:: ; $(RMF) *_dats.c *_dats.o

cleanall:: clean
cleanall:: ; $(RMF) libatsynmark.a

distclean:: cleanall

###### end of [Makefile for libatsynmark] ######
