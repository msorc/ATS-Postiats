(*
**
** Some utility functions for
** marking level-1 syntax of ATS2
**
** Author: Hongwei Xi
** Authoremail: gmhwxiATgmailDOTcom
**
** Start Time: June, 2012
**
*)

(* ****** ****** *)
//
// HX-2026-10: no GC (ATS2 port of the ATS1 version of this file).
// What changed (see src/PORTING.md, "pats2xhtml and libatsynmark"):
//
// - [putc_type] is a flat pair (env, function): a closure cannot be
//   made (a cloref [lam] is rejected). Build one with [putc_make], call
//   one with [putc_call].
// - [psynmark] is the flat tuple (lint, synmark, int); [synmark] is an
//   enumeration (the constructors that carried a [globalref], an
//   abstract type of which no value can be made, are nullary).
// - [charlst] is [glist(char)]; [d0eclrep] is generated by arenagen
//   (libatsynmark.spec): match on [d0eclrep_view(x)] with [~D0ECLREPsing(..)].
// - the lexing and parsing modules are the ATS2 ones: [token] is the
//   arena token of src/pats_lexing.sats, a syntax tree is a [glist].
//
(* ****** ****** *)

(* ****** ****** *)
//
staload "libats/SATS/arena.sats"
//
(* ****** ****** *)
//
typedef charlst = glist(char)
vtypedef charlst_vt = List0_vt(char)
//
(* ****** ****** *)
//
staload
ERR = "src/pats_error.sats"
//
(* ****** ****** *)
//
staload
SYM = "src/pats_symbol.sats"
//
typedef symbol = $SYM.symbol
//
(* ****** ****** *)
//
staload
LOC = "src/pats_location.sats"
//
typedef position = $LOC.position
typedef location = $LOC.location
//
(* ****** ****** *)
//
fun
fprint_position(out: FILEref, x: position): void
//
fun
fprint_location(out: FILEref, x: location): void
//
(* ****** ****** *)
//
staload
FIL = "src/pats_filename.sats"
(*
// HX-2012-12:
// this is needed for [#include] and [staload]
*)
fun
libatsynmark_filename_set_current (name: string): void
//
(* ****** ****** *)
//
// HX-2026-10:
// the initialization of this library and of libatsopt (the C function
// [libatsynmark_dynloadall]): call it first, as [dynload
// "utils/libatsynmark/dynloadall.dats"] did in ATS1
//
fun
libatsynmark_dynloadall
  ((*void*)): void = "ext#libatsynmark_dynloadall"
//
(* ****** ****** *)
//
// HX-2026-10: this is [char_list_vt_make_file] of the ATS1 prelude
// (all the characters of a file; a byte >= 128 is a negative char)
//
fun
libatsynmark_char_list_vt_make_file(inp: FILEref): charlst_vt
//
(* ****** ****** *)
//
// HX-2026-10: this is [fopen_exn] of the ATS1 library: it prints
// [perror("fopen")] and [exit(ATS): [fopen("name", "mode")] failed]
// to stderr, and exits (status 1), if the file cannot be opened
//
fun
libatsynmark_fopen_exn
  (name: string, mode: string): FILEref = "ext#libatsynmark_fopen_exn"
//
(* ****** ****** *)
//
absvtype lexbufobj = ptr
//
fun lexbufobj_free(lbf: lexbufobj): void
//
fun
lexbufobj_make_string(inp: string): lexbufobj
fun
lexbufobj_make_charlst_vt(inp: charlst_vt): lexbufobj
fun
lexbufobj_make_fileref(inp: FILEref): lexbufobj
//
(* ****** ****** *)
//
staload
LEX = "src/pats_lexing.sats"
//
typedef token = $LEX.token
typedef tokenlst = glist(token)
vtypedef tokenlst_vt = List0_vt(token)
//
(* ****** ****** *)
//
fun
token_get_loc(x: token): location
//
(* ****** ****** *)
//
fun
fprint_token (out: FILEref, x: token): void
//
(* ****** ****** *)
//
fun token_is_eof (x: token): bool
fun token_is_comment (x: token): bool
fun token_is_extcode (x: token): bool
fun token_is_keyword (x: token): bool
//
(* ****** ****** *)
//
fun token_is_int (x: token): bool
fun token_is_char (x: token): bool
fun token_is_float (x: token): bool
fun token_is_string (x: token): bool
//
(* ****** ****** *)
//
fun
lexbufobj_get_tokenlst(lbf: !lexbufobj): tokenlst_vt
//
(* ****** ****** *)
//
absvtype tokbufobj = ptr
//
fun tokbufobj_make_lexbufobj (lbf: lexbufobj): tokbufobj
//
fun tokbufobj_free (tbf: tokbufobj): void
fun tokbufobj_unget_token (tbf: !tokbufobj, tok: token): void
//
(* ****** ****** *)
//
staload
SYN = "src/pats_syntax.sats"
//
typedef p0at = $SYN.p0at
typedef d0ecl = $SYN.d0ecl
//
(* ****** ****** *)
//
fun
test_symbol_p0at (sym: symbol, p0t: p0at): bool
//
fun
test_symbol_d0ecl (sym: symbol, d0c: d0ecl): bool
//
(* ****** ****** *)
//
// HX-2026-10: generated from libatsynmark.spec
//
#include "./libatsynmark_gen.hats"
//
(* ****** ****** *)
fun
charlst_declitemize
  (stadyn: int, inp: charlst_vt): d0eclreplst
// end of [charlst_declitemize]
(* ****** ****** *)
//
// HX: global references
abstype globalref // for sta/dyn-constants
//
(* ****** ****** *)
datatype
synmark =
//
  | SMnone
//
  | SMcomment // comment
  | SMkeyword // keyword
  | SMextcode // external code
//
  | SMstaexp // static expression
  | SMprfexp // proof expression
  | SMdynexp // dynamic expression
  | SMneuexp // neutral expression
//
  | SMstalab // static labels
  | SMdynlab // dynamic labels
//
  | SMdynstr // dynamic strings
//
  | SMscst_def // (globalref)
  | SMscst_use // (globalref)
//
  | SMscon_dec // (globalref)
  | SMscon_use // (globalref)
  | SMscon_assume // (globalref)
//
  | SMdcst_dec // (globalref)
  | SMdcst_use // (globalref)
  | SMdcst_implement // (globalref)
//
// end of [synmark]
fun fprint_synmark (out: FILEref, sm: synmark): void
(* ****** ****** *)
//
// knd = 0/1: beg / end
//
typedef psynmark = @(lint, synmark, int)
//
vtypedef psynmarklst_vt = List0_vt(psynmark)
//
(* ****** ****** *)
fun fprint_psynmark (out: FILEref, psm: psynmark): void
(* ****** ****** *)
(*
** HX-2012-06:
** synmark info for tokens
*)
fun listize_token2psynmark
  (toks: !tokenlst_vt): psynmarklst_vt
// end of [listize_token2psynmark]
(* ****** ****** *)
(*
** HX-2012-06:
** splitting psm list into two:
** beg-psm list and end-psm list
*)
fun psynmarklst_split (xs: psynmarklst_vt)
  : @(psynmarklst_vt(*beg*), psynmarklst_vt(*end*))
// end of [psynmarklst_split]
(* ****** ****** *)
(*
** HX-2012-06:
** synmark info for various syntatic entities
*)
fun tokbufobj_get_psynmarklst
  (stadyn: int, tbf: !tokbufobj): psynmarklst_vt
// end of [tokbufobj_get_psynmarklst]
(* ****** ****** *)
//
// HX-2026-10: a closure, as a pair (env, function)
//
typedef
putc_fun_type = (ptr, char) -> int
typedef
putc_type = @(ptr, putc_fun_type)
//
fun
putc_make
  (env: ptr, f: putc_fun_type): putc_type
fun
putc_call (putc: putc_type, c: char): int
//
(* ****** ****** *)
//
// HX-2026-10: a string builder, the [putc] of the functions that return a
// string ([env] is made by [sbuf_make], [sbuf_putc] appends the char to it,
// [sbuf_takeout] frees it and returns the string; C code of libatsynmark.dats)
//
fun
libatsynmark_sbuf_make
  ((*void*)): ptr = "ext#libatsynmark_sbuf_make"
fun
libatsynmark_sbuf_putc
  (env: ptr, c: char): int = "ext#libatsynmark_sbuf_putc"
fun
libatsynmark_sbuf_takeout
  (env: ptr): Strptr1 = "ext#libatsynmark_sbuf_takeout"
//
fun
libatsynmark_strptr_make_charlst(cs: charlst): Strptr1
//
(* ****** ****** *)
