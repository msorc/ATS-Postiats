#
# Makefile for atsynmark: pats2xhtml (run in BUILD/: make -C BUILD -f ../Makefile_build)
#
# HX-2026-10: pats2xhtml is written in ATS2 (no GC) and built by patsopt and the C
# compiler alone, with libatsynmark.a (utils/libatsynmark) and libatsopt.a (the compiler
# as a library: `make -C src libatsopt.a`, Makefile_devl or utils/libatsopt). ATS1 is
# not needed. Both libraries are built here if they are missing.
#
# Targets: pats2xhtml (the default), check (typecheck the files), clean, cleanall
#
# Variables: PATSHOME (the repository), PATSOPT, CC, CCFLAGS,
# LIBATSOPT (the path of libatsopt.a), LIBGMP (-lgmp; empty if libatsopt.a was
# built with C3NSTRINTKND=intknd)
#

######

HERE:=$(dir $(abspath $(lastword $(MAKEFILE_LIST))))
SATS=$(HERE)SATS
DATS=$(HERE)DATS

include $(HERE)../libatsynmark/Makefile_vars

######

all:: pats2xhtml

######

OBJECTS=pats2xhtml_main_dats.o pats2xhtml_level1_dats.o

pats2xhtml: $(OBJECTS) $(LIBSYNMARK) $(LIBATSOPT)
	$(PATSCC) -o $@ $(OBJECTS) $(LIBSYNMARK) $(LIBATSOPT) $(LIBGMP)

######

pats2xhtml_main_dats.c: $(DATS)/pats2xhtml_main.dats $(SATS)/pats2xhtml.sats
	$(PATSOPT) --output $@ --dynamic $<
pats2xhtml_level1_dats.c: $(DATS)/pats2xhtml_level1.dats $(SATS)/pats2xhtml.sats $(LIBSYNMARK)
	$(PATSOPT) --output $@ --dynamic $<

%_dats.o: %_dats.c
	$(PATSCC) -c -o $@ $<

.PRECIOUS: %_dats.c

######

check::
	@for f in $(SATS)/pats2xhtml.sats; do echo "typecheck $$f"; $(PATSOPT) --typecheck -s $$f >/dev/null || exit 1; done
	@for f in $(DATS)/pats2xhtml_level1.dats $(DATS)/pats2xhtml_main.dats; do \
	  echo "typecheck $$f"; $(PATSOPT) --typecheck -d $$f >/dev/null || exit 1; done

######

clean:: ; $(RMF) *~
clean:: ; $(RMF) *_dats.c *_dats.o

cleanall:: clean
cleanall:: ; $(RMF) pats2xhtml

distclean:: cleanall

###### end of [Makefile for atsynmark] ######
