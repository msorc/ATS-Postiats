  (): atext = atext_strcst ("\
/***********************************************************************/\n\
/*                                                                     */\n\
/*                         Applied Type System                         */\n\
/*                                                                     */\n\
/***********************************************************************/\n\
") // end of [atscode_banner_for_C]

