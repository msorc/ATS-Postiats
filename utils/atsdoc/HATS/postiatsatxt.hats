#ifndef ATSDOC_POSTIATSATXT
#define ATSDOC_POSTIATSATXT 1

(* ****** ****** *)
//
// HX-2026-10: no GC (ATS2 port of the ATS1 version of this file): the
// prelude is loaded here (the programs generated by atsdoc are ATS2 programs)
//
#include "share/atspre_staload.hats"
//
staload UN = "prelude/SATS/unsafe.sats"
//
staload
STDIO = "libats/libc/SATS/stdio.sats"
staload TIME = "libats/libc/SATS/time.sats"
//
dynload "libatsdoc/dynloadall.dats"
//
staload "libatsdoc/SATS/libatsdoc_atext.sats"
//
#include "utils/atsdoc/HATS/atsdoc_compat.hats"
//
(* ****** ****** *)

fun comment
  (x: string): atext = let
  val _beg = "(*\n" and _end = "\n*)"
in
  atext_appstr3 (_beg, x, _end)
end // end of [comment]

fun ignoretxt (x: atext): atext = atext_nil ()

(* ****** ****** *)

fun timestamp
  (): atext = let
  var time = $TIME.time_get ()
  val (fpf | x) = $TIME.ctime (time)
  val x1 = $UN.castvwtp1{string}(x)
//
  fun loop
    (p: ptr, i: size_t): size_t =
    if $UN.ptr0_get<char> (p) != '\000' then (
      if $UN.ptr0_get<char> (p) != '\n' then loop (ptr0_succ<char> (p), succ(i)) else i
    ) else i // end of [if]
  // end of [loop]
//
  val n = loop ($UN.cast{ptr}(x1), i2sz(0))
  val x2 = string0_copy (x1)
  val () = $UN.ptr0_set<char> (ptr0_add_guint<char> ($UN.castvwtp1{ptr}(x2), n), '\000')
  prval () = fpf (x)
//
in
  atext_strptr (x2)
end // end of [timestamp]

(* ****** ****** *)

fun atscode_banner
  (): atext = atext_strcst ("\
(***********************************************************************)\n\
(*                                                                     *)\n\
(*                         Applied Type System                         *)\n\
(*                                                                     *)\n\
(***********************************************************************)\n\
") // end of [atscode_banner]

