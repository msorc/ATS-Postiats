#
# A simple Makefile
# for building libatsopt
#

######

#
# libatsopt.a is built by $(PATSHOME)/src (the compiler is written in ATS2 now): it
# contains the compiler and the C API of utils/libatsopt (src/libatsopt_ext.c,
# src/libatsopt_ext.dats), so there is nothing to add. The stage-0 compiler is the
# one of src/Makefile (PATSOPT=, STAGE0HOME=, see src/README).
#
######

# PATSHOME is the root of this repository (it defaults to it)
ifeq ($(origin PATSHOME),undefined)
PATSHOME := $(abspath $(dir $(realpath $(lastword $(MAKEFILE_LIST))))/../..)
endif
export PATSHOME

all:: libatsopt
all:: libatsopt_ext

######
#
libatsopt:: libatsopt_gmp
#
#libatsopt:: libatsopt_int
#
######
#
# For building libatsopt with libgmp dependency
#
libatsopt_gmp:: ; $(RMF) libatsopt.a
libatsopt_gmp:: ; \
$(MAKE) -C $(PATSHOME)/src cleanall
libatsopt_gmp:: ; \
$(MAKE) -C $(PATSHOME)/src C3NSTRINTKND=gmpknd libatsopt.a && $(CPF) $(PATSHOME)/src/libatsopt.a .
#
######
#
# For building libatsopt without libgmp dependency
#
libatsopt_int:: ; $(RMF) libatsopt.a
libatsopt_int:: ; \
$(MAKE) -C $(PATSHOME)/src cleanall
libatsopt_int:: ; \
$(MAKE) -C $(PATSHOME)/src C3NSTRINTKND=intknd libatsopt.a && $(CPF) $(PATSHOME)/src/libatsopt.a .
#
######
#
# the extension (the C API of libatsopt) is part of src/libatsopt.a
#
libatsopt_ext:: ; true
#
######

######

AR= ar
RMF=rm -f
CPF=cp -f
MVF=mv -f
MAKE=make

######

clean:: ; $(RMF) *~
clean:: ; $(RMF) *_?ats.c
clean:: ; $(RMF) *_?ats.o

######

cleanall:: clean
cleanall:: ; $(RMF) libatsopt.a

###### end of [Makefile] ######
