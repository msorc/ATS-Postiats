} // end of [jsonats_parsexn_fileref]

implement
{}(*tmp*)
jsonats_parsexnlst_fileref
  (inp) = (jsvs) where
{
//
val cs0 = cstream_make_fileref (inp)
val tknr = tokener_make_cstream (cs0)
val t2knr = tokener2_make_tokener (tknr)
//
val jsvs = jsonats_parsexnlst<> (t2knr)
