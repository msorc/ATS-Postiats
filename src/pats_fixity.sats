(* ****** ****** *)
//
staload
LOC = "./pats_location.sats"
//
typedef location = $LOC.location
//
staload "libats/SATS/arena.sats"
//
(* ****** ****** *)

datatype
assoc =
| ASSOCnon | ASSOClft | ASSOCrgt

fun
fprint_assoc (out: FILEref, x: assoc): void
overload fprint with fprint_assoc

(* ****** ****** *)
//
// HX: precedence value
//
abst@ype prec_t0ype = int
  typedef prec = prec_t0ype
//
(* ****** ****** *)

val neginf_prec : prec = "ext#patsopt_neginf_prec" // lowest legal precedence value
val posinf_prec : prec = "ext#patsopt_posinf_prec" // highest legal precedence value

(* ****** ****** *)

val app_prec : prec = "ext#patsopt_app_prec" // the precedence value for application

(* ****** ****** *)

val select_prec : prec = "ext#patsopt_select_prec" // the precedence value for selection

(* ****** ****** *)

val backslash_prec : prec = "ext#patsopt_backslash_prec" 
val infixtemp_prec : prec = "ext#patsopt_infixtemp_prec" // for temp infix status

(* ****** ****** *)

val exi_prec_sta : prec = "ext#patsopt_exi_prec_sta" 
val uni_prec_sta : prec = "ext#patsopt_uni_prec_sta"

(* ****** ****** *)

val delay_prec_dyn : prec = "ext#patsopt_delay_prec_dyn" 

val exist_prec_dyn : prec = "ext#patsopt_exist_prec_dyn" 

(* ****** ****** *)

val ptrof_prec_dyn : prec = "ext#patsopt_ptrof_prec_dyn" 
val addrat_prec_dyn : prec = "ext#patsopt_addrat_prec_dyn" 

val foldat_prec_dyn : prec = "ext#patsopt_foldat_prec_dyn" 
val freeat_prec_dyn : prec = "ext#patsopt_freeat_prec_dyn" 
val viewat_prec_dyn : prec = "ext#patsopt_viewat_prec_dyn" 

(* ****** ****** *)

val invar_prec_sta : prec = "ext#patsopt_invar_prec_sta" 

val qmark_prec_sta : prec = "ext#patsopt_qmark_prec_sta" 

val qmarkbang_prec_sta : prec = "ext#patsopt_qmarkbang_prec_sta" 

val trans_prec_sta : prec = "ext#patsopt_trans_prec_sta" // for >>

val deref_prec_dyn : prec = "ext#patsopt_deref_prec_dyn" 

(* ****** ****** *)

fun int_of_prec (p: prec): int
fun prec_make_int (i: int): prec

fun precedence_inc (p: prec, i: int): prec
fun precedence_dec (p: prec, i: int): prec

(* ****** ****** *)

fun compare_prec_prec (p1: prec, p2: prec): Sgn
overload compare with compare_prec_prec

(* ****** ****** *)

//
// HX-2026-10: no GC
// fxty is generated by arenagen (--global) from [pats_fixity.spec];
// [fxty_view] is for pattern matching and [fxty_FXTYinf] etc.
// are the constructors
//
#include "./pats_fixity_gen.hats"
(* ****** ****** *)

fun prerr_fxty (fxty: fxty): void
fun print_fxty (fxty: fxty): void
fun fprint_fxty
  (out: FILEref, fxty: fxty): void
// end of [fprint_fxty]

(* ****** ****** *)

val fxty_non : fxty = "ext#patsopt_fxty_non" 
fun fxty_inf (p: prec, a: assoc): fxty
fun fxty_pre (p: prec): fxty
fun fxty_pos (p: prec): fxty

(* ****** ****** *)

val deref_fxty_dyn : fxty = "ext#patsopt_deref_fxty_dyn" // for dereference
val selptr_fxty_dyn : fxty = "ext#patsopt_selptr_fxty_dyn" // for lab/ind selection

(* ****** ****** *)

fun fxty_get_prec (fxty: fxty): Option_vt (prec)

(* ****** ****** *)

//
// HX-2026-10: no GC
// A closure cannot be shared (it is neither linear nor in an arena),
// so the closures stored in an fxopr are explicit pairs (function, env):
// a function takes the environment [env] (usually allocated by
// [the_garena_alloc]) as its first argument; this is closure conversion.
//
abstype fxopr_type(a:type) = ptr
typedef fxopr(a:type) = fxopr_type(a)
abstype fxitm_type(a:type) = ptr
typedef fxitm(a:type) = fxitm_type(a)
//
typedef
fxfn1(a:type) = @(ptr, (ptr, a) -> fxitm(a)) // (env, fun)
typedef
fxfn2(a:type) = @(ptr, (ptr, a, a) -> fxitm(a)) // (env, fun)
//
datavtype
fxopr_view(a:type) = 
  | FXOPRinf of (prec, assoc, fxfn2(a))
  | FXOPRpre of (prec, fxfn1(a))
  | FXOPRpos of (prec, fxfn1(a))
and fxitm_view(a:type) =
  | FXITMatm of (a) | FXITMopr of (location, fxopr(a))
//
fun{a:type} fxopr_encode(v: fxopr_view(a)): fxopr(a)
fun{a:type} fxopr_view(x: fxopr(a)): fxopr_view(a)
fun{a:type} fxitm_encode(v: fxitm_view(a)): fxitm(a)
fun{a:type} fxitm_view(x: fxitm(a)): fxitm_view(a)
//
fun{a:type} fxopr_FXOPRinf(p: prec, asc: assoc, f: fxfn2(a)): fxopr(a)
fun{a:type} fxopr_FXOPRpre(p: prec, f: fxfn1(a)): fxopr(a)
fun{a:type} fxopr_FXOPRpos(p: prec, f: fxfn1(a)): fxopr(a)
fun{a:type} fxitm_FXITMatm(x: a): fxitm(a)
fun{a:type} fxitm_FXITMopr(loc: location, opr: fxopr(a)): fxitm(a)
//
fun{a:type} fxopr_precedence (opr: fxopr a): prec
fun{a:type} fxopr_associativity (opr: fxopr a): assoc
(* ****** ****** *)

fun{a:type}
fxitm_app
(
  loc: location, app: fxfn2(a)
) : fxitm a // end of [fxitm_app]

(* ****** ****** *)

fun{a:type}
fxopr_make
(
  locf: a -> location
, appf: (location, a, location, glist(a)) -> a
, oper: a, fxty: fxty
) : fxitm a // end of [fxopr_make]

fun{a:type}
fxopr_make_backslash
( // HX: for handling temp infix status
  locf: a -> location
, appf: (location, a, location, glist(a)) -> a
, loc0: location (* loc of [backslash] *)
) : fxitm a // end of [fxopr_make_backslash]

(* ****** ****** *)

fun{a:type}
fixity_resolve
(
  loc: location
, locf: a -> location, app: fxitm (a), xs: glist (fxitm a)
) : (a) // end of [fixity_resolve]

(* ****** ****** *)

(* end of [pats_fixity.sats] *)
