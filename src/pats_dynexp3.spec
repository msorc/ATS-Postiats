# arenagen specification for pats_dynexp3.{sats,dats}: the level-3 trees (--compact)
# python3 ../utils/arenagen/arenagen.py --global sats pats_dynexp3.spec > pats_dynexp3_gen.hats
# python3 ../utils/arenagen/arenagen.py --global --compact dats pats_dynexp3.spec > pats_dynexp3_gen_dats.hats
#
# Same conventions as pats_dynexp2.spec (see PORTING.md, "Level 3 trees (dynexp3)").
# The mutable parts of ATS1 (the C functions patsopt_p3at_set_type, ..) are [mut] fields of the records:
# p3at_type, p3at_dvaropt, p3at_type_left, d3exp_type, d3lab_overld_app.
# The ATS1 one-constructor datatype [LABP3AT (label, p3at)] is the record [labp3at];
# [dl0abeled (d3exp)] is the record [labd3exp] (as [labd2exp]). The index [n] of [c3lau (n)] is dropped.
typedef p3atlst = glist(p3at)
typedef p3atopt = gopt(p3at)
typedef labp3atlst = glist(labp3at)
typedef d3eclist = glist(d3ecl)
typedef d3eclistopt = gopt(d3eclist)
typedef d3explst = glist(d3exp)
typedef d3expopt = gopt(d3exp)
typedef labd3explst = glist(labd3exp)
typedef d3lablst = glist(d3lab)
typedef i3fclist = glist(i3fcl)
typedef gm3atlst = glist(gm3at)
typedef c3laulst = glist(c3lau)
vtypedef c3laulst_vt = List0_vt(c3lau)
typedef sc3laulst = glist(sc3lau)
typedef f3undeclst = glist(f3undec)
typedef v3aldeclst = glist(v3aldec)
typedef v3ardeclst = glist(v3ardec)
typedef prv3ardeclst = glist(prv3ardec)
type p3at_node
  P3Tany (d2var)
  P3Tvar (d2var)
  P3Tcon (pckind, d2con, int, p3atlst)
  P3Tint (int)
  P3Tintrep (string)
  P3Tbool (bool)
  P3Tchar (char)
  P3Tfloat (string)
  P3Tstring (string)
  P3Ti0nt (i0nt)
  P3Tf0loat (f0loat)
  P3Tempty ()
  P3Trec (int, int, pckind, labp3atlst)
  P3Tlst (int, s2exp, p3atlst)
  P3Trefas (d2var, p3at)
  P3Texist (s2varlst, p3at)
  P3Tvbox (d2var)
  P3Tann (p3at, s2exp)
  P3Terrpat ()
record labp3at (labp3at_lab: label, labp3at_elt: p3at)
record p3at (p3at_loc: location, p3at_node: p3at_node, mut p3at_type: s2exp, mut p3at_dvaropt: d2varopt, mut p3at_type_left: s2expopt)
type d3ecl_node
  D3Cnone ()
  D3Clist (d3eclist)
  D3Csaspdec (s2aspdec)
  D3Creassume (s2cst)
  D3Cextype (string, s2exp)
  D3Cextvar (string, d3exp)
  D3Cextcode (int, int, string)
  D3Cexndecs (d2conlst)
  D3Cdatdecs (int, s2cstlst)
  D3Cdcstdecs (int, dcstkind, d2cstlst)
  D3Cimpdec (int, i3mpdec)
  D3Cfundecs (funkind, s2qualst, f3undeclst)
  D3Cvaldecs (valkind, v3aldeclst)
  D3Cvaldecs_rec (valkind, v3aldeclst)
  D3Cvardecs (v3ardeclst)
  D3Cprvardecs (prv3ardeclst)
  D3Cinclude (int, d3eclist)
  D3Cstaload (symbolopt, filename, int, filenv, int)
  D3Cstaloadloc (filename, symbol, filenv)
  D3Cdynload (filename)
  D3Clocal (d3eclist, d3eclist)
type d3exp_node
  D3Ecst (d2cst)
  D3Evar (d2var)
  D3Eint (int)
  D3Eintrep (string)
  D3Ebool (bool)
  D3Echar (char)
  D3Efloat (string)
  D3Estring (string)
  D3Ei0nt (i0nt)
  D3Ef0loat (f0loat)
  D3Ecstsp (cstsp)
  D3Etyrep (s2exp)
  D3Eliteral (d3exp)
  D3Etop ()
  D3Eempty ()
  D3Eextval (string)
  D3Eextfcall (string, d3explst)
  D3Eextmcall (d3exp, string, d3explst)
  D3Econ (d2con, int, d3explst)
  D3Etmpcst (d2cst, t2mpmarglst)
  D3Etmpvar (d2var, t2mpmarglst)
  D3Efoldat (d3exp)
  D3Efreeat (d3exp)
  D3Eitem (d2itm, t2mpmarglst)
  D3Elet (d3eclist, d3exp)
  D3Eapp_sta (d3exp)
  D3Eapp_dyn (d3exp, int, d3explst)
  D3Eif (d3exp, d3exp, d3exp)
  D3Esif (s2exp, d3exp, d3exp)
  D3Ecase (caskind, d3explst, c3laulst)
  D3Escase (s2exp, sc3laulst)
  D3Eifcase (int, i3fclist)
  D3Elst (int, s2exp, d3explst)
  D3Etup (int, int, d3explst)
  D3Erec (int, int, labd3explst)
  D3Eseq (d3explst)
  D3Eselab (d3exp, d3lablst)
  D3Eptrofvar (d2var)
  D3Eptrofsel (d3exp, s2exp, d3lablst)
  D3Eviewat (d3exp, d3lablst)
  D3Erefarg (int, int, d3exp)
  D3Esel_var (d2var, s2exp, d3lablst)
  D3Esel_ptr (d3exp, s2exp, d3lablst)
  D3Esel_ref (d3exp, s2exp, d3lablst)
  D3Eassgn_var (d2var, s2exp, d3lablst, d3exp)
  D3Eassgn_ptr (d3exp, s2exp, d3lablst, d3exp)
  D3Eassgn_ref (d3exp, s2exp, d3lablst, d3exp)
  D3Exchng_var (d2var, s2exp, d3lablst, d3exp)
  D3Exchng_ptr (d3exp, s2exp, d3lablst, d3exp)
  D3Exchng_ref (d3exp, s2exp, d3lablst, d3exp)
  D3Eviewat_assgn (d3exp, d3lablst, d3exp)
  D3Earrpsz (s2exp, d3explst, int)
  D3Earrinit (s2exp, d3exp, d3explst)
  D3Eraise (d3exp)
  D3Eeffmask (s2eff, d3exp)
  D3Evararg (d3explst)
  D3Evcopyenv (int, d2var)
  D3Etempenver (d2varlst)
  D3Eann_type (d3exp, s2exp)
  D3Elam_dyn (int, int, p3atlst, d3exp)
  D3Elaminit_dyn (int, int, p3atlst, d3exp)
  D3Elam_sta (s2varlst, s2explst, d3exp)
  D3Elam_met (s2explst, d3exp)
  D3Efix (int, d2var, d3exp)
  D3Edelay (d3exp)
  D3Eldelay (d3exp, d3exp)
  D3Elazyeval (int, d3exp)
  D3Eloop (d3expopt, d3exp, d3expopt, d3exp)
  D3Eloopexn (int)
  D3Etrywith (d3exp, c3laulst)
  D3Esolverify (s2exp)
  D3Eerrexp ()
type d3lab_node
  D3LABlab (label)
  D3LABind (d3explst)
record d3ecl (d3ecl_loc: location, d3ecl_node: d3ecl_node)
record d3exp (d3exp_loc: location, mut d3exp_type: s2exp, d3exp_node: d3exp_node)
record labd3exp (labd3exp_lab: l0ab, labd3exp_elt: d3exp)
record d3lab (d3lab_loc: location, d3lab_node: d3lab_node, d3lab_overld: d2symopt, mut d3lab_overld_app: d3expopt)
record i3fcl (i3fcl_loc: location, i3fcl_test: d3exp, i3fcl_body: d3exp)
record gm3at (gm3at_loc: location, gm3at_exp: d3exp, gm3at_pat: p3atopt)
record c3lau (c3lau_loc: location, c3lau_pat: p3atlst, c3lau_gua: gm3atlst, c3lau_seq: int, c3lau_neg: int, c3lau_body: d3exp)
record sc3lau (sc3lau_loc: location, sc3lau_pat: sp2at, sc3lau_body: d3exp)
record i3mpdec (i3mpdec_loc: location, i3mpdec_cst: d2cst, i3mpdec_imparg: s2varlst, i3mpdec_tmparg: s2explstlst, i3mpdec_def: d3exp)
record f3undec (f3undec_loc: location, f3undec_var: d2var, f3undec_def: d3exp)
record v3aldec (v3aldec_loc: location, v3aldec_pat: p3at, v3aldec_def: d3exp)
record v3ardec (v3ardec_loc: location, v3ardec_knd: int, v3ardec_dvar_var: d2var, v3ardec_dvar_view: d2var, v3ardec_type: s2exp, v3ardec_init: d3expopt, v3ardec_dvaropt: d2varopt)
record prv3ardec (prv3ardec_loc: location, prv3ardec_dvar: d2var, prv3ardec_type: s2exp, prv3ardec_init: d3exp)
