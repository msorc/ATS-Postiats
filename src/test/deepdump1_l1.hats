and dd_p1at_node (x: p1at_node): void = case+ x of
  | P1Tany () => (dd_ps "P1Tany("; dd_ps ")")
  | P1Tany2 () => (dd_ps "P1Tany2("; dd_ps ")")
  | P1Tide (a0) => (dd_ps "P1Tide("; dd_symbol a0; dd_ps ")")
  | P1Tdqid (a0, a1) => (dd_ps "P1Tdqid("; dd_d0ynq a0; dd_ps ","; dd_symbol a1; dd_ps ")")
  | P1Tint (a0) => (dd_ps "P1Tint("; dd_int a0; dd_ps ")")
  | P1Tintrep (a0) => (dd_ps "P1Tintrep("; dd_string a0; dd_ps ")")
  | P1Tchar (a0) => (dd_ps "P1Tchar("; dd_char a0; dd_ps ")")
  | P1Tfloat (a0) => (dd_ps "P1Tfloat("; dd_string a0; dd_ps ")")
  | P1Tstring (a0) => (dd_ps "P1Tstring("; dd_string a0; dd_ps ")")
  | P1Ti0nt (a0) => (dd_ps "P1Ti0nt("; dd_i0nt a0; dd_ps ")")
  | P1Tf0loat (a0) => (dd_ps "P1Tf0loat("; dd_f0loat a0; dd_ps ")")
  | P1Tempty () => (dd_ps "P1Tempty("; dd_ps ")")
