(* generated by tree1_gen.py: complete dumper of the level-1 trees (ATS1) *)
fun dd_loc_t (x: loc_t): void = $LOC.fprint_location (dd_out, x)
fun dd_effvar (x: i0de): void = dd_i0de (x)
fun dd_char (x: char): void = fprint_char (dd_out, x)
fun dd_double (x: double): void = fprint_double (dd_out, x)
fun dd_S1Ed2ctype (x: S1Ed2ctype): void = dd_ps "S1Ed2ctype(...)"
fun dd_Stropt (x: Stropt): void = $UT.fprint_stropt (dd_out, x)
fun dd_effect (x: effect): void = $EFF.fprint_effect (dd_out, x)
fun dd_effset (x: effset): void = $EFF.fprint_effset (dd_out, x)
fun dd_caskind (x: caskind): void = fprint_caskind (dd_out, x)
fun dd_dcstkind (x: dcstkind): void = fprint_dcstkind (dd_out, x)
fun dd_funclo (x: funclo): void = fprint_funclo (dd_out, x)

fun dd_v1al (x: v1al): void = case+ x of
  | V1ALint (a0) => (dd_ps "V1ALint("; dd_int a0; dd_ps ")")
  | V1ALchar (a0) => (dd_ps "V1ALchar("; dd_char a0; dd_ps ")")
  | V1ALstring (a0) => (dd_ps "V1ALstring("; dd_string a0; dd_ps ")")
  | V1ALfloat (a0) => (dd_ps "V1ALfloat("; dd_double a0; dd_ps ")")
  | V1ALerr () => (dd_ps "V1ALerr("; dd_ps ")")

and dd_e1xp_node (x: e1xp_node): void = case+ x of
  | E1XPide (a0) => (dd_ps "E1XPide("; dd_symbol a0; dd_ps ")")
  | E1XPint (a0) => (dd_ps "E1XPint("; dd_int a0; dd_ps ")")
  | E1XPintrep (a0) => (dd_ps "E1XPintrep("; dd_string a0; dd_ps ")")
  | E1XPchar (a0) => (dd_ps "E1XPchar("; dd_char a0; dd_ps ")")
  | E1XPfloat (a0) => (dd_ps "E1XPfloat("; dd_string a0; dd_ps ")")
  | E1XPstring (a0) => (dd_ps "E1XPstring("; dd_string a0; dd_ps ")")
  | E1XPv1al (a0) => (dd_ps "E1XPv1al("; dd_v1al a0; dd_ps ")")
  | E1XPnone () => (dd_ps "E1XPnone("; dd_ps ")")
  | E1XPundef () => (dd_ps "E1XPundef("; dd_ps ")")
  | E1XPapp (a0, a1, a2) => (dd_ps "E1XPapp("; dd_e1xp a0; dd_ps ","; dd_location a1; dd_ps ","; dd_e1xplst a2; dd_ps ")")
  | E1XPfun (a0, a1) => (dd_ps "E1XPfun("; dd_symbolist a0; dd_ps ","; dd_e1xp a1; dd_ps ")")
  | E1XPif (a0, a1, a2) => (dd_ps "E1XPif("; dd_e1xp a0; dd_ps ","; dd_e1xp a1; dd_ps ","; dd_e1xp a2; dd_ps ")")
  | E1XPeval (a0) => (dd_ps "E1XPeval("; dd_e1xp a0; dd_ps ")")
  | E1XPlist (a0) => (dd_ps "E1XPlist("; dd_e1xplst a0; dd_ps ")")
  | E1XPerr () => (dd_ps "E1XPerr("; dd_ps ")")

and dd_e1xp (x: e1xp): void = (dd_ps "e1xp{"; dd_ps "e1xp_loc="; dd_location x.e1xp_loc; dd_ps ",e1xp_node="; dd_e1xp_node x.e1xp_node; dd_ps "}")

and dd_effcst (x: effcst): void = case+ x of
  | EFFCSTall () => (dd_ps "EFFCSTall("; dd_ps ")")
  | EFFCSTnil () => (dd_ps "EFFCSTnil("; dd_ps ")")
  | EFFCSTset (a0, a1) => (dd_ps "EFFCSTset("; dd_effset a0; dd_ps ","; dd_effvarlst a1; dd_ps ")")

and dd_s1rt_node (x: s1rt_node): void = case+ x of
  | S1RTapp (a0, a1) => (dd_ps "S1RTapp("; dd_s1rt a0; dd_ps ","; dd_s1rtlst a1; dd_ps ")")
  | S1RTlist (a0) => (dd_ps "S1RTlist("; dd_s1rtlst a0; dd_ps ")")
  | S1RTqid (a0, a1) => (dd_ps "S1RTqid("; dd_s0rtq a0; dd_ps ","; dd_symbol a1; dd_ps ")")
  | S1RTtype (a0) => (dd_ps "S1RTtype("; dd_int a0; dd_ps ")")
  | S1RTerr () => (dd_ps "S1RTerr("; dd_ps ")")

and dd_s1rt (x: s1rt): void = (dd_ps "s1rt{"; dd_ps "s1rt_loc="; dd_location x.s1rt_loc; dd_ps ",s1rt_node="; dd_s1rt_node x.s1rt_node; dd_ps "}")

and dd_s1rtpol (x: s1rtpol): void = (dd_ps "s1rtpol{"; dd_ps "s1rtpol_loc="; dd_location x.s1rtpol_loc; dd_ps ",s1rtpol_srt="; dd_s1rt x.s1rtpol_srt; dd_ps ",s1rtpol_pol="; dd_int x.s1rtpol_pol; dd_ps "}")

and dd_d1atsrtcon (x: d1atsrtcon): void = (dd_ps "d1atsrtcon{"; dd_ps "d1atsrtcon_loc="; dd_location x.d1atsrtcon_loc; dd_ps ",d1atsrtcon_sym="; dd_symbol x.d1atsrtcon_sym; dd_ps ",d1atsrtcon_arg="; dd_s1rtlst x.d1atsrtcon_arg; dd_ps "}")

and dd_d1atsrtdec (x: d1atsrtdec): void = (dd_ps "d1atsrtdec{"; dd_ps "d1atsrtdec_loc="; dd_location x.d1atsrtdec_loc; dd_ps ",d1atsrtdec_sym="; dd_symbol x.d1atsrtdec_sym; dd_ps ",d1atsrtdec_con="; dd_d1atsrtconlst x.d1atsrtdec_con; dd_ps "}")

and dd_s1arg (x: s1arg): void = (dd_ps "s1arg{"; dd_ps "s1arg_loc="; dd_location x.s1arg_loc; dd_ps ",s1arg_sym="; dd_symbol x.s1arg_sym; dd_ps ",s1arg_srt="; dd_s1rtopt x.s1arg_srt; dd_ps "}")

