and dd_s1exp_node (x: s1exp_node): void = case+ x of
  | S1Eide (a0) => (dd_ps "S1Eide("; dd_symbol a0; dd_ps ")")
  | S1Esqid (a0, a1) => (dd_ps "S1Esqid("; dd_s0taq a0; dd_ps ","; dd_symbol a1; dd_ps ")")
  | S1Eint (a0) => (dd_ps "S1Eint("; dd_int a0; dd_ps ")")
  | S1Eintrep (a0) => (dd_ps "S1Eintrep("; dd_string a0; dd_ps ")")
  | S1Echar (a0) => (dd_ps "S1Echar("; dd_char a0; dd_ps ")")
  | S1Efloat (a0) => (dd_ps "S1Efloat("; dd_string a0; dd_ps ")")
  | S1Estring (a0) => (dd_ps "S1Estring("; dd_string a0; dd_ps ")")
  | S1Eextype (a0, a1) => (dd_ps "S1Eextype("; dd_string a0; dd_ps ","; dd_s1explstlst a1; dd_ps ")")
  | S1Eextkind (a0, a1) => (dd_ps "S1Eextkind("; dd_string a0; dd_ps ","; dd_s1explstlst a1; dd_ps ")")
  | S1Eapp (a0, a1, a2) => (dd_ps "S1Eapp("; dd_s1exp a0; dd_ps ","; dd_loc_t a1; dd_ps ","; dd_s1explst a2; dd_ps ")")
  | S1Elam (a0, a1, a2) => (dd_ps "S1Elam("; dd_s1marg a0; dd_ps ","; dd_s1rtopt a1; dd_ps ","; dd_s1exp a2; dd_ps ")")
  | S1Eimp (a0, a1, a2, a3) => (dd_ps "S1Eimp("; dd_funclo a0; dd_ps ","; dd_int a1; dd_ps ","; dd_int a2; dd_ps ","; dd_effcstopt a3; dd_ps ")")
  | S1Etop (a0, a1) => (dd_ps "S1Etop("; dd_int a0; dd_ps ","; dd_s1exp a1; dd_ps ")")
  | S1Elist (a0, a1) => (dd_ps "S1Elist("; dd_int a0; dd_ps ","; dd_s1explst a1; dd_ps ")")
  | S1Einvar (a0, a1) => (dd_ps "S1Einvar("; dd_int a0; dd_ps ","; dd_s1exp a1; dd_ps ")")
  | S1Etrans (a0, a1) => (dd_ps "S1Etrans("; dd_s1exp a0; dd_ps ","; dd_s1exp a1; dd_ps ")")
  | S1Etyarr (a0, a1) => (dd_ps "S1Etyarr("; dd_s1exp a0; dd_ps ","; dd_s1explst a1; dd_ps ")")
  | S1Etytup (a0, a1, a2) => (dd_ps "S1Etytup("; dd_int a0; dd_ps ","; dd_int a1; dd_ps ","; dd_s1explst a2; dd_ps ")")
  | S1Etyrec (a0, a1, a2) => (dd_ps "S1Etyrec("; dd_int a0; dd_ps ","; dd_int a1; dd_ps ","; dd_labs1explst a2; dd_ps ")")
  | S1Etyrec_ext (a0, a1, a2) => (dd_ps "S1Etyrec_ext("; dd_string a0; dd_ps ","; dd_int a1; dd_ps ","; dd_labs1explst a2; dd_ps ")")
  | S1Euni (a0, a1) => (dd_ps "S1Euni("; dd_s1qualst a0; dd_ps ","; dd_s1exp a1; dd_ps ")")
  | S1Eexi (a0, a1, a2) => (dd_ps "S1Eexi("; dd_int a0; dd_ps ","; dd_s1qualst a1; dd_ps ","; dd_s1exp a2; dd_ps ")")
