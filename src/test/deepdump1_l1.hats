and dd_s1var (x: s1var): void = (dd_ps "s1var{"; dd_ps "s1var_loc="; dd_location x.s1var_loc; dd_ps ",s1var_sym="; dd_symbol x.s1var_sym; dd_ps ",s1var_srt="; dd_s1rt x.s1var_srt; dd_ps "}")

and dd_a1srt (x: a1srt): void = (dd_ps "a1srt{"; dd_ps "a1srt_loc="; dd_location x.a1srt_loc; dd_ps ",a1srt_sym="; dd_symbolopt x.a1srt_sym; dd_ps ",a1srt_srt="; dd_s1rt x.a1srt_srt; dd_ps "}")

