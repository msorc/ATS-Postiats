  | Some y => (dd_ps "some("; dd_s1exp y; dd_ps ")")
  | None () => dd_ps "-"

and dd_s1explstopt (x: s1explstopt): void = case+ x of
  | Some y => (dd_ps "some("; dd_s1explst y; dd_ps ")")
  | None () => dd_ps "-"

and dd_s1expargopt (x: s1expargopt): void = case+ x of
  | Some y => (dd_ps "some("; dd_s1exparg y; dd_ps ")")
  | None () => dd_ps "-"

and dd_p1atopt (x: p1atopt): void = case+ x of
  | Some y => (dd_ps "some("; dd_p1at y; dd_ps ")")
  | None () => dd_ps "-"

and dd_d1expopt (x: d1expopt): void = case+ x of
  | Some y => (dd_ps "some("; dd_d1exp y; dd_ps ")")
  | None () => dd_ps "-"
