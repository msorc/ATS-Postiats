and dd_sp1at_node (x: sp1at_node): void = case+ x of
  | SP1Tcstr (a0, a1, a2) => (dd_ps "SP1Tcstr("; dd_s0taq a0; dd_ps ","; dd_symbol a1; dd_ps ","; dd_s1arglst a2; dd_ps ")")

