#include "hs_leaf.hats"
#include "hs_hand1.hats"
#include "hs_compat1.hats"
#include "hs_common.hats"
#include "hs_cases.hats"

implement $FIL.pkgsrcname_relocatize (given, ngurl) = given

implement filenv_get_name (x) = $FIL.filename_dummy
staload "pats_trans2_env.sats"
staload "pats_trans3_env.sats"
extern prfun hs_pf_free (pf: trans3_env_push_v): void
#include "hs_env1.hats"
extern fun hs_funlab_name (fl: funlab): string = "hs_funlab_name"
implement fprint_funlab (out, fl) = fprint_string (out, hs_funlab_name (fl))
implement print_funlab (fl) = fprint_funlab (stdout_ref, fl)
implement prerr_funlab (fl) = fprint_funlab (stderr_ref, fl)

implement main () = hs_run ()
