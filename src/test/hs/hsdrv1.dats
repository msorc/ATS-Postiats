(* ATS1 driver of the test of pats_histaexp: the same program as hsdrv2.dats for the ATS1 build of src/ (hsdrv1.sh);
   the funlab is printed by this driver (pats_histaexp_funlab.dats needs pats_ccomp.sats, not compiled here). *)
#define ATS_DYNLOADFLAG 0
staload "libc/SATS/stdio.sats"
staload UN = "prelude/SATS/unsafe.sats"
staload SYM = "pats_symbol.sats"
staload FIL = "pats_filename.sats"
staload LOC = "pats_location.sats"
staload LAB = "pats_label.sats"
staload ERR = "pats_error.sats"
staload GLOB = "pats_global.sats"
staload INT = "pats_intinf.sats"
staload CNTR = "pats_counter.sats"
staload STMP = "pats_stamp.sats"
staload EFF = "pats_effect.sats"
staload UT = "pats_utils.sats"
staload "pats_basics.sats"
staload "pats_syntax.sats"
staload "pats_staexp1.sats"
staload "pats_staexp2.sats"
staload "pats_staexp2_util.sats"
staload "pats_staexp2_error.sats"
staload "pats_namespace.sats"
staload S2C = "pats_stacst2.sats"
staload "pats_stacst2.sats"
staload "pats_histaexp.sats"

dynload "pats_error.dats"
dynload "pats_intinf.dats"
