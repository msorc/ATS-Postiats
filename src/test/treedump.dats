(* ATS2 driver of the test of the level-1 trees and their printers (see PORTING.md, section Level 1) *)
(* ****** ****** *)
//
// Prints (with the complete dumpers of deepdump(.hats), deepdump_l1.hats and the fprint_X of the printers)
// the trees of treecases.hats (generated by tree1_gen.py from the specs: every constructor of the level-1
// syntax, and calls of the smart constructors/conversions of pats_staexp1 and pats_dynexp1) and some
// hand-written cases. treedump1.dats is the same driver for the ATS1 build of src/.
//
(* ****** ****** *)
#include "share/atspre_staload.hats"
staload UN = "prelude/SATS/unsafe.sats"
staload "libats/SATS/arena.sats"
#include "../mylibies.hats"
staload SYM = "../pats_symbol.sats"
staload FIL = "../pats_filename.sats"
staload LOC = "../pats_location.sats"
staload LAB = "../pats_label.sats"
staload ERR = "../pats_error.sats"
staload "../pats_basics.sats"
staload "../pats_lexing.sats"
staload "../pats_tokbuf.sats"
staload "../pats_syntax.sats"
staload "../pats_parsing.sats"
staload "../pats_effect.sats"
staload "../pats_fixity.sats"
staload "../pats_staexp1.sats"
staload "../pats_dynexp1.sats"
staload UT = "../pats_utils.sats"
staload EFF = "../pats_effect.sats"
staload _ = "../pats_syntax.dats"
staload _ = "../pats_parsing_util.dats"
staload _ = "../pats_parsing.dats"
staload _ = "../pats_error.dats"

dynload "../pats_error.dats"
dynload "../pats_basics.dats"
dynload "../pats_utils.dats"
dynload "../pats_symbol.dats"
dynload "../pats_label.dats"
dynload "../pats_filename.dats"
dynload "../pats_location.dats"
dynload "../pats_effect.dats"
dynload "../pats_reader.dats"
dynload "../pats_lexbuf.dats"
dynload "../pats_lexing_token.dats"
dynload "../pats_lexing.dats"
dynload "../pats_lexing_error.dats"
dynload "../pats_lexing_print.dats"
dynload "../pats_tokbuf.dats"
dynload "../pats_syntax.dats"
dynload "../pats_syntax_print.dats"
dynload "../pats_staexp1.dats"
dynload "../pats_staexp1_print.dats"
dynload "../pats_dynexp1.dats"
dynload "../pats_dynexp1_print.dats"
dynload "../pats_parsing.dats"
dynload "../pats_parsing_util.dats"
dynload "../pats_parsing_error.dats"
dynload "../pats_parsing_kwds.dats"
dynload "../pats_parsing_base.dats"
dynload "../pats_parsing_e0xp.dats"
dynload "../pats_parsing_sort.dats"
dynload "../pats_parsing_staexp.dats"
dynload "../pats_parsing_p0at.dats"
dynload "../pats_parsing_dynexp.dats"
dynload "../pats_parsing_decl.dats"
dynload "../pats_parsing_toplevel.dats"
implement $FIL.pkgsrcname_relocatize (given, ngurl) = given


%{^
#include "pardump.cats"
%}

macdef out = stdout_ref
extern fun dd_flush (): void = "mac#fflush_stdout"
%{^
#include <stdio.h>
#define fflush_stdout() fflush(stdout)
%}

(* ****** ****** *)
//
// the leaf samples (the same in treedump1.dats)
//
fun mkloc (k: int): location = let
  var p1: $LOC.position
  var p2: $LOC.position
  val () = $LOC.position_init (p1, $UN.cast{lint} (k), k+1, k)
  val () = $LOC.position_init (p2, $UN.cast{lint} (k+3), k+1, k+3)
  val fil = $FIL.filename_make ("given", "part", "full")
in
  $LOC.location_make_fil_pos_pos (fil, p1, p2)
end
fun mksym (k: int): symbol = $SYM.symbol_make_string (
  case+ k mod 5 of 0 => "a" | 1 => "bb" | 2 => "+" | 3 => "x_y" | _ => "z"
)
fun mklab (k: int): label = if k mod 2 = 0 then $LAB.label_make_int (k) else $LAB.label_make_string ("lab")
fun mkfil (k: int): filename = $FIL.filename_make ("g", "p", "f")
fun mktok_int (k: int): token = token_make (mkloc (k), token_node_T_INT (10, "12", 0u))
fun mktok_chr (k: int): token = token_make (mkloc (k), token_node_T_CHAR ('c'))
fun mktok_flt (k: int): token = token_make (mkloc (k), token_node_T_FLOAT (10, "1.5", 0u))
fun mktok_str (k: int): token = token_make (mkloc (k), token_node_T_STRING ("str"))
fun mkchr (k: int): char = if k mod 2 = 0 then 'a' else 'Z'
fun mkd2ctype (): S1Ed2ctype = $UN.cast{S1Ed2ctype} (the_null_ptr)
fun mkstropt (k: int): Stropt = if k mod 2 = 0 then stropt_none () else stropt_some ("opt")
fun mkeffect (k: int): effect = (case+ k mod 4 of 0 => effect_ntm | 1 => effect_exn | 2 => effect_ref | _ => effect_wrt)
fun mkeffset (k: int): effset = (
  case+ k mod 5 of
  | 0 => effset_nil | 1 => effset_all | 2 => effset_ntm | 3 => effset_union (effset_exn, effset_wrt) | _ => effset_add (effset_nil, effect_ref)
)

#include "deepdump.hats"
#include "deepdump_l1.hats"

fn ps (s: string): void = fprint_string (out, s)
fn nl (): void = fprint_newline (out)

(* ****** ****** *)

#include "treecases.hats"

(* ****** ****** *)
//
// the constants and the other small cases
//
fn hand_cases (): void = {
  val () = (ps "hand: v1al_true"; nl (); fprint_v1al (out, v1al_true); nl (); fprint_v1al (out, v1al_false); nl ())
  val () = (ps "hand: effcst"; nl ())
  val () = (fprint_effcst (out, effcst_nil); nl (); fprint_effcst (out, effcst_all); nl ())
  val () = (fprint_effcst (out, effcst_ntm); nl (); fprint_effcst (out, effcst_exn); nl ())
  val () = (fprint_effcst (out, effcst_ref); nl (); fprint_effcst (out, effcst_wrt); nl ())
  val () = (ps "hand: effcst_contain"; nl ())
  val () = (
    fprint_bool (out, effcst_contain (effcst_all, effect_ntm)); fprint_bool (out, effcst_contain (effcst_nil, effect_ntm));
    fprint_bool (out, effcst_contain (effcst_ntm, effect_ntm)); fprint_bool (out, effcst_contain (effcst_ntm, effect_exn));
    fprint_bool (out, effcst_contain_ntm (effcst_ntm)); fprint_bool (out, effcst_contain_ntm (effcst_wrt)); nl ()
  )
  val () = (ps "hand: effect/effset"; nl ())
  val () = (fprint_effset (out, effset_nil); nl (); fprint_effset (out, effset_all); nl (); fprint_effset (out, effset_ntm); nl ())
  val () = (fprint_effset (out, effset_union (effset_exn, effset_wrt)); nl (); fprint_effset (out, effset_cmpl (effset_ref)); nl ())
  val () = (fprint_effset (out, effset_diff (effset_all, effset_ref)); nl (); fprint_effset (out, effset_inter (effset_all, effset_ref)); nl ())
  val () = (
    fprint_bool (out, effset_isnil (effset_nil)); fprint_bool (out, effset_isall (effset_all)); fprint_bool (out, effset_isfin (effset_ntm));
    fprint_bool (out, effset_iscof (effset_cmpl (effset_ntm))); fprint_bool (out, effset_ismem (effset_ntm, effect_ntm));
    fprint_bool (out, effset_ismem (effset_ntm, effect_exn)); fprint_bool (out, effset_supset (effset_all, effset_ref));
    fprint_bool (out, effset_subset (effset_ref, effset_all)); fprint_bool (out, effset_is_inter (effset_ref, effset_ntm)); nl ()
  )
  val () = (fprint_effect (out, effect_ntm); fprint_effect (out, effect_exn); fprint_effect (out, effect_ref); fprint_effect (out, effect_wrt); nl ())
  val () = (fprint_bool (out, eq_effect_effect (effect_ntm, effect_ntm)); fprint_bool (out, eq_effect_effect (effect_ntm, effect_exn)); nl ())
  val () = (fprint_bool (out, eq_effset_effset (effset_nil, effset_nil)); fprint_bool (out, eq_effset_effset (effset_nil, effset_all)); nl ())
  val () = (ps "hand: i1nvresstate_nil"; nl (); dd_i1nvresstate (i1nvresstate_nil); nl ())
}

implement main0 () = {
  val () = hand_cases ()
  val () = tcase_all ()
}
