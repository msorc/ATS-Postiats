dynload "../pats_lexing_print.dats"
dynload "../pats_tokbuf.dats"
dynload "../pats_syntax.dats"
dynload "../pats_syntax_print.dats"
dynload "../pats_parsing.dats"
dynload "../pats_parsing_util.dats"
dynload "../pats_parsing_error.dats"
dynload "../pats_parsing_kwds.dats"
dynload "../pats_parsing_base.dats"
dynload "../pats_parsing_e0xp.dats"
dynload "../pats_parsing_sort.dats"
dynload "../pats_parsing_staexp.dats"
dynload "../pats_parsing_p0at.dats"
dynload "../pats_parsing_dynexp.dats"
dynload "../pats_parsing_decl.dats"
dynload "../pats_parsing_toplevel.dats"
implement $FIL.pkgsrcname_relocatize (given, ngurl) = given

%{^
#include "pardump.cats"
%}
extern fun pardump_load (path: string): void = "mac#pardump_load"
extern fun pardump_nextline (): ptr = "mac#pardump_nextline"
extern fun pardump_split (line: ptr): string = "mac#pardump_split"

macdef out = stdout_ref
fn ps (s: string): void = fprint_string (out, s)
fn nl (): void = fprint_newline (out)
fn ploc (loc: location): void = $LOC.fprint_location (out, loc)

fun{a:t@ype} pr_sep (xs: glist(a), f: a -> void): void =
  case+ glist_view(xs) of
  | ~GLcons (x, xs) => (f x; if glist_is_cons(xs) then (ps ","; pr_sep<a> (xs, f)) else ())
  | ~GLnil () => ()

fun{a:t@ype} pr_opt (opt: gopt(a), f: a -> void): void =
  case+ gopt_view(opt) of ~GOsome x => f x | ~GOnone () => ps "-"

fn pr_s0rt (x: s0rt): void = fprint_s0rt (out, x)
fn pr_s0exp (x: s0exp): void = fprint_s0exp (out, x)
fn pr_i0de (x: i0de): void = fprint_i0de (out, x)
fn pr_sym (x: symbol): void = $SYM.fprint_symbol (out, x)
fn pr_s0tring (x: s0tring): void = fprint_s0tring (out, x)
fn pr_e0xp (x: e0xp): void = fprint_e0xp (out, x)

fn pr_s0arg0 (x: s0arg): void = (
  ps "s0arg("; ploc (x.s0arg_loc()); ps " "; pr_sym (x.s0arg_sym()); ps ":"; pr_opt<s0rt> (x.s0arg_srt(), pr_s0rt); ps ")"
)
fn pr_s0arg (x: s0arg): void = (pr_s0arg0 x; nl ())
fn pr_s0marg (x: s0marg): void = (
  ps "s0marg("; ploc (x.s0marg_loc()); ps " ["; pr_sep<s0arg> (x.s0marg_arg(), pr_s0arg0); ps "])"; nl ()
)
fn pr_a0srt0 (x: a0srt): void = (
  ps "a0srt("; ploc (x.a0srt_loc()); ps " "; pr_opt<symbol> (x.a0srt_sym(), pr_sym); ps ":"; pr_s0rt (x.a0srt_srt()); ps ")"
)
fn pr_a0srt (x: a0srt): void = (pr_a0srt0 x; nl ())
fn pr_a0msrt (x: a0msrt): void = (
  ps "a0msrt("; ploc (x.a0msrt_loc()); ps " ["; pr_sep<a0srt> (x.a0msrt_arg(), pr_a0srt0); ps "])"; nl ()
)
fn pr_d0atsrtcon0 (x: d0atsrtcon): void = (
  ps "con("; ploc (x.d0atsrtcon_loc()); ps " "; pr_sym (x.d0atsrtcon_sym()); ps " of "; pr_opt<s0rt> (x.d0atsrtcon_arg(), pr_s0rt); ps ")"
)
fn pr_d0atsrtconlst (xs: d0atsrtconlst): void = (
  ps "["; pr_sep<d0atsrtcon> (xs, pr_d0atsrtcon0); ps "]"; nl ()
)
fn pr_witht0ype (x: witht0ype): void = (
  (case+ witht0ype_view (x) of
  | ~WITHT0YPEsome (knd, s0e) => (ps "witht0ype("; fprint_int (out, knd); ps ","; pr_s0exp s0e; ps ")")
  | ~WITHT0YPEnone () => ps "witht0ype()"); nl ()
)
fn pr_s0vararg (x: s0vararg): void = (
  (case+ s0vararg_view (x) of
  | ~S0VARARGone (tok) => (ps "one "; ploc (tok.token_loc()))
  | ~S0VARARGall (tok) => (ps "all "; ploc (tok.token_loc()))
  | ~S0VARARGseq (loc, xs) => (ps "seq("; ploc loc; ps " ["; pr_sep<s0arg> (xs, pr_s0arg0); ps "])")); nl ()
)
fn pr_e0fftag0 (x: e0fftag): void = (
  ploc (x.e0fftag_loc()); ps " ";
  case+ e0fftag_node_view (x.e0fftag_node()) of
  | ~E0FFTAGint (i) => (ps "int "; fprint_int (out, i))
  | ~E0FFTAGcst (i, s) => (ps "cst "; fprint_int (out, i); ps " "; ps s)
  | ~E0FFTAGvar (id) => (ps "var "; pr_i0de id)
  | ~E0FFTAGprf () => ps "prf"
  | ~E0FFTAGlin (i) => (ps "lin "; fprint_int (out, i))
  | ~E0FFTAGfun (i, j) => (ps "fun "; fprint_int (out, i); ps " "; fprint_int (out, j))
  | ~E0FFTAGclo (i, j, k) => (ps "clo "; fprint_int (out, i); ps " "; fprint_int (out, j); ps " "; fprint_int (out, k))
)
fn pr_e0fftaglst (xs: e0fftaglst): void = (ps "["; pr_sep<e0fftag> (xs, pr_e0fftag0); ps "]"; nl ())
fn pr_colonwith (x: e0fftaglstopt): void = (
  case+ gopt_view (x) of
  | ~GOsome xs => (ps "some "; pr_e0fftaglst xs)
  | ~GOnone () => (ps "none"; nl ())
)
fn pr_extnamopt (x: s0tringopt): void = (pr_opt<s0tring> (x, pr_s0tring); nl ())
fn pr_s0rtopt (x: s0rtopt): void = (pr_opt<s0rt> (x, pr_s0rt); nl ())
fn pr_datsdef (x: datsdef): void = (
  ps "datsdef("; pr_sym (x.datsdef_sym()); ps "="; pr_opt<e0xp> (x.datsdef_opt(), pr_e0xp); ps ")"; nl ()
)
fn pr_t0mpmarg (x: t0mpmarg): void = (
  ps "t0mpmarg("; ploc (x.t0mpmarg_loc()); ps " ["; pr_sep<s0exp> (x.t0mpmarg_arg(), pr_s0exp); ps "])"; nl ()
)

#include "deepdump.hats"
fun pr_decls (ds: d0eclist): void = case+ glist_view (ds) of
  | ~GLcons (d, ds1) => (dd_d0ecl (d); nl (); pr_decls ds1)
  | ~GLnil () => ()

extern fun pardump_readfile (path: string): string = "mac#pardump_readfile"
fn run_top (stadyn: int, inp: string): void = let
  var buf: tokbuf
  val () = tokbuf_initize_string (buf, inp)
  var nerr: int
  val ds = (if stadyn = 0 then p_toplevel_sta (buf, nerr) else p_toplevel_dyn (buf, nerr)) : d0eclist
  val () = tokbuf_uninitize (buf)
  val () = pr_decls ds
  val () = (ps "nerr="; fprint_int (out, nerr); nl ())
in end

fn run_time (stadyn: int, inp: string): void = let
  var buf: tokbuf
  val () = tokbuf_initize_string (buf, inp)
  var nerr: int
  val ds = (if stadyn = 0 then p_toplevel_sta (buf, nerr) else p_toplevel_dyn (buf, nerr)) : d0eclist
  val () = tokbuf_uninitize (buf)
  val () = (ps "nerr="; fprint_int (out, nerr); nl ())
in end

extern fun pardump_word (s: string, i: int): ptr = "mac#pardump_word"
fn pgn_pr (fil: filename, ds: d0eclist): void = (
  ps "fil="; $FIL.fprint_filename_full (out, fil); nl (); pr_decls ds
)
fn run_pgn (stadyn: int, path: string): void = let
  var fil: filename
  val ds = parse_from_givename_toplevel2 (stadyn, path, fil)
in pgn_pr (fil, ds) end
fn run_pfr (stadyn: int, path: string): void = let
  val inp = fileref_open_exn (path, file_mode_r)
  val ds = parse_from_fileref_toplevel (stadyn, inp)
  val () = fileref_close (inp)
in pr_decls ds end
fun words (s: string, i: int): glist (string) = let
  val p = pardump_word (s, i)
in
  if ptr_isnot_null p then glist_cons ($UN.cast{string} p, words (s, i+1)) else glist_nil ()
end
fn run_pgnl (stadyn: int, s: string): void = let
  var fil: filename
  val ds = parse_from_givenames_toplocal2 (stadyn, words (s, 0), fil)
in pgn_pr (fil, ds) end

fun dispatch (kind: string, inp: string): void =
  if kind = "PGNsta" then run_pgn (0, inp) else
  if kind = "PGNdyn" then run_pgn (1, inp) else
  if kind = "PFRsta" then run_pfr (0, inp) else
  if kind = "PFRdyn" then run_pfr (1, inp) else
  if kind = "PGNLsta" then run_pgnl (0, inp) else
  if kind = "PGNLdyn" then run_pgnl (1, inp) else
  if kind = "TIMEsta" then run_time (0, pardump_readfile inp) else
  if kind = "TIMEdyn" then run_time (1, pardump_readfile inp) else
  if kind = "TOPsta" then run_top (0, inp) else
  if kind = "TOPdyn" then run_top (1, inp) else
  if kind = "FILEsta" then run_top (0, pardump_readfile inp) else
  if kind = "FILEdyn" then run_top (1, pardump_readfile inp) else
  (if kind = "s0rt" then (
    case+ parse_from_string_parser (inp, p_s0rt) of
    | ~Some_vt x => (fprint_s0rt (out, x); nl ())
    | ~None_vt () => (ps "FAIL"; nl ())
  ) else
  (if kind = "s0exp" then (
    case+ parse_from_string_parser (inp, p_s0exp) of
    | ~Some_vt x => (fprint_s0exp (out, x); nl ())
    | ~None_vt () => (ps "FAIL"; nl ())
  ) else
  (if kind = "atms0exp" then (
    case+ parse_from_string_parser (inp, p_atms0exp) of
    | ~Some_vt x => (fprint_s0exp (out, x); nl ())
    | ~None_vt () => (ps "FAIL"; nl ())
  ) else
  (if kind = "e0xp" then (
    case+ parse_from_string_parser (inp, p_e0xp) of
    | ~Some_vt x => (fprint_e0xp (out, x); nl ())
    | ~None_vt () => (ps "FAIL"; nl ())
