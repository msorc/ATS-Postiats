//
// the dynamic expressions: a small [d2exp_trup] (the real one dispatches in the same way to the functions of group 4)
//
2|fun g4_trup_lst (d2es: d2explst): d3explst = (
2|  case+ glist_view (d2es) of
2|  | ~GLnil () => glist_nil ()
2|  | ~GLcons (d2e, d2es1) => let
2|      val d3e = d2exp_trup (d2e) in glist_cons (d3e, g4_trup_lst (d2es1))
2|    end
2|)
1|fun g4_trup_lst (d2es: d2explst): d3explst = (
1|  case+ d2es of
1|  | list_nil () => list_nil ()
1|  | list_cons (d2e, d2es1) => let
1|      val d3e = d2exp_trup (d2e) in list_cons (d3e, g4_trup_lst (d2es1))
1|    end
1|)
2|fun g4_trup_seq (loc0: location, d2es: d2explst): d3exp = (
2|  case+ glist_view (d2es) of
2|  | ~GLnil () => d3exp_empty (loc0, s2exp_void_t0ype ())
2|  | ~GLcons (d2e, d2es1) => let
2|      val d3e = d2exp_trup (d2e)
2|    in
2|      if glist_is_nil (d2es1) then d3e else g4_trup_seq (loc0, d2es1)
2|    end
2|)
1|fun g4_trup_seq (loc0: location, d2es: d2explst): d3exp = (
1|  case+ d2es of
1|  | list_nil () => d3exp_empty (loc0, s2exp_void_t0ype ())
1|  | list_cons (d2e, d2es1) => let
1|      val d3e = d2exp_trup (d2e)
1|    in
1|      case+ d2es1 of list_nil () => d3e | list_cons _ => g4_trup_seq (loc0, d2es1)
1|    end
1|)
2|implement d2exp_trup (d2e0) = let
2|  val loc0 = g4_d2loc (d2e0)
2|  val () = (dd_ps "[d2exp_trup "; dd_d2exp d2e0; dd_ps "]"; dd_nl ())
2|in
2|  case+ d2exp_node_view (d2e0.d2exp_node ()) of
2|  | ~D2Evar (d2v) => d3exp_var (loc0, d2var_get_type_some (loc0, d2v), d2v)
2|  | ~D2Etop2 (s2e) => d3exp_top (loc0, s2e)
2|  | ~D2Eint (i) => d3exp_int (loc0, s2exp_int_int_t0ype (i), i)
2|  | ~D2Eempty () => d3exp_empty (loc0, s2exp_void_t0ype ())
2|  | ~D2Eseq (d2es) => g4_trup_seq (loc0, d2es)
2|  | ~D2Eptrof _ => d2exp_trup_ptrof (d2e0)
2|  | ~D2Eviewat _ => d2exp_trup_viewat (d2e0)
2|  | ~D2Ederef (d2s, d2e) => d2exp_trup_deref (loc0, d2s, d2e, glist_nil ())
2|  | ~D2Eassgn _ => d2exp_trup_assgn (d2e0)
2|  | ~D2Exchng _ => d2exp_trup_xchng (d2e0)
2|  | ~D2Eloopexn (knd) => d2exp_trup_loopexn (loc0, knd)
2|  | v => (d2exp_node_view_free (v); d3exp_errexp (loc0))
2|end
1|implement d2exp_trup (d2e0) = let
1|  val loc0 = g4_d2loc (d2e0)
1|  val () = (dd_ps "[d2exp_trup "; dd_d2exp d2e0; dd_ps "]"; dd_nl ())
1|in
1|  case+ d2e0.d2exp_node of
1|  | D2Evar (d2v) => d3exp_var (loc0, d2var_get_type_some (loc0, d2v), d2v)
1|  | D2Etop2 (s2e) => d3exp_top (loc0, s2e)
1|  | D2Eint (i) => d3exp_int (loc0, s2exp_int_int_t0ype (i), i)
1|  | D2Eempty () => d3exp_empty (loc0, s2exp_void_t0ype ())
1|  | D2Eseq (d2es) => g4_trup_seq (loc0, d2es)
1|  | D2Eptrof _ => d2exp_trup_ptrof (d2e0)
1|  | D2Eviewat _ => d2exp_trup_viewat (d2e0)
1|  | D2Ederef (d2s, d2e) => d2exp_trup_deref (loc0, d2s, d2e, list_nil ())
1|  | D2Eassgn _ => d2exp_trup_assgn (d2e0)
1|  | D2Exchng _ => d2exp_trup_xchng (d2e0)
1|  | D2Eloopexn (knd) => d2exp_trup_loopexn (loc0, knd)
1|  | _ => d3exp_errexp (loc0)
1|end
