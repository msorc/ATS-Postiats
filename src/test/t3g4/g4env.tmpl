end // end of [s2addr_exch_type]
//
implement d2exp_trup_applst_sym (d2e0, d2s, d2as) = let
  val loc0 = g4_d2loc (d2e0)
  val () = (dd_ps "[applst_sym "; dd_d2exp d2e0; dd_ps " "; dd_d2exparglst d2as; dd_ps "]"; dd_nl ())
in
  if g4_getk (5) = 0 then d3exp_errexp (loc0)
  else d3exp_app_dyn (loc0, g4_s2e (3, s2exp_void_t0ype ()), d3exp_top (loc0, s2exp_void_t0ype ()), ~1, LC_d3explst (d3exp_top (loc0, s2exp_void_t0ype ()), LN_d3explst ()))
end // end of [d2exp_trup_applst_sym]
