(* ****** ****** *)
//
// the selections ([pats_trans3_selab.dats], [pats_trans3_lvalres.dats]): the knobs decide
// 0: the value of [linrest], 1: the value of [sharing], 2: a context (0/1: none/some), 3: the list of the propositions (0/1: nil/one),
// 4: the selected type (0/1: the type itself / the handle 0), 5: the result of [d2exp_trup_applst_sym] (0/1: an error/an application)
// the handles: 0: the selected type, 1: a proposition, 2: the old type of [s2addr_exch_type], 3: the type of an application
//
implement s2exp_get_dlablst_linrest_sharing (loc0, s2e, d3ls, linrest, sharing) = let
  val () = (dd_ps "[linrest_sharing "; dd_location loc0; dd_ps " "; dd_s2exp s2e; dd_ps " "; dd_d3lablst d3ls; dd_ps "]"; dd_nl ())
  val () = linrest := g4_getk (0)
  val () = sharing := g4_getk (1)
  val sel = (if g4_getk (4) = 0 then s2e else g4_s2e (0, s2e)) : s2exp
  val ps = (
    if g4_getk (3) = 0 then list_vt_nil () else list_vt_cons (g4_s2e (1, s2e), list_vt_nil ())
  ) : s2explst_vt
in
  <<(sel, ps)
end // end of [s2exp_get_dlablst_linrest_sharing]
