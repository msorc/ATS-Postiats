implement s2addr_exch_type (loc0, s2l, d3ls, s2e_new) = let
  val () = (dd_ps "[exch_type "; dd_location loc0; dd_ps " "; dd_s2exp s2l; dd_ps " "; dd_d3lablst d3ls; dd_ps " "; dd_s2exp s2e_new; dd_ps "]"; dd_nl ())
in
