2|implement d2lablst_trup (d2ls) = (
2|  case+ glist_view (d2ls) of
2|  | ~GLnil () => glist_nil ()
2|  | ~GLcons (d2l, d2ls1) => let
2|      val loc = d2l.d2lab_loc ()
2|      val x = (
2|        case+ d2lab_node_view (d2l.d2lab_node ()) of
2|        | ~D2LABlab (l) => d3lab_lab (loc, l, d2l.d2lab_overld ())
2|        | ~D2LABind (ind) => d3lab_ind (loc, g4_trup_lst (ind))
2|      ) : d3lab
2|    in
2|      glist_cons (x, d2lablst_trup (d2ls1))
2|    end
2|)
1|implement d2lablst_trup (d2ls) = (
1|  case+ d2ls of
1|  | list_nil () => list_nil ()
1|  | list_cons (d2l, d2ls1) => let
1|      val loc = d2l.d2lab_loc
1|      val x = (
1|        case+ d2l.d2lab_node of
1|        | D2LABlab (l) => d3lab_lab (loc, l, d2l.d2lab_overld)
1|        | D2LABind (ind) => d3lab_ind (loc, g4_trup_lst (ind))
1|      ) : d3lab
1|    in
1|      list_cons (x, d2lablst_trup (d2ls1))
1|    end
1|)
