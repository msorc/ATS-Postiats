fun g4_mkctxt (s2e: s2exp): s2ctxt = let
  val h = s2hole_make_srt (s2rt_t0ype)
in
  s2ctxt_make (K_s2exp (s2rt_t0ype, K_S2Ehole (h)), h)
end // end of [g4_mkctxt]
implement s2exp_get_dlablst_context (loc0, s2e, d3ls, context) = let
  val () = (dd_ps "[context "; dd_location loc0; dd_ps " "; dd_s2exp s2e; dd_ps " "; dd_d3lablst d3ls; dd_ps "]"; dd_nl ())
  val () = (
    if g4_getk (2) = 0 then context := ON_s2ctxtopt ()
    else context := OS_s2ctxtopt (g4_mkctxt (s2e))
  ) : void
in
  if g4_getk (4) = 0 then s2e else g4_s2e (0, s2e)
end // end of [s2exp_get_dlablst_context]
