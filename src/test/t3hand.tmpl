fun t_inst_dump (e1: s2exp, ps: s2explst_vt, err: int): void =
  (dd_s2exp e1; dd_ps " "; dd_listvt_s2exp ps; dd_ps " err="; dd_int err; dd_nl ())
fun t_inst (knd: int, e: s2exp, loc: location): void = let
  var err: int = 0
in
  if knd = 0 then let
    val <<(e1, ps) = s2exp_exi_instantiate_all (e, loc, err)
  in t_inst_dump (e1, ps, err) end
  else if knd = 1 then let
    val <<(e1, ps) = s2exp_uni_instantiate_all (e, loc, err)
  in t_inst_dump (e1, ps, err) end
  else if knd = 2 then let
    val <<(e1, ps) = s2exp_unimet_instantiate_all (e, loc, err)
  in t_inst_dump (e1, ps, err) end
  else let
    val <<(e1, ps) = s2exp_exiuni_instantiate_all (knd - 3, e, loc, err)
  in t_inst_dump (e1, ps, err) end
end
