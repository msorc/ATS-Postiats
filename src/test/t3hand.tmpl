// a record of the constraint kinds: labels 2j, j = 0..n-1 (the labels of a sorted list)
fun mk_lp2tcs_n (n: int): labp2atcstlst_vt = let
  fun loop (i: int, n: int): labp2atcstlst_vt =
    if i >= n then list_vt_nil () else list_vt_cons (mk_lab_p2tc (2 * i, i + 2), loop (i + 1, n))
in
  loop (0, n)
end
