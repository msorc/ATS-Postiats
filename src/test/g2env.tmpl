2|implement p2at_trdn (p2t, s2e) = let
2|  val () = (dd_ps "T3 p2at_trdn "; dd_p2at p2t; dd_ps " : "; dd_s2exp s2e; dd_nl ())
2|  val loc = g2_ploc p2t
2|in
2|  case+ p2at_node_view (p2t.p2at_node ()) of
2|  | ~P2Tvar (d2v) => p3at_var (loc, s2e, d2v)
2|  | ~P2Tany () => p3at_any (loc, s2e, d2var_make_any (loc))
2|  | ~P2Trefas (d2v, p2t1) => p3at_refas (loc, s2e, d2v, p3at_errpat (g2_ploc p2t1, s2e))
2|  | ~P2Tcon (_, _, _, _, _, _) => p2at_trdn_con (p2t, s2exp2hnf s2e)
2|  | v => (p2at_node_view_free (v); p3at_errpat (loc, s2e))
2|end
1|implement p2at_trdn (p2t, s2e) = let
1|  val () = (dd_ps "T3 p2at_trdn "; dd_p2at p2t; dd_ps " : "; dd_s2exp s2e; dd_nl ())
1|  val loc = g2_ploc p2t
1|in
1|  case+ p2t.p2at_node of
1|  | P2Tvar (d2v) => p3at_var (loc, s2e, d2v)
1|  | P2Tany () => p3at_any (loc, s2e, d2var_make_any (loc))
1|  | P2Trefas (d2v, p2t1) => p3at_refas (loc, s2e, d2v, p3at_errpat (g2_ploc p2t1, s2e))
1|  | P2Tcon (_, _, _, _, _, _) => p2at_trdn_con (p2t, s2exp2hnf s2e)
1|  | _ => p3at_errpat (loc, s2e)
1|end
//
// [p2atlst_trdn], [p2atlst_trdn_arg]: the list of the patterns is matched against the list of the types
// (serr: +1 for a pattern in excess, -1 for each type without a pattern); the result has the length of the types
//
2|fun g2_p3_loop (loc: location, p2ts: p2atlst, s2es: s2explst, serr: &int): List0_vt (p3at) = (
2|  case+ glist_view (s2es) of
2|  | ~GLnil () => (
2|    case+ glist_view (p2ts) of
2|    | ~GLnil () => list_vt_nil ()
2|    | ~GLcons (_, _) => (serr := serr + 1; list_vt_nil ())
2|    )
2|  | ~GLcons (s2e, s2es1) => (
2|    case+ glist_view (p2ts) of
2|    | ~GLnil () => let
2|        val () = serr := serr - 1
2|        val p3t = p3at_errpat (loc, s2e)
2|        val rest = g2_p3_loop (loc, glist_nil (), s2es1, serr)
2|      in list_vt_cons (p3t, rest) end
2|    | ~GLcons (p2t, p2ts1) => let
2|        val p3t = p2at_trdn (p2t, s2e)
2|        val rest = g2_p3_loop (loc, p2ts1, s2es1, serr)
2|      in list_vt_cons (p3t, rest) end
2|    )
2|)
1|fun g2_p3_loop (loc: location, p2ts: p2atlst, s2es: s2explst, serr: &int): List (p3at) = (
1|  case+ s2es of
1|  | list_nil () => (
1|    case+ p2ts of
1|    | list_nil () => list_nil ()
1|    | list_cons (_, _) => (serr := serr + 1; list_nil ())
1|    )
1|  | list_cons (s2e, s2es1) => (
1|    case+ p2ts of
1|    | list_nil () => let
1|        val () = serr := serr - 1
1|        val p3t = p3at_errpat (loc, s2e)
1|        val rest = g2_p3_loop (loc, list_nil (), s2es1, serr)
1|      in list_cons (p3t, rest) end
1|    | list_cons (p2t, p2ts1) => let
1|        val p3t = p2at_trdn (p2t, s2e)
1|        val rest = g2_p3_loop (loc, p2ts1, s2es1, serr)
1|      in list_cons (p3t, rest) end
1|    )
1|)
2|implement p2atlst_trdn (loc, p2ts, s2es, serr) = let
2|  val () = (dd_ps "T3 p2atlst_trdn "; dd_location loc; dd_ps " "; dd_p2atlst p2ts; dd_ps " : "; dd_s2explst s2es; dd_nl ())
2|in
2|  glist_make_list_vt (g2_p3_loop (loc, p2ts, s2es, serr))
2|end
