(* the test doubles of the driver of the level-3 translation test, group 2 (g2_gen.py): the functions of the other groups of the trans3 port that the
   modules pats_trans3_{dynexp_dn,appsym,caseof,patcon} call (src/pats_trans3.sats), generated from this template (see t3hand.tmpl: "2|" lines are ATS2 only,
   "1|" lines ATS1 only, "<<(" is "@(" in ATS2 and "(" in ATS1). Each one prints a line "T3 name args" (the order of the calls and their arguments are
   observable) and returns a result that depends only on its arguments, identically in the two languages. See PORTING.md, "Level 3 translation, group 2". *)
(* ****** ****** *)
2|fun g2_dloc (e: d2exp): location = e.d2exp_loc ()
1|fun g2_dloc (e: d2exp): location = e.d2exp_loc
2|fun g2_eloc (e: d3exp): location = e.d3exp_loc ()
1|fun g2_eloc (e: d3exp): location = e.d3exp_loc
2|fun g2_ploc (p: p2at): location = p.p2at_loc ()
1|fun g2_ploc (p: p2at): location = p.p2at_loc
//
// the type of a typed leaf: D2Eann_type (e, s2e) has the type s2e, every other expression has the type void
//
2|fun g2_ty_of (d2e: d2exp): s2exp = (
2|  case+ d2exp_node_view (d2e.d2exp_node ()) of
2|  | ~D2Eann_type (_, s2e) => s2e
2|  | v => (d2exp_node_view_free (v); s2exp_void_t0ype ())
2|)
1|fun g2_ty_of (d2e: d2exp): s2exp = (
1|  case+ d2e.d2exp_node of
1|  | D2Eann_type (_, s2e) => s2e
1|  | _ => s2exp_void_t0ype ()
1|)
//
2|fun g2_vty (d2v: d2var): s2exp = (
2|  case+ gopt_view (d2var_get_type (d2v)) of ~GOsome (s2e) => s2e | ~GOnone () => s2exp_void_t0ype ()
2|)
1|fun g2_vty (d2v: d2var): s2exp = (
1|  case+ d2var_get_type (d2v) of Some (s2e) => s2e | None () => s2exp_void_t0ype ()
1|)
//
// a linear variable that is used is consumed if it is local to the enclosing linear function (as d2exp_trup_var_nonmut does), else it is an error
//
2|fun g2_consume (loc0: location, d2v: d2var): void =
2|  if d2var_get_linval (d2v) >= 0 then (
2|    if the_d2varenv_d2var_is_llamlocal (d2v)
2|      then (d2var_inc_linval (d2v); d2var_set_type (d2v, gopt_none ()))
2|      else let
2|        val () = ($LOC.prerr_location (loc0); prerr_string ": error(3)")
2|        val () = (prerr_string ": the linear dynamic variable ["; prerr_d2var (d2v); prerr_string "] is expected to be local but it is not."; prerr_newline ())
2|      in the_trans3errlst_add (trans3err_T3E_d2var_trup_llamlocal (d2v)) end
2|  ) else ()
1|fun g2_consume (loc0: location, d2v: d2var): void =
1|  if d2var_get_linval (d2v) >= 0 then (
1|    if the_d2varenv_d2var_is_llamlocal (d2v)
1|      then (d2var_inc_linval (d2v); d2var_set_type (d2v, None ()))
1|      else let
1|        val () = ($LOC.prerr_location (loc0); prerr_string ": error(3)")
1|        val () = (prerr_string ": the linear dynamic variable ["; prerr_d2var (d2v); prerr_string "] is expected to be local but it is not."; prerr_newline ())
1|      in the_trans3errlst_add (T3E_d2var_trup_llamlocal (d2v)) end
1|  ) else ()
//
// [d2exp_trup]: a typed leaf has its type, a (linear) variable is consumed (as d2exp_trup_var_nonmut does: linval incremented, type removed),
// every other expression has the type void
//
2|implement d2exp_trup (d2e) = let
2|  val () = (dd_ps "T3 d2exp_trup "; dd_d2exp d2e; dd_nl ())
2|in
2|  case+ d2exp_node_view (d2e.d2exp_node ()) of
2|  | ~D2Evar (d2v) => let
2|      val s2e = g2_vty (d2v)
2|      val () = g2_consume (g2_dloc d2e, d2v)
2|    in d3exp_var (g2_dloc d2e, s2e, d2v) end
2|  | ~D2Eann_type (_, s2e) => d3exp_top (g2_dloc d2e, s2e)
2|  | v => (d2exp_node_view_free (v); d3exp_top (g2_dloc d2e, s2exp_void_t0ype ()))
2|end
1|implement d2exp_trup (d2e) = let
1|  val () = (dd_ps "T3 d2exp_trup "; dd_d2exp d2e; dd_nl ())
1|in
1|  case+ d2e.d2exp_node of
1|  | D2Evar (d2v) => let
1|      val s2e = g2_vty (d2v)
1|      val () = g2_consume (g2_dloc d2e, d2v)
1|    in d3exp_var (g2_dloc d2e, s2e, d2v) end
1|  | D2Eann_type (_, s2e) => d3exp_top (g2_dloc d2e, s2e)
1|  | _ => d3exp_top (g2_dloc d2e, s2exp_void_t0ype ())
1|end
//
2|fun g2_trups (xs: d2explst): d3explst = (
2|  case+ glist_view (xs) of
2|  | ~GLnil () => glist_nil ()
2|  | ~GLcons (x, xs1) => let val y = d2exp_trup (x) val ys = g2_trups (xs1) in glist_cons<d3exp> (y, ys) end
2|)
1|fun g2_trups (xs: d2explst): d3explst = (
1|  case+ xs of
1|  | list_nil () => list_nil ()
1|  | list_cons (x, xs1) => let val y = d2exp_trup (x) val ys = g2_trups (xs1) in list_cons (y, ys) end
1|)
implement d2explst_trup (d2es) = let
  val () = (dd_ps "T3 d2explst_trup "; dd_d2explst d2es; dd_nl ())
in
  g2_trups (d2es)
end
