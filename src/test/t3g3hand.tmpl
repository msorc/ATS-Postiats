(* the part of the test of the level-3 translation, group 3 (t3g3_gen.py) that is written in the chunks (generated from t3g3hand.tmpl, see t3hand.tmpl for the
   conventions: "2|" lines are ATS2 only, "1|" lines ATS1 only, "<<(" is "@(" in ATS2 and "(" in ATS1): the wrappers of the functions of pats_trans3_{p2at,selab,fldfrat,lvalres} *)
(* ****** ****** *)
//
// after each call: the static errors (stderr) and the count of the errors of the translation
//
fun g3_kint (): s2exp = s2exp_cst (s2cstref_get_cst (the_int_kind))
fun g3_end (): void = (prerr_the_staerrlst (); t3chk ())

// the d2vars of a pattern and of the translated pattern, with the view variable of a variable that is passed by reference: they are updated by the translation
2|fun g3_dvs_loop (xs: d2varlst): void =
2|  case+ glist_view (xs) of
2|  | ~GLnil () => ()
2|  | ~GLcons (v, xs) => (chk_d2var v; (case+ gopt_view (d2var_get_view v) of ~GOsome (w) => chk_d2var w | ~GOnone () => ()); g3_dvs_loop xs)
1|fun g3_dvs_loop (xs: List (d2var)): void =
1|  case+ xs of
1|  | list_nil () => ()
1|  | list_cons (v, xs) => (chk_d2var v; (case+ d2var_get_view v of Some (w) => chk_d2var w | None () => ()); g3_dvs_loop xs)
2|fun g3_dvs (p: p2at): void = g3_dvs_loop ($UT.lstord2list<d2var> (p.p2at_dvs ()))
1|fun g3_dvs (p: p2at): void = g3_dvs_loop ($UT.lstord2list (p.p2at_dvs))
2|fun g3_dvslst (ps: p2atlst): void =
2|  case+ glist_view (ps) of ~GLnil () => () | ~GLcons (p, ps) => (g3_dvs p; g3_dvslst ps)
1|fun g3_dvslst (ps: p2atlst): void =
1|  case+ ps of list_nil () => () | list_cons (p, ps) => (g3_dvs p; g3_dvslst ps)
2|fun g3_p3dv (p: p3at): void = (
2|  case+ p3at_node_view (p.p3at_node ()) of
2|  | ~P3Tany (v) => chk_d2var v
2|  | ~P3Tvar (v) => chk_d2var v
2|  | ~P3Tvbox (v) => chk_d2var v
2|  | ~P3Trefas (v, q) => (chk_d2var v; g3_p3dv q)
2|  | ~P3Tann (q, _) => g3_p3dv q
2|  | ~P3Texist (_, q) => g3_p3dv q
2|  | ~P3Trec (_, _, _, lps) => g3_p3dv_labs lps
2|  | ~P3Tlst (_, _, ps) => g3_p3dv_lst ps
2|  | v => p3at_node_view_free (v)
2|) and g3_p3dv_labs (lps: labp3atlst): void =
2|  case+ glist_view (lps) of ~GLnil () => () | ~GLcons (lp, lps) => (g3_p3dv (lp.labp3at_elt ()); g3_p3dv_labs lps)
2|and g3_p3dv_lst (ps: p3atlst): void =
2|  case+ glist_view (ps) of ~GLnil () => () | ~GLcons (p, ps) => (g3_p3dv p; g3_p3dv_lst ps)
1|fun g3_p3dv (p: p3at): void = (
1|  case+ p.p3at_node of
1|  | P3Tany (v) => chk_d2var v
1|  | P3Tvar (v) => chk_d2var v
1|  | P3Tvbox (v) => chk_d2var v
1|  | P3Trefas (v, q) => (chk_d2var v; g3_p3dv q)
1|  | P3Tann (q, _) => g3_p3dv q
1|  | P3Texist (_, q) => g3_p3dv q
1|  | P3Trec (_, _, _, lps) => g3_p3dv_labs lps
1|  | P3Tlst (_, _, ps) => g3_p3dv_lst ps
1|  | _ => ()
1|) and g3_p3dv_labs (lps: labp3atlst): void =
1|  case+ lps of list_nil () => () | list_cons (lp, lps) => (case+ lp of LABP3AT (_, q) => g3_p3dv q; g3_p3dv_labs lps)
1|and g3_p3dv_lst (ps: p3atlst): void =
1|  case+ ps of list_nil () => () | list_cons (p, ps) => (g3_p3dv p; g3_p3dv_lst ps)
