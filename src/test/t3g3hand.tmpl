2|fun g3_dd_ctxopt (x: s2ctxtopt, probe: s2exp): void =
2|  case+ gopt_view (x) of
2|  | ~GOsome (c) => (dd_ps "Some("; dd_s2exp (s2ctxt_hrepl (c, probe)); dd_ps ")")
2|  | ~GOnone () => dd_ps "None"
1|fun g3_dd_ctxopt (x: s2ctxtopt, probe: s2exp): void =
1|  case+ x of
1|  | Some (c) => (dd_ps "Some("; dd_s2exp (s2ctxt_hrepl (c, probe)); dd_ps ")")
1|  | None () => dd_ps "None"
