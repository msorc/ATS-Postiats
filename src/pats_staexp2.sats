(* ****** ****** *)
//
// Author: Hongwei Xi
// Authoremail: gmhwxi AT gmail DOT com
// Start Time: May, 2011
//
(* ****** ****** *)
//
// HX-2026-10: no GC
// The level-2 static syntax (ATS2 port of src/pats_staexp2.sats, see PORTING.md, section
// "Level 2"). The records and datatypes (s2rt, s2exp, ...) and the cells that were [ref (struct)]
// in ATS1 (s2cst, s2var, s2Var, d2con, s2rtdat, s2rtVar) are generated by arenagen
// (--global --compact) from [pats_staexp2.spec] into the global arena; a [mut] field of a record
// has a setter [set_f (x, v)]. The static sets and maps are persistent AVL trees (pats_avlmap).
//
(* ****** ****** *)

staload "libats/SATS/arena.sats"

(* ****** ****** *)

staload "./pats_basics.sats"

(* ****** ****** *)

staload
INT = "./pats_intinf.sats"
typedef intinf = $INT.intinf

staload
CNTR = "./pats_counter.sats"
typedef count = $CNTR.count
staload STMP = "./pats_stamp.sats"
typedef stamp = $STMP.stamp
typedef stampopt = $STMP.stampopt
staload SYM = "./pats_symbol.sats"
typedef symbol = $SYM.symbol

(* ****** ****** *)

staload
LAB = "./pats_label.sats"
typedef label = $LAB.label

staload
LOC = "./pats_location.sats"
typedef location = $LOC.location

staload
FIL = "./pats_filename.sats"
typedef filename = $FIL.filename

(* ****** ****** *)
//
staload
SYN = "./pats_syntax.sats"
//
typedef c0har = $SYN.c0har
typedef f0loat = $SYN.f0loat
typedef s0tring = $SYN.s0tring
//
typedef scstextdef = $SYN.scstextdef
//
(* ****** ****** *)

staload
EFF = "./pats_effect.sats"
typedef effset = $EFF.effset

(* ****** ****** *)
//
staload "./pats_staexp1.sats"
//
staload "./pats_avlmap.sats"
//
(* ****** ****** *)
//
#define SHARED (x) x // for commenting: it is shared
#define NSHARED (x) x // for commenting: it is not shared
//
(* ****** ****** *)
//
// HX: the sets and the maps: persistent AVL trees (pats_avlmap.sats)
//
abstype s2cstset_type = ptr
typedef s2cstset = s2cstset_type
absvtype s2cstset_vtype = ptr
vtypedef s2cstset_vt = s2cstset_vtype
//
abstype
s2cstmap_type_type (a:type) = ptr
typedef s2cstmap(a:type) = s2cstmap_type_type(a)
//
abstype s2varset_type = ptr
typedef s2varset = s2varset_type
absvtype s2varset_vtype = ptr
vtypedef s2varset_vt = s2varset_vtype
//
abstype s2varmset_type = ptr
typedef s2varmset = s2varmset_type
//
absvtype s2varbindmap_vtype = ptr
vtypedef s2varbindmap = s2varbindmap_vtype
//
abstype s2Varset_type = ptr
typedef s2Varset = s2Varset_type
//
absvtype s2Varset_vtype = ptr
vtypedef s2Varset_vt = s2Varset_vtype
//
abstype d2conset_type = ptr
typedef d2conset = d2conset_type
//
absvtype d2conset_vtype = ptr
vtypedef d2conset_vt = d2conset_vtype
//
abstype s2rtdatset_type = ptr
typedef s2rtdatset = s2rtdatset_type
//
(* ****** ****** *)
//
// HX-2011-05-02:
// [filenv] contains the following
// [s2rtenv], [s2expenv] and [d2expenv]
// (assumed by the level-2 dynamic syntax, not ported yet)
//
abstype filenv_type = ptr
typedef filenv = filenv_type

(* ****** ****** *)
//
// the generated types: s2rt, s2exp_node, s2exp, s2cst, s2var, s2Var, d2con, ...
// and the typedefs of their lists and options (see [pats_staexp2.spec])
//
#include "./pats_staexp2_gen.hats"
//
(* ****** ****** *)

vtypedef s2cstlst_vt = List0_vt (s2cst)
vtypedef s2varlst_vt = List0_vt (s2var)
vtypedef s2varopt_vt = Option_vt (s2var)
vtypedef s2Varlst_vt = List0_vt (s2Var)
vtypedef d2conlst_vt = List0_vt (d2con)
vtypedef s2qualst_vt = List0_vt (s2qua)
vtypedef t2mpmarglst_vt = List0_vt (t2mpmarg)
vtypedef s2itmopt_vt = Option_vt (s2itm)
vtypedef s2rtextopt_vt = Option_vt (s2rtext)
typedef s2ctxtopt_vt = s2ctxtopt

(* ****** ****** *)

abstype s2hnf_type = ptr
typedef s2hnf = s2hnf_type
typedef s2hnflst = glist (s2hnf)

(* ****** ****** *)
//
fun s2rtdat_make (id: symbol): s2rtdat
//
fun s2rtdat_get_sym (s2td: s2rtdat): symbol
fun s2rtdat_get_stamp (s2td: s2rtdat): stamp
//
fun s2rtdat_get_sconlst (s2td: s2rtdat): s2cstlst
fun s2rtdat_set_sconlst (s2td: s2rtdat, s2cs: s2cstlst): void
//
fun
eq_s2rtdat_s2rtdat (s2td1: s2rtdat, s2td2: s2rtdat):<> bool
fun
compare_s2rtdat_s2rtdat (s2td1: s2rtdat, s2td2: s2rtdat):<> int
//
overload = with eq_s2rtdat_s2rtdat
overload compare with compare_s2rtdat_s2rtdat
//
fun print_s2rtdat (x: s2rtdat): void
fun prerr_s2rtdat (x: s2rtdat): void
fun fprint_s2rtdat (out: FILEref, x: s2rtdat): void
//
(* ****** ****** *)
//
fun s2rtdatset_nil (): s2rtdatset
fun s2rtdatset_add (xs: s2rtdatset, x: s2rtdat): s2rtdatset
fun s2rtdatset_listize (xs: s2rtdatset): List0_vt(s2rtdat)
//
(* ****** ****** *)

fun fprint_s2rtbas (out: FILEref, x: s2rtbas): void

(* ****** ****** *)
//
fun
eq_s2rtVar_s2rtVar
  (x1: s2rtVar, x2: s2rtVar): bool
fun
compare_s2rtVar_s2rtVar
  (s2tV1: s2rtVar, s2tV2: s2rtVar): Sgn
//
overload = with eq_s2rtVar_s2rtVar
overload compare with compare_s2rtVar_s2rtVar
//
fun s2rtVar_make (loc: location): s2rtVar
//
(* ****** ****** *)

fun print_s2rt (x: s2rt): void
overload print with print_s2rt
fun prerr_s2rt (x: s2rt): void
overload prerr with prerr_s2rt
fun fprint_s2rt (out: FILEref, x: s2rt): void
overload fprint with fprint_s2rt

fun print_s2rtlst (xs: s2rtlst): void
overload print with print_s2rtlst
fun prerr_s2rtlst (xs: s2rtlst): void
overload prerr with prerr_s2rtlst
fun fprint_s2rtlst (out: FILEref, xs: s2rtlst): void

(* ****** ****** *)
//
// HX:
// pre-defined predicative sorts
//
val s2rt_int : s2rt = "ext#patsopt_s2rt_int" // integers
val s2rt_addr : s2rt = "ext#patsopt_s2rt_addr" // addresses
val s2rt_bool : s2rt = "ext#patsopt_s2rt_bool" // booleans
//
val s2rt_real : s2rt = "ext#patsopt_s2rt_real" // real numbers
//
val s2rt_float : s2rt = "ext#patsopt_s2rt_float" // floating-point
val s2rt_string : s2rt = "ext#patsopt_s2rt_string" // string constants
//
val s2rt_cls : s2rt = "ext#patsopt_s2rt_cls" (* nominal classes *)
//
val s2rt_eff : s2rt = "ext#patsopt_s2rt_eff" (* sets of effects *)
//
val s2rt_tkind : s2rt = "ext#patsopt_s2rt_tkind" // for template arguments
//
// HX:
// pre-defined
// impredicative sorts
//
val s2rt_prop : s2rt = "ext#patsopt_s2rt_prop"
val s2rt_prop_pos : s2rt = "ext#patsopt_s2rt_prop_pos"
val s2rt_prop_neg : s2rt = "ext#patsopt_s2rt_prop_neg"
//
val s2rt_type : s2rt = "ext#patsopt_s2rt_type"
val s2rt_type_pos : s2rt = "ext#patsopt_s2rt_type_pos"
val s2rt_type_neg : s2rt = "ext#patsopt_s2rt_type_neg"
//
val s2rt_t0ype : s2rt = "ext#patsopt_s2rt_t0ype"
val s2rt_t0ype_pos : s2rt = "ext#patsopt_s2rt_t0ype_pos"
val s2rt_t0ype_neg : s2rt = "ext#patsopt_s2rt_t0ype_neg"
//
val s2rt_view : s2rt = "ext#patsopt_s2rt_view"
val s2rt_view_pos : s2rt = "ext#patsopt_s2rt_view_pos"
val s2rt_view_neg : s2rt = "ext#patsopt_s2rt_view_neg"
//
val s2rt_vtype : s2rt = "ext#patsopt_s2rt_vtype"
val s2rt_vtype_pos : s2rt = "ext#patsopt_s2rt_vtype_pos"
val s2rt_vtype_neg : s2rt = "ext#patsopt_s2rt_vtype_neg"
//
val s2rt_vt0ype : s2rt = "ext#patsopt_s2rt_vt0ype"
val s2rt_vt0ype_pos : s2rt = "ext#patsopt_s2rt_vt0ype_pos"
val s2rt_vt0ype_neg : s2rt = "ext#patsopt_s2rt_vt0ype_neg"
//
val s2rt_types : s2rt = "ext#patsopt_s2rt_types"
//
(* ****** ****** *)
//
fun s2rt_impred (knd: int): s2rt // selecting impredicative sorts
//
fun s2rt_fun (_arg: s2rtlst, _res: s2rt): s2rt // forming function sorts
fun s2rt_tup (s2ts: s2rtlst): s2rt (* HX: tuple sorts are not yet supported *)
//
fun s2rt_err (): s2rt // HX: a placeholder indicating error
//
fun s2rt_is_int (x: s2rt): bool
fun s2rt_is_addr (x: s2rt): bool
fun s2rt_is_bool (x: s2rt): bool
//
fun s2rt_is_float (x: s2rt): bool
fun s2rt_is_string (x: s2rt): bool
//
fun s2rt_is_dat (x: s2rt): bool
//
fun s2rt_is_fun (x: s2rt): bool
fun s2rt_is_prf (x: s2rt): bool // is proof?
//
fun s2rt_is_lin (x: s2rt): bool
fun s2rt_is_nonlin (x: s2rt): bool
//
fun s2rt_is_flat (x: s2rt): bool // is flat?
fun s2rt_is_boxed (x: s2rt): bool // is boxed?
//
fun s2rt_is_tkind (x: s2rt): bool // is tkind?
//
fun s2rt_is_prgm (x: s2rt): bool // is program?
fun s2rt_is_impred (x: s2rt): bool // is impredicative?
//
fun s2rt_is_lin_fun (x: s2rt): bool // is (... ->) linear?
fun s2rt_is_flat_fun (x: s2rt): bool // is (... ->) flat?
fun s2rt_is_boxed_fun (x: s2rt): bool // is (... ->) boxed?
fun s2rt_is_tkind_fun (x: s2rt): bool // is (... ->) tkind?
//
fun s2rt_is_prgm_fun (x: s2rt): bool // is (... ->) program?
fun s2rt_is_impred_fun (x: s2rt): bool // is (... ->) impred?
