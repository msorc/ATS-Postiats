(* ****** ****** *)
//
fun
s2cst_make
(
  id: symbol
, loc: location
, fil: filename
, s2t: s2rt // the sort
, isabs: s2expoptopt
, iscon: bool
, isrec: bool
, isasp: s2expopt
, islst: d2conpairopt
, argsrtss: syms2rtlstlst // HX: containing info on arg variances
, s2cstdef: s2expopt
) : s2cst // end of [s2cst_make]
//
fun
s2cst_make_dat
(
  id: symbol
, loc: location
, s2ts_arg: s2rtlstlst, s2t_res: s2rt
, argsrtss: syms2rtlstlst // HX: containing info on arg variances
) : s2cst // end of [s2cst_make_dat]
//
