(* ****** ****** *)
//
// HX-2026-10: no GC (private to src/pats_ccomp_hitype.dats, see PORTING.md, "ccomp group B")
//
// The datatypes [hitype] and [labhitype] of src/pats_ccomp_hitype.dats (they were local to that
// file) as arena types [hit] and [labhit], generated by arenagen from [pats_ccomp_hitype.spec].
// A .sats is needed because the generated declarations are [fun]s without a body.
//
(* ****** ****** *)

staload "libats/SATS/arena.sats"

(* ****** ****** *)

staload "./pats_basics.sats"

(* ****** ****** *)

staload
STMP = "./pats_stamp.sats"
typedef stamp = $STMP.stamp

(* ****** ****** *)

staload
LAB = "./pats_label.sats"
typedef label = $LAB.label

(* ****** ****** *)

staload "./pats_staexp2.sats"
staload "./pats_histaexp.sats"
staload "./pats_ccomp.sats"

(* ****** ****** *)

#include "./pats_ccomp_hitype_gen.hats"

(* ****** ****** *)

(* end of [pats_ccomp_hitype_priv.sats] *)
