//
// HX-2026-10: no GC (ATS2 port of src/pats_staexp2_error.sats)
// The datatype [staerr] is generated by arenagen from [pats_staexp2_error.spec]
// (constructors staerr_STAERR_xxx (..), staerr_view for pattern matching).
//
(* ****** ****** *)

staload "libats/SATS/arena.sats"

(* ****** ****** *)

staload "./pats_basics.sats"

(* ****** ****** *)

staload "./pats_staexp1.sats"
staload "./pats_staexp2.sats"

(* ****** ****** *)

#include "./pats_staexp2_error_gen.hats"

vtypedef staerrlst_vt = List0_vt (staerr)

(* ****** ****** *)
//
fun the_staerrlst_clear (): void
//
fun the_staerrlst_add (x: staerr): void
//
// HX-2011-10-22:
// [n] stores the total number of errors, some of
// which may not be recorded
//
fun the_staerrlst_get (n: &int? >> int): staerrlst_vt
//
(* ****** ****** *)

fun prerr_the_staerrlst (): void

(* ****** ****** *)

(* end of [pats_staexp2_error.sats] *)
