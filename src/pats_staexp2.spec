typedef s2Varopt = gopt(s2Var)
typedef s2VarBoundlst = glist(s2VarBound)
typedef s2ctxtopt = gopt(s2ctxt)
typedef d2conlst = glist(d2con)
typedef d2conopt = gopt(d2con)
typedef d2conpairopt = gopt(d2conpair)
typedef d2conlstopt = gopt(d2conlst)
typedef s2itmlst = glist(s2itm)
typedef s2explst = glist(s2exp)
typedef s2expopt = gopt(s2exp)
typedef s2expoptopt = gopt(s2expopt)
typedef s2explstlst = glist(s2explst)
typedef s2explstopt = gopt(s2explst)
typedef s2lablst = glist(s2lab)
typedef labs2explst = glist(labs2exp)
