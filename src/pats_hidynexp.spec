# arenagen specification for pats_hidynexp.{sats,dats}: the erased-program trees (the output of typerase), --compact
# python3 ../utils/arenagen/arenagen.py --global sats pats_hidynexp.spec > pats_hidynexp_gen.hats
# python3 ../utils/arenagen/arenagen.py --global --compact dats pats_hidynexp.spec > pats_hidynexp_gen_dats.hats
#
# Same conventions as pats_dynexp3.spec (see PORTING.md, "Erased trees (hidynexp)").
# The ATS1 one-constructor datatypes [LABHIPAT (label, hipat)] and [LABHIDEXP (label, hidexp)] are the records [labhipat]
# and [labhidexp]. The mutable parts of ATS1 (the C functions patsopt_hipat_set_asvar, patsopt_hifundec_getref_hideclopt,
# patsopt_hifundec_getref_funlabopt, patsopt_hiimpdec_getref_funlabopt, patsopt_hiimpdec_getref_instrlstopt) are [mut] fields:
# hipat_asvar, hifundec_hidecl, hifundec_funlab, hiimpdec_funlab, hiimpdec_instrlst (the address of a field is
# the address of the cell plus 8 times its index: see [hifundec_getref_hideclopt] and the others).
# [hifundec_hidecl] is a [hideclopt] (ATS1 hid it behind the abstype [hidynexp_hidecl_type] to break the type recursion);
# [funlab] and [instrlst] are the placeholders of the sats that pats_ccomp replaces.
typedef hipatlst = glist(hipat)
typedef hipatopt = gopt(hipat)
typedef labhipatlst = glist(labhipat)
typedef hideclist = glist(hidecl)
typedef hideclopt = gopt(hidecl)
typedef hideclistopt = gopt(hideclist)
typedef hidexplst = glist(hidexp)
typedef hidexpopt = gopt(hidexp)
typedef labhidexplst = glist(labhidexp)
typedef hilablst = glist(hilab)
typedef higmatlst = glist(higmat)
typedef hiclaulst = glist(hiclau)
typedef hifundeclst = glist(hifundec)
typedef hivaldeclst = glist(hivaldec)
typedef hivardeclst = glist(hivardec)
typedef hiimpdeclst = glist(hiimpdec)
typedef hifunlabopt = gopt(funlab)
typedef hiinstrlstopt = gopt(instrlst)
type hipat_node
  HIPany (d2var)
  HIPvar (d2var)
  HIPint (int)
  HIPintrep (string)
  HIPbool (bool)
  HIPchar (char)
  HIPstring (string)
  HIPfloat (string)
  HIPi0nt (i0nt)
  HIPf0loat (f0loat)
  HIPempty ()
  HIPcon (pckind, d2con, hisexp, labhipatlst)
  HIPcon_any (pckind, d2con)
  HIPrec (int, pckind, labhipatlst, hisexp)
  HIPrefas (d2var, hipat)
  HIPann (hipat, hisexp)
  HIPerr ()
record labhipat (labhipat_lab: label, labhipat_elt: hipat)
record hipat (hipat_loc: location, hipat_type: hisexp, hipat_node: hipat_node, mut hipat_asvar: d2varopt)
type hidecl_node
  HIDnone ()
  HIDlist (hideclist)
  HIDsaspdec (s2aspdec)
  HIDreassume (s2cst)
  HIDextype (string, hisexp)
  HIDextvar (string, hidexp)
  HIDextcode (int, int, string)
  HIDexndecs (d2conlst)
  HIDdatdecs (int, s2cstlst)
  HIDdcstdecs (dcstkind, d2cstlst)
  HIDimpdec (int, hiimpdec)
  HIDfundecs (funkind, s2qualst, hifundeclst)
  HIDvaldecs (valkind, hivaldeclst)
  HIDvaldecs_rec (valkind, hivaldeclst)
  HIDvardecs (hivardeclst)
  HIDinclude (int, hideclist)
  HIDstaload (symbolopt, filename, int, filenv, int)
  HIDstaloadloc (filename, symbol, hideclist)
  HIDdynload (filename)
  HIDlocal (hideclist, hideclist)
type hidexp_node
  HDEcst (d2cst)
  HDEvar (d2var)
  HDEint (int)
  HDEintrep (string)
  HDEbool (bool)
  HDEchar (char)
  HDEfloat (string)
  HDEstring (string)
  HDEi0nt (i0nt)
  HDEf0loat (f0loat)
  HDEcstsp (cstsp)
  HDEtyrep (hisexp)
  HDEtop ()
  HDEempty ()
  HDEignore (hidexp)
  HDEcastfn (d2cst, hidexp)
  HDEextval (string)
  HDEextfcall (string, hidexplst)
  HDEextmcall (hidexp, string, hidexplst)
  HDEcon (d2con, hisexp, labhidexplst)
  HDEtmpcst (d2cst, t2mpmarglst)
  HDEtmpvar (d2var, t2mpmarglst)
  HDEfoldat ()
  HDEfreeat (hidexp)
  HDElet (hideclist, hidexp)
  HDEapp (hidexp, hisexp, hidexplst)
  HDEif (hidexp, hidexp, hidexp)
  HDEsif (s2exp, hidexp, hidexp)
  HDEcase (caskind, hidexplst, hiclaulst)
  HDElst (int, hisexp, hidexplst)
  HDErec (int, labhidexplst, hisexp)
  HDEseq (hidexplst)
  HDEselab (hidexp, hisexp, hilablst)
  HDEptrofvar (d2var)
  HDEptrofsel (hidexp, hisexp, hilablst)
  HDErefarg (int, int, hidexp)
  HDEselvar (d2var, hisexp, hilablst)
  HDEselptr (hidexp, hisexp, hilablst)
  HDEassgn_var (d2var, hisexp, hilablst, hidexp)
  HDEassgn_ptr (hidexp, hisexp, hilablst, hidexp)
  HDExchng_var (d2var, hisexp, hilablst, hidexp)
  HDExchng_ptr (hidexp, hisexp, hilablst, hidexp)
  HDEarrpsz (hisexp, hidexplst, int)
  HDEarrinit (hisexp, hidexp, hidexplst, int)
  HDEraise (hidexp)
  HDEvararg (hidexplst)
  HDEtempenver (d2varlst)
  HDElam (int, hipatlst, hidexp)
  HDEfix (int, d2var, hidexp)
  HDEdelay (hidexp)
  HDEldelay (hidexp, hidexp)
  HDElazyeval (int, hidexp)
  HDEloop (hidexpopt, hidexp, hidexpopt, hidexp)
  HDEloopexn (int)
  HDEtrywith (hidexp, hiclaulst)
  HDEerrexp ()
type hilab_node
  HILlab (label)
  HILind (hidexplst)
record labhidexp (labhidexp_lab: label, labhidexp_elt: hidexp)
record hidecl (hidecl_loc: location, hidecl_node: hidecl_node)
record hidexp (hidexp_loc: location, hidexp_type: hisexp, hidexp_node: hidexp_node)
record hilab (hilab_loc: location, hilab_node: hilab_node)
record higmat (higmat_loc: location, higmat_exp: hidexp, higmat_pat: hipatopt)
record hiclau (hiclau_loc: location, hiclau_pat: hipatlst, hiclau_gua: higmatlst, hiclau_seq: int, hiclau_neg: int, hiclau_body: hidexp)
record hifundec (hifundec_loc: location, hifundec_var: d2var, hifundec_imparg: s2varlst, hifundec_def: hidexp, mut hifundec_hidecl: hideclopt, mut hifundec_funlab: hifunlabopt)
record hivaldec (hivaldec_loc: location, hivaldec_pat: hipat, hivaldec_def: hidexp)
record hivardec (hivardec_loc: location, hivardec_knd: int, hivardec_dvar_ptr: d2var, hivardec_dvar_view: d2var, hivardec_type: hisexp, hivardec_init: hidexpopt)
record hiimpdec (hiimpdec_loc: location, hiimpdec_knd: int, hiimpdec_cst: d2cst, hiimpdec_imparg: s2varlst, hiimpdec_tmparg: s2explstlst, hiimpdec_def: hidexp, mut hiimpdec_funlab: hifunlabopt, mut hiimpdec_instrlst: hiinstrlstopt)
