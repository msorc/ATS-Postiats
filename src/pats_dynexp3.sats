// Start Time: October, 2011
//
(* ****** ****** *)
//
// HX-2026-10: no GC (ATS2 port of src/pats_dynexp3.sats, see PORTING.md, "Level 3 trees (dynexp3)")
// The datatypes (p3at_node, d3ecl_node, d3exp_node, d3lab_node) and the records (p3at, d3exp, d3ecl, c3lau, ..)
// are generated by arenagen (--global --compact) from [pats_dynexp3.spec] into the global arena (never freed).
// A [mut] field has a setter [set_f (x, v)]. The index of [c3lau (n)] and of [c3laulst (n)] is dropped.
//
(* ****** ****** *)

staload "libats/SATS/arena.sats"

(* ****** ****** *)

staload "./pats_basics.sats"

(* ****** ****** *)

staload
LOC = "./pats_location.sats"
typedef loc_t = $LOC.location

(* ****** ****** *)

staload "./pats_staexp2.sats"
staload "./pats_staexp2_util.sats"
staload "./pats_dynexp2.sats"

(* ****** ****** *)
//
// the generated types: p3at, d3exp, d3ecl, c3lau, .. and the typedefs of their
// lists and options (see [pats_dynexp3.spec])
//
#include "./pats_dynexp3_gen.hats"
//
(* ****** ****** *)

fun print_p3at (x: p3at): void
overload print with print_p3at
fun prerr_p3at (x: p3at): void
overload prerr with prerr_p3at
fun fprint_p3at (out: FILEref, x: p3at): void
overload fprint with fprint_p3at
fun fprint_p3atlst (out: FILEref, x: p3atlst): void
overload fprint with fprint_p3atlst

