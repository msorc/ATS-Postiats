(* ****** ****** *)
//
// Author: Hongwei Xi
// Authoremail: gmhwxi AT gmail DOT com
// Start Time: February, 2012
//
(* ****** ****** *)
//
// HX-2026-10: no GC (ATS2 port of src/pats_patcst2.sats, see PORTING.md, "Pattern coverage (patcst2)")
// [p2atcst] and [labp2atcst] are arena trees generated by arenagen from [pats_patcst2.spec]
// (the lists of the tree are [glist]s); [p2atcstlst_vt] and the like are linear lists of the (shared)
// constraints. What ATS1 did by [$UN.castvwtp1{p2atcstlst}(xs)] (a borrowed view of a linear list as
// a list) is [p2atcstlst_of_vt] here, and likewise [labp2atcstlst_of_vt], [p2atcstlstlst_of_vt].
//
(* ****** ****** *)

staload "libats/SATS/arena.sats"

(* ****** ****** *)
//
staload
"./pats_basics.sats"
//
(* ****** ****** *)
//
staload
UT = "./pats_utils.sats"
//
typedef charset = $UT.charset
//
(* ****** ****** *)
//
staload
INTINF = "./pats_intinf.sats"
//
typedef intinf = $INTINF.intinf
typedef intinfset = $INTINF.intinfset
//
(* ****** ****** *)

staload
LAB = "./pats_label.sats"
typedef label = $LAB.label

(* ****** ****** *)

staload
SYN = "./pats_syntax.sats"

(* ****** ****** *)

staload
STAEXP2 = "./pats_staexp2.sats"
typedef d2con = $STAEXP2.d2con
staload
DYNEXP2 = "./pats_dynexp2.sats"
typedef p2at = $DYNEXP2.p2at
typedef p2atlst = $DYNEXP2.p2atlst
typedef c2lau = $DYNEXP2.c2lau

(* ****** ****** *)

fun i0nt2intinf (x: $SYN.i0nt): intinf

(* ****** ****** *)
//
// the types p2atcst, labp2atcst, p2atcstlst, labp2atcstlst,
// p2atcstlst_vt, labp2atcstlst_vt, the constructors p2atcst_P2TCany ().. and the views
//
#include "./pats_patcst2_gen.hats"

(* ****** ****** *)

fun p2atcst_lst (lin: int, xs: p2atcstlst): p2atcst

(* ****** ****** *)

typedef
p2atcstlstlst = glist (p2atcstlst)
typedef
labp2atcstlstlst = glist (labp2atcstlst)

(* ****** ****** *)

vtypedef
p2atcstlstlst_vt = List0_vt (p2atcstlst_vt)
vtypedef
labp2atcstlstlst_vt = List0_vt (labp2atcstlst_vt)

(* ****** ****** *)

fun p2atcstlstlst_vt_free (xss: p2atcstlstlst_vt): void
fun p2atcstlstlst_vt_copy (xss: !p2atcstlstlst_vt): p2atcstlstlst_vt

(* ****** ****** *)
//
// the borrowed view of a linear list as a list (a copy of the cells)
//
fun p2atcstlst_of_vt (xs: !p2atcstlst_vt): p2atcstlst
fun labp2atcstlst_of_vt (xs: !labp2atcstlst_vt): labp2atcstlst
fun p2atcstlstlst_of_vt (xss: !p2atcstlstlst_vt): p2atcstlstlst

(* ****** ****** *)
//
fun print_p2atcst (x: p2atcst): void
and prerr_p2atcst (x: p2atcst): void
fun fprint_p2atcst (out: FILEref, x: p2atcst): void
//
(* ****** ****** *)

fun print_p2atcstlst (xs: p2atcstlst): void
and prerr_p2atcstlst (xs: p2atcstlst): void
fun print_p2atcstlst_vt (xs: !p2atcstlst_vt): void
and prerr_p2atcstlst_vt (xs: !p2atcstlst_vt): void
fun fprint_p2atcstlst (out: FILEref, xs: p2atcstlst): void

fun print_labp2atcstlst (xs: labp2atcstlst): void
and prerr_labp2atcstlst (xs: labp2atcstlst): void
fun fprint_labp2atcstlst (out: FILEref, xs: labp2atcstlst): void

fun print_p2atcstlstlst (xss: p2atcstlstlst): void
and prerr_p2atcstlstlst (xss: p2atcstlstlst): void
fun print_p2atcstlstlst_vt (xss: !p2atcstlstlst_vt): void
fun prerr_p2atcstlstlst_vt (xss: !p2atcstlstlst_vt): void
fun fprint_p2atcstlstlst (out: FILEref, xss: p2atcstlstlst): void

(* ****** ****** *)

fun p2at2cst (p2t: p2at): p2atcst
fun p2at2cstlst (p2ts: p2atlst): p2atcstlst

(* ****** ****** *)

fun p2atcst_comp (x: p2atcst): p2atcstlst_vt
fun p2atcstlst_comp (xs: p2atcstlst): p2atcstlstlst_vt

fun labp2atcstlst_comp (xs: labp2atcstlst): labp2atcstlstlst_vt

(* ****** ****** *)
//
fun c2lau_pat_any (c2l: c2lau): p2atcstlstlst_vt
//
fun c2lau_pat_comp (c2l: c2lau): p2atcstlstlst_vt
//
(* ****** ****** *)

fun p2atcst_inter_test (x1: p2atcst, x2: p2atcst): bool
fun p2atcstlst_inter_test (xs1: p2atcstlst, xs2: p2atcstlst): bool

fun labp2atcstlst_inter_test (xs1: labp2atcstlst, xs2: labp2atcstlst): bool

(* ****** ****** *)

fun p2atcst_diff
  (x1: p2atcst, x2: p2atcst): p2atcstlst_vt
fun p2atcstlst_diff
  (xs1: p2atcstlst, xs2: p2atcstlst): p2atcstlstlst_vt
// end of [p2atcstlst_diff]

fun labp2atcst_diff
  (lx1: labp2atcst, lx2: labp2atcst): labp2atcstlst_vt
fun labp2atcstlst_diff
  (xs1: labp2atcstlst, xs2: labp2atcstlst): labp2atcstlstlst_vt
// end of [labp2atcstlst_diff]

(* ****** ****** *)

(* end of [pats_patcst2.sats] *)
