//
// HX-2026-10: no GC
// The level-1 dynamic syntax (ATS2 port of src/pats_dynexp1.sats). The records
// and datatypes of the ATS1 version are generated by arenagen (--global --compact)
// from [pats_dynexp1.spec] into the global arena, as for [pats_staexp1.sats].
//
(* ****** ****** *)

staload "libats/SATS/arena.sats"

(* ****** ****** *)

staload "./pats_basics.sats"
staload "./pats_syntax.sats"
staload "./pats_staexp1.sats"

(* ****** ****** *)
//
staload
LOC = "./pats_location.sats"
typedef loc_t = $LOC.location
//
(* ****** ****** *)
//
// the generated types: p1at_node, p1at, d1ecl_node, d1ecl, d1exp, ...
// and the typedefs of their lists and options (see [pats_dynexp1.spec])
//
