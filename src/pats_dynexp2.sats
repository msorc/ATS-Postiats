overload prerr with prerr_d2cst
fun fprint_d2cst (out: FILEref, x: d2cst): void
fun fprint_d2cstlst (out: FILEref, x: d2cstlst): void
overload fprint with fprint_d2cst
overload fprint with fprint_d2cstlst

