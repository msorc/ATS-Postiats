(* ****** ****** *)

//
// HX-2026-10: no GC (ATS2 port of src/pats_dynexp2.sats, see PORTING.md, "Level 2 dynamic (dynexp2)")
// The datatypes and the records (p2at, d2exp, d2ecl, ..) and the cells that were [ref (struct)] in ATS1
// (d2cst, d2var, d2mac) are generated by arenagen (--global --compact) from [pats_dynexp2.spec] into the
// global arena (never freed); a [mut] field of a record has a setter [set_f (x, v)] (the address is the identity).
// The sets and the maps of d2cst/d2var are persistent AVL trees (pats_avlmap).
//
(* ****** ****** *)

staload "libats/SATS/arena.sats"

(* ****** ****** *)

staload UT = "./pats_utils.sats"
typedef lstord (a:t@ype) = $UT.lstord (a)

(* ****** ****** *)

staload "./pats_basics.sats"

(* ****** ****** *)

staload
LAB = "./pats_label.sats"
typedef label = $LAB.label

(* ****** ****** *)

staload
FIL = "./pats_filename.sats"
typedef filename = $FIL.filename

(* ****** ****** *)

staload
LOC = "./pats_location.sats"
typedef loc_t = $LOC.location
typedef location = $LOC.location

(* ****** ****** *)

staload
SYM = "./pats_symbol.sats"
typedef symbol = $SYM.symbol
typedef symbolopt = $SYM.symbolopt

(* ****** ****** *)
//
staload
SYN = "./pats_syntax.sats"
//
typedef d0ynq = $SYN.d0ynq
//
typedef i0de = $SYN.i0de
typedef i0delst = $SYN.i0delst
//
typedef i0nt = $SYN.i0nt
typedef c0har = $SYN.c0har
typedef f0loat = $SYN.f0loat
typedef s0tring = $SYN.s0tring
//
typedef l0ab = $SYN.l0ab
//
typedef cstsp = $SYN.cstsp
typedef dcstextdef = $SYN.dcstextdef
typedef macsynkind = $SYN.macsynkind
//
(* ****** ****** *)
//
staload
S1E = "./pats_staexp1.sats"
staload
D1E = "./pats_dynexp1.sats"
//
typedef e1xp = $S1E.e1xp
typedef e1xplst = $S1E.e1xplst
typedef s1exp = $S1E.s1exp
typedef d1exp = $D1E.d1exp
//
(* ****** ****** *)

staload "./pats_avlmap.sats"
staload "./pats_staexp2.sats"

(* ****** ****** *)
//
// A place holder for [hisexp]
//
abstype dynexp2_hisexp_type = ptr
typedef hisexp = dynexp2_hisexp_type
//
// A place holder for [funlab]
//
abstype dynexp2_funlab_type = ptr
typedef funlab = dynexp2_funlab_type
//
(* ****** ****** *)
//
// HX: the sets and the maps: persistent AVL trees (pats_avlmap.sats)
//
abstype d2cstset_type = ptr
typedef d2cstset = d2cstset_type
//
absvtype d2cstset_vtype = ptr
vtypedef d2cstset_vt = d2cstset_vtype
//
abstype d2cstmap_type(a:type) = ptr
typedef d2cstmap(a:type) = d2cstmap_type(a)
//
abstype d2varset_type = ptr
typedef d2varset = d2varset_type
absvtype d2varset_vtype = ptr
vtypedef d2varset_vt = d2varset_vtype
//
abstype
d2varmap_type (a:type) = ptr
typedef d2varmap (a:type) = d2varmap_type (a)
absvtype
d2varmap_vtype (a:type) = ptr
vtypedef d2varmap_vt (a:type) = d2varmap_vtype (a)
//
absvtype
d2varmaplst_vtype (a:type) = ptr
vtypedef d2varmaplst_vt (a:type) = d2varmaplst_vtype (a)
//
absvtype d2symset_vtype = ptr
vtypedef d2symset_vt = d2symset_vtype
//
(* ****** ****** *)
datatype pckind =
  | PCKcon // 0 // nonlin
  | PCKlincon // 1 // lincon
  | PCKfree // 2 // freeing
  | PCKunfold // 3 // folding
// end of [pckind]
//
(* ****** ****** *)
//
// the generated types: d2cst, d2var, d2mac, d2itm, p2at, d2exp, d2ecl, i2mpdec, f2undec, ...
// and the typedefs of their lists and options (see [pats_dynexp2.spec])
//
#include "./pats_dynexp2_gen.hats"
//
(* ****** ****** *)


fun
d2cst_make
(
  id: symbol
, loc: loc_t // location of declaration
, fil: filename // filename of declaration
, dck: dcstkind
, decarg: s2qualst
, artylst: intlst
, s2e: s2exp // HX: there is no s2Var in it
, extdef: dcstextdef
) : d2cst // end of [d2cst_make]

