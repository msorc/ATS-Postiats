# arenagen specification for pats_ccomp.{sats,dats}: the data of ccomp (tmplab, tmpvar, funlab, funent, d2env, primval, primdec,
# instr, ..), --compact
# python3 ../utils/arenagen/arenagen.py --global sats pats_ccomp.spec > pats_ccomp_gen.hats
# python3 ../utils/arenagen/arenagen.py --global --compact dats pats_ccomp.spec > pats_ccomp_gen_dats.hats
#
# Same conventions as pats_hidynexp.spec (see PORTING.md, "ccomp interface").
# The ATS1 records of the abstract types (tmplab, tmpvar, funlab, funent: '{..} / @{..} behind an [assume]) and the datatype
# [D2ENV (d2var, hisexp)] are records; the fields that ATS1 changed through C functions (patsopt_tmpvar_set_*,
# patsopt_funent_set_*) or through the setters of the sats (funlab_set_*) are [mut] fields. The one-constructor datatypes
# [LABPRIMVAL], [HIFUNDEC2], [HIIMPDEC2] and the flat pair [tmpmov] are records. [funlab], [instrlst] are the REAL types
# here (they shadow the placeholders of pats_histaexp.sats / pats_hidynexp.sats; hifundec/hiimpdec hold the placeholders
# as words: $UN.cast).
typedef vbindmap = d2varmap(primval)
typedef tmplabopt = gopt(tmplab)
typedef tmpvarlst = glist(tmpvar)
typedef tmpvaropt = gopt(tmpvar)
vtypedef tmpvarlst_vt = List0_vt(tmpvar)
vtypedef tmpvaropt_vt = Option_vt(tmpvar)
typedef d2envlst = glist(d2env)
typedef d2envlstopt = gopt(d2envlst)
vtypedef d2envlst_vt = List0_vt(d2env)
typedef funlablst = glist(funlab)
typedef funlabopt = gopt(funlab)
typedef funlablstopt = gopt(funlablst)
vtypedef funlablst_vt = List0_vt(funlab)
vtypedef funlabopt_vt = Option_vt(funlab)
typedef funentlst = glist(funent)
typedef funentopt = gopt(funent)
vtypedef funentopt_vt = Option_vt(funent)
typedef tmpsubopt = gopt(tmpsub)
vtypedef tmpsubopt_vt = Option_vt(tmpsub)
typedef primdeclst = glist(primdec)
vtypedef primdeclst_vt = List0_vt(primdec)
typedef primvalist = glist(primval)
typedef primvalopt = gopt(primval)
vtypedef primvalist_vt = List0_vt(primval)
typedef labprimvalist = glist(labprimval)
vtypedef labprimvalist_vt = List0_vt(labprimval)
typedef primlablst = glist(primlab)
typedef tmpmovlst = glist(tmpmov)
vtypedef tmpmovlst_vt = List0_vt(tmpmov)
typedef instrlst = glist(instr)
vtypedef instrlst_vt = List0_vt(instr)
typedef instrlstopt = gopt(instrlst)
typedef ibranchlst = glist(ibranch)
record tmplab (tmplab_loc: location, tmplab_stamp: stamp)
record tmpvar (tmpvar_loc: location, mut tmpvar_type: hisexp, mut tmpvar_ref: int, mut tmpvar_ret: int, mut tmpvar_topknd: int, mut tmpvar_origin: tmpvaropt, mut tmpvar_suffix: int, tmpvar_stamp: stamp)
record d2env (d2env_var: d2var, d2env_type: hisexp)
record funlab (funlab_name: string, funlab_level: int, funlab_funclo: funclo, funlab_type: hisexp, mut funlab_tmpknd: int, funlab_d2copt: d2cstopt, funlab_d2vopt: d2varopt, mut funlab_ncopy: int, mut funlab_origin: funlabopt, mut funlab_suffix: int, funlab_tmparg: t2mpmarglst, mut funlab_funent: funentopt, funlab_stamp: stamp)
record funent (funent_loc: location, funent_lab: funlab, funent_imparg: s2varlst, funent_tmparg: s2explstlst, mut funent_tmpsub: tmpsubopt, funent_tmpret: tmpvar, funent_flablst: funlablst, mut funent_flablst_fin: funlablstopt, funent_d2envlst: d2envlst, mut funent_d2envlst_fin: d2envlstopt, funent_vbindmap: vbindmap, funent_instrlst: instrlst, funent_tmpvarlst: tmpvarlst, mut funent_fnxlablst: funlablst)
type tmpsub
  TMPSUBcons (s2var, s2exp, tmpsub)
  TMPSUBnil ()
type tmpcstmat
  TMPCSTMATnone ()
  TMPCSTMATsome (hiimpdec, tmpsub, int)
  TMPCSTMATsome2 (d2cst, s2explstlst, funlab)
type tmpvarmat
  TMPVARMATnone ()
  TMPVARMATsome (hifundec, tmpsub, int)
  TMPVARMATsome2 (d2var, s2explstlst, funlab)
record hifundec2 (hifundec2_hfd: hifundec, hifundec2_sub: tmpsub)
record hiimpdec2 (hiimpdec2_imp: hiimpdec, hiimpdec2_sub: tmpsub, hiimpdec2_arg: s2explstlst)
type primcstsp
  PMCSTSPmyfil (filename)
  PMCSTSPmyloc (location)
  PMCSTSPmyfun (funlab)
type primdec_node
  PMDnone ()
  PMDlist (primdeclst)
  PMDsaspdec (s2aspdec)
  PMDextvar (string, instrlst)
  PMDdatdecs (s2cstlst)
  PMDexndecs (d2conlst)
  PMDfundecs (funkind, s2qualst, hifundeclst)
  PMDvaldecs (valkind, hivaldeclst, instrlst)
  PMDvaldecs_rec (valkind, hivaldeclst, instrlst)
  PMDvardecs (hivardeclst, instrlst)
  PMDimpdec (hiimpdec)
  PMDinclude (int, primdeclst)
  PMDstaload (hidecl)
  PMDstaloadloc (filename, symbol, primdeclst)
  PMDdynload (hidecl)
  PMDlocal (primdeclst, primdeclst)
type primval_node
  PMVtmp (tmpvar)
  PMVtmpref (tmpvar)
  PMVarg (int)
  PMVargref (int)
  PMVargenv (int)
  PMVargtmpref (int)
  PMVcst (d2cst)
  PMVenv (d2var)
  PMVint (int)
  PMVintrep (string)
  PMVbool (bool)
  PMVchar (char)
  PMVfloat (double)
  PMVstring (string)
  PMVi0nt (i0nt)
  PMVf0loat (f0loat)
  PMVcstsp (primcstsp)
  PMVtyrep (hisexp)
  PMVsizeof (hisexp)
  PMVtop ()
  PMVempty ()
  PMVextval (string)
  PMVcastfn (d2cst, primval)
  PMVselcon (primval, hisexp, label)
  PMVselect (primval, hisexp, primlab)
  PMVselect2 (primval, hisexp, primlablst)
  PMVselptr (primval, hisexp, primlablst)
  PMVptrof (primval)
  PMVptrofsel (primval, hisexp, primlablst)
  PMVvararg (primvalist)
  PMVrefarg (int, int, primval)
  PMVfunlab (funlab)
  PMVcfunlab (int, funlab)
  PMVd2vfunlab (d2var, funlab)
  PMVlamfix (d2varopt, primval)
  PMVtmpltcst (d2cst, t2mpmarglst)
  PMVtmpltvar (d2var, t2mpmarglst)
  PMVtmpltcstmat (d2cst, t2mpmarglst, tmpcstmat)
  PMVtmpltvarmat (d2var, t2mpmarglst, tmpvarmat)
  PMVerror ()
type primlab_node
  PMLlab (label)
  PMLind (primvalist)
record labprimval (labprimval_lab: label, labprimval_elt: primval)
record primdec (primdec_loc: location, primdec_node: primdec_node)
record primval (primval_loc: location, primval_type: hisexp, primval_node: primval_node)
record primlab (primlab_loc: location, primlab_node: primlab_node)
type patck
  PATCKcon (d2con)
  PATCKint (int)
  PATCKbool (bool)
  PATCKchar (char)
  PATCKfloat (double)
  PATCKstring (string)
  PATCKi0nt (i0nt)
  PATCKf0loat (f0loat)
type tmprimval
  TPMVnone (primval)
  TPMVsome (tmpvar, primval)
record tmpmov (tmpmov_src: tmprimval, tmpmov_dst: tmpvar)
type patckont
  PTCKNTnone ()
  PTCKNTtmplab (tmplab)
  PTCKNTtmplabint (tmplab, int)
  PTCKNTtmplabmov (tmplab, tmpmovlst)
  PTCKNTcaseof_fail (location)
  PTCKNTfunarg_fail (location, funlab)
  PTCKNTraise (tmpvar, primval)
type instr_node
  INSfunlab (funlab)
  INStmplab (tmplab)
  INScomment (string)
  INSmove_val (tmpvar, primval)
  INSpmove_val (tmpvar, primval)
  INSmove_arg_val (int, primval)
  INSfcall (tmpvar, primval, hisexp, primvalist)
  INSfcall2 (tmpvar, funlab, int, hisexp, primvalist)
  INSextfcall (tmpvar, string, primvalist)
  INSextmcall (tmpvar, primval, string, primvalist)
  INScond (primval, instrlst, instrlst)
  INSfreecon (primval)
  INSloop (tmplab, tmplab, tmplab, instrlst, primval, instrlst, instrlst, instrlst)
  INSloopexn (int, tmplab)
  INScaseof (ibranchlst)
  INSletpop ()
  INSletpush (primdeclst)
  INSmove_con (tmpvar, d2con, hisexp, labprimvalist)
  INSmove_ref (tmpvar, primval)
  INSmove_boxrec (tmpvar, labprimvalist, hisexp)
  INSmove_fltrec (tmpvar, labprimvalist, hisexp)
  INSpatck (primval, patck, patckont)
  INSmove_ptrofsel (tmpvar, primval, hisexp, primlablst)
  INSstore_ptrofs (primval, hisexp, primlablst, primval)
  INSxstore_ptrofs (tmpvar, primval, hisexp, primlablst, primval)
  INSraise (tmpvar, primval)
  INSmove_delay (tmpvar, int, hisexp, primval)
  INSmove_lazyeval (tmpvar, int, hisexp, primval)
  INStrywith (tmpvar, instrlst, ibranchlst)
  INSmove_list_nil (tmpvar)
  INSpmove_list_nil (tmpvar)
  INSpmove_list_cons (tmpvar, hisexp)
  INSmove_list_phead (tmpvar, tmpvar, hisexp)
  INSmove_list_ptail (tmpvar, tmpvar, hisexp)
  INSmove_arrpsz_ptr (tmpvar, tmpvar)
  INSstore_arrpsz_asz (tmpvar, int)
  INSstore_arrpsz_ptr (tmpvar, hisexp, int)
  INSupdate_ptrinc (tmpvar, hisexp)
  INSupdate_ptrdec (tmpvar, hisexp)
  INSclosure_initize (tmpvar, d2varopt, funlab)
  INStmpdec (tmpvar)
  INSextvar (string, primval)
  INSdcstdef (d2cst, primval)
  INStempenver (d2varlst)
record instr (instr_loc: location, instr_node: instr_node)
record ibranch (ibranch_loc: location, ibranch_inslst: instrlst)
