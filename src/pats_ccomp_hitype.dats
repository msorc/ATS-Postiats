#include "share/atspre_staload.hats"

(* ****** ****** *)

staload UN = "prelude/SATS/unsafe.sats"

(* ****** ****** *)

staload "libats/SATS/arena.sats"
staload _(*arena*) = "libats/DATS/arena.dats"

(* ****** ****** *)

staload UT = "./pats_utils.sats"
staload _(*anon*) = "./pats_utils.dats"

(* ****** ****** *)

staload "./pats_basics.sats"

(* ****** ****** *)

staload
STMP = "./pats_stamp.sats"
typedef stamp = $STMP.stamp
overload = with $STMP.eq_stamp_stamp
overload != with $STMP.neq_stamp_stamp

(* ****** ****** *)

staload
LAB = "./pats_label.sats"
typedef label = $LAB.label
overload = with $LAB.eq_label_label
overload != with $LAB.neq_label_label

(* ****** ****** *)

staload
SYM = "./pats_symbol.sats"
typedef symbol = $SYM.symbol

(* ****** ****** *)

staload LOC = "./pats_location.sats"

(* ****** ****** *)

staload "./pats_staexp2.sats"
staload "./pats_histaexp.sats"

(* ****** ****** *)

staload
TYER = "./pats_typerase.sats"

(* ****** ****** *)

staload "./pats_ccomp.sats"

(* ****** ****** *)
//
// HX-2026-10: the datatypes [hitype] and [labhitype] of ATS1 are generated by
// arenagen from pats_ccomp_hitype.spec: [hit] and [labhit]; the abstype [hitype]
// of pats_ccomp.sats is [hit] here
//
staload "./pats_ccomp_hitype_priv.sats"
#include "./pats_ccomp_hitype_gen_dats.hats"
//
(* ****** ****** *)

assume hitype_type = hit

(* ****** ****** *)

implement
print_hitype (hit) = fprint_hitype (stdout_ref, hit)
implement
prerr_hitype (hit) = fprint_hitype (stderr_ref, hit)

(* ****** ****** *)

implement
fprint_hitype
  (out, hit) = let
//
macdef
prstr(x) =
  fprint_string (out, ,(x))
//
in
//
case+ hit_view (hit) of
//
| ~HITnmd
    (name) => {
    val () = prstr "HITnmd("
    val () = fprint_string (out, name)
    val () = prstr ")"
  }
//
| ~HITapp (
    hit_fun, hits_arg
  ) => {
    val () = prstr "HITapp("
    val () = fprint_hitype (out, hit_fun)
    val () = prstr "; "
    val () = fprint_hitypelst (out, hits_arg)
    val () = prstr ")"
  }
//
| ~HITtyarr
    (hit, s2es) => {
    val () = prstr "HITtyarr("
    val () = fprint_hitype (out, hit)
    val () = prstr "["
    val () = fpprint_s2explst (out, s2es)
    val () = prstr "]"
    val () = prstr ")"
  }
//
| ~HITtyrec
    (lhits) => {
    val () = prstr "HITtyrec("
    val () = fprint_string (out, "...")
    val () = prstr ")"
  }
| ~HITtysum
    (tag, lhits) => {
    val () = prstr "HITtysum("
    val () = fprint_string (out, "...")
    val () = prstr ")"
  }
| ~HITtyexn
    (lhits) => {
    val () = prstr "HITtyexn("
    val () = fprint_string (out, "...")
    val () = prstr ")"
  }
//
| ~HITtyvar(s2v) => {
    val () = prstr "HITtyvar("
    val () = fprint_s2var (out, s2v)
    val () = prstr ")"
  }
//
| ~HITtyclo(flab) => {
    val () = prstr "HITtyclo("
    val () = fprint_funlab (out, flab)
    val () = prstr ")"
  }
//
| ~HITvararg(hit) => {
    val () = prstr "HITvararg("
    val () = fprint_hitype (out, hit)
    val ((*closing*)) = prstr ")"
  }
//
| ~HITrefarg
    (knd(*ref/val*), hit) =>
  {
    val () = prstr "HITrefarg("
    val () = fprint_int (out, knd)
    val () = prstr ", "
    val () = fprint_hitype (out, hit)
    val () = prstr ")"
  }
//
| ~HITundef
    (stamp, hse) => {
    val () = prstr "HITundef("
    val () = fprint_hisexp (out, hse)
    val () = prstr ")"
  }
//
| ~HITerror () => prstr "HITerror()"
//
end // end of [fprint_hitype]

implement
fprint_hitypelst
  (out, hits) = $UT.fprintlst<hit> (out, hits, ", ", fprint_hitype)
// end of [fprint_hitypelst]

(* ****** ****** *)
//
extern
fun hitype_error ((*void*)): hitype
extern
fun hitype_tybox ((*void*)): hitype
//
extern
fun hitype_undef (hse: hisexp): hitype
//
(* ****** ****** *)
//
// HX:  0:non-tyvar
// HX:  1:tyvar-boxed
// HX: ~1:tyvar-unboxed
//
extern
fun
hitype_is_tyvarhd (hit0: hitype): int
//
(* ****** ****** *)

implement
hitype_is_tyvarhd
  (hit0) = let
in
//
if hit_is_HITapp (hit0) then let
  val-~HITapp
    (hit_fun, _(*arg*)) = hit_view (hit0)
in
  hitype_is_tyvarhd (hit_fun)
end else if hit_is_HITtyvar (hit0) then let
  val-~HITtyvar (s2v) = hit_view (hit0)
  val s2t = s2var_get_srt(s2v)
  val isbox = s2rt_is_boxed_fun(s2t)
in
  if isbox
    then 1(*boxed*) else ~1(*unboxed*)
  // end of [if]
end else (0)(*non-tyvar*)
//
end (* end of [hitype_is_tyvarhd] *)

(* ****** ****** *)

extern
fun
hitype_tyvar_test(hit0: hitype): bool

(* ****** ****** *)

implement
hitype_tyvar_test
  (hit0) = aux(hit0) where
{
//
fun
aux
(
  hit0: hitype
) : bool =
//
if hit_is_HITapp (hit0) then let
  val-~HITapp (hit, _) = hit_view (hit0) in aux(hit)
end else if hit_is_HITtyrec (hit0) then let
  val-~HITtyrec (lhits) = hit_view (hit0) in auxlablst(lhits)
end else if hit_is_HITtysum (hit0) then let
  val-~HITtysum (_, lhits) = hit_view (hit0) in auxlablst(lhits)
end else if hit_is_HITtyexn (hit0) then let
  val-~HITtyexn (lhits) = hit_view (hit0) in auxlablst(lhits)
end else if hit_is_HITtyvar (hit0) then let
  val-~HITtyvar (s2v) = hit_view (hit0)
  val s2t = s2var_get_srt(s2v)
in
  if s2rt_is_boxed_fun(s2t) then false else true
end else false // rest-of-hitype
//
and
auxlablst
(
  lxs: labhitlst
) : bool =
//
if glist_is_cons (lxs) then let
  val lx = glist_head<labhit> (lxs)
  val lxs = glist_tail<labhit> (lxs)
  val hit = lx.labhit_elt ()
in
  if aux(hit) then true else auxlablst(lxs)
end else false // end of [list_nil]
//
} (* end of [hitype_tyvar_test] *)

(* ****** ****** *)
//
extern
fun
eq_hitype_hitype(x1: hitype, x2: hitype): bool
//
(* ****** ****** *)

extern
fun s2exp_typize (flag: int, s2e: s2exp): hitype
extern
fun s2zexp_typize (flag: int, s2ze: s2zexp): hitype

(* ****** ****** *)
//
extern
fun
emit_hitypelst_sep
  (out: FILEref, hits: hitypelst, sep: string): void
//
(* ****** ****** *)
//
// HX-2026-10: the ATS1 version raised an exception at the first
// difference; here every function returns a bool (same tests, same order)
//
implement
eq_hitype_hitype
  (x1, x2) = let
//
fun
aux
(
  x1: hitype, x2: hitype
) : bool =
//
if hit_is_HITnmd (x1) then (
//
  if hit_is_HITnmd (x2) then let
    val-~HITnmd (name1) = hit_view (x1)
    val-~HITnmd (name2) = hit_view (x2)
  in
    if compare (name1, name2) != 0 then false else true
  end else false
//
) else if hit_is_HITapp (x1) then (
//
  if hit_is_HITapp (x2) then let
    val-~HITapp (x11, xs12) = hit_view (x1)
    val-~HITapp (x21, xs22) = hit_view (x2)
  in
    if aux(x11, x21) then auxlst(xs12, xs22) else false
  end else false
//
) else if hit_is_HITtyarr (x1) then false
//
else if hit_is_HITtyrec (x1) then (
//
  if hit_is_HITtyrec (x2) then let
    val-~HITtyrec (lxs1) = hit_view (x1)
    val-~HITtyrec (lxs2) = hit_view (x2)
  in
    auxlablst(lxs1, lxs2)
  end else false
//
) else if hit_is_HITtysum (x1) then (
//
  if hit_is_HITtysum (x2) then let
    val-~HITtysum (tgd1, lxs1) = hit_view (x1)
    val-~HITtysum (tgd2, lxs2) = hit_view (x2)
  in
    if tgd1 = tgd2
      then auxlablst(lxs1, lxs2) else false
    // end of [if]
  end else false
//
) else if hit_is_HITtyexn (x1) then (
//
  if hit_is_HITtyexn (x2) then let
    val-~HITtyexn (lxs1) = hit_view (x1)
    val-~HITtyexn (lxs2) = hit_view (x2)
  in
    auxlablst(lxs1, lxs2)
  end else false
//
) else if hit_is_HITtyvar (x1) then (
//
  if hit_is_HITtyvar (x2) then let
    val-~HITtyvar (s2v1) = hit_view (x1)
    val-~HITtyvar (s2v2) = hit_view (x2)
  in
    if eq_s2var_s2var (s2v1, s2v2) then true else false
  end else false
//
) else if hit_is_HITtyclo (x1) then (
//
  if hit_is_HITtyclo (x2) then let
    val-~HITtyclo (flab1) = hit_view (x1)
    val-~HITtyclo (flab2) = hit_view (x2)
    val p1 = $UN.cast{ptr}(flab1)
    val p2 = $UN.cast{ptr}(flab2)
  in
    if p1 != p2 then false else true
  end else false
//
) else if hit_is_HITvararg (x1) then (
//
  if hit_is_HITvararg (x2) then let
    val-~HITvararg (hit1) = hit_view (x1)
    val-~HITvararg (hit2) = hit_view (x2)
  in
    aux(hit1, hit2)
  end else false
//
) else if hit_is_HITrefarg (x1) then (
//
  if hit_is_HITrefarg (x2) then let
    val-~HITrefarg (knd1, hit1) = hit_view (x1)
    val-~HITrefarg (knd2, hit2) = hit_view (x2)
  in
    if knd1 = knd2
      then aux(hit1, hit2) else false
    // end of [if]
  end else false
//
) else if hit_is_HITundef (x1) then (
//
  if hit_is_HITundef (x2) then let
    val-~HITundef (stamp1, _) = hit_view (x1)
    val-~HITundef (stamp2, _) = hit_view (x2)
  in
    if (stamp1 != stamp2) then false else true
  end else false
//
) else false // HITerror
//
and
auxlst
(
  xs1: hitypelst, xs2: hitypelst
) : bool =
//
if glist_is_cons (xs1) then (
  if glist_is_cons (xs2) then let
    val x1 = glist_head<hit> (xs1)
    val xs1 = glist_tail<hit> (xs1)
    val x2 = glist_head<hit> (xs2)
    val xs2 = glist_tail<hit> (xs2)
  in
    if aux (x1, x2) then auxlst (xs1, xs2) else false
  end else false
) else (
  if glist_is_cons (xs2) then false else true
) (* end of [auxlst] *)
//
and
auxlablst
(
  lxs1: labhitlst, lxs2: labhitlst
) : bool =
//
if glist_is_cons (lxs1) then (
  if glist_is_cons (lxs2) then let
    val lx1 = glist_head<labhit> (lxs1)
    val lxs1 = glist_tail<labhit> (lxs1)
    val lx2 = glist_head<labhit> (lxs2)
    val lxs2 = glist_tail<labhit> (lxs2)
    val l1 = lx1.labhit_lab ()
    val opt1 = lx1.labhit_opt ()
    val x1 = lx1.labhit_elt ()
    val l2 = lx2.labhit_lab ()
    val opt2 = lx2.labhit_opt ()
    val x2 = lx2.labhit_elt ()
    val ans = (
      if (l1 != l2) then false else (
        if gopt_is_none (opt1) then (
          if gopt_is_none (opt2) then true else false
        ) else (
          if gopt_is_none (opt2) then false else let
            val nm1 = gopt_unsome<string> (opt1)
            val nm2 = gopt_unsome<string> (opt2)
          in
            if compare (nm1, nm2) != 0 then false else true
          end
        ) (* end of [if] *)
      ) (* end of [if] *)
    ) : bool // end of [val]
  in
    if ans then (
      if aux (x1, x2) then auxlablst (lxs1, lxs2) else false
    ) else false
  end else false
) else (
  if glist_is_cons (lxs2) then false else true
) (* end of [auxlablst] *)
//
in
  aux (x1, x2)
end // end of [eq_hitype_hitype]

(* ****** ****** *)

extern
fun
hitype_hash (hit: hitype): ulint

local

fun
auxint (
  hval: &ulint, int: int
) : void = let
  val int = $UN.cast{ulint} (int)
in
  hval := (hval << 8) + hval + int // hval = 65*hval + int
end // end of [auxint]

fun
auxstr_ptr (
  hval: &ulint, p: ptr
) : void = let
  val c = $UN.ptr0_get<char> (p)
in
  if (c != '\000') then let
    val c = $UN.cast{ulint} (c)
    val () = hval := (hval << 5) + hval + c
  in
    auxstr_ptr (hval, ptr0_succ<char> (p))
  end else ()
end // end of [auxstr_ptr]

fun
auxstr (
  hval: &ulint, str: string
) : void = auxstr_ptr (hval, $UN.cast{ptr}(str))

fun
auxsym (
  hval: &ulint, sym: symbol
) : void =
  auxstr (hval, $SYM.symbol_get_name (sym))
// end of [auxsym]

fun aux
(
  hval: &ulint, hit0: hitype
) : void = let
in
//
case+ hit_view (hit0) of
//
| ~HITnmd
    (name) => auxstr(hval, name)
  // end of [HITnmd]
//
| ~HITapp
    (_fun, _arg) => let
    val () = aux(hval, _fun)
    val () = auxlst(hval, _arg)
  in
    auxstr( hval, "postiats_app" )
  end // end of [HITapp]
//
| ~HITtyarr
    (hit_elt, _) => let
    val () = aux(hval, hit_elt)
  in
    auxstr( hval, "postiats_tyarr" )
  end // end of [HITtyarr]
//
| ~HITtyrec
    (lhits) => let
    val () = auxlablst(hval, lhits)
  in
    auxstr( hval, "postiats_tyrec" )
  end // end of [HITtyrec]
| ~HITtysum
    (tgd, lhits) => let
    val () = auxint(hval, tgd)
    val () = auxlablst(hval, lhits)
  in
    auxstr( hval, "postiats_tysum" )
  end // end of [HITtysum]
| ~HITtyexn
    (lhits) => let
    val () = auxlablst(hval, lhits)
  in
    auxstr( hval, "postiats_tyexn" )
  end // end of [HITtyexn]
//
| ~HITtyvar(s2v) => let
    val () =
      auxstr(hval, "postiats_tyvar")
    // end of [val]
    val stamp = s2var_get_stamp(s2v)
  in
    auxint(hval, $STMP.stamp_get_int(stamp))
  end // end of [HITtyvar]
//
| ~HITtyclo(flab) => let
    val () =
      auxstr(hval, "postiats_tyclo")
    // end of [val]
    val stamp = funlab_get_stamp(flab)
  in
    auxint(hval, $STMP.stamp_get_int(stamp))
  end // end of [HITtyclo]
//
| ~HITvararg(hit) =>
  {
    val () = aux(hval, hit)
    val () = auxstr(hval, "postiats_vararg")
    // end of [val]
  } (* end of [HITvararg] *)
//
| ~HITrefarg
    (knd, hit) => let
    val () = aux(hval, hit)
  in
    if knd = 0
      then auxstr(hval, "postiats_refarg0")
      else auxstr(hval, "postiats_refarg1")
    // end of [if]
  end // end of [HITrefarg]
//
| ~HITundef
    (stamp, hse) =>
    auxint(hval, $STMP.stamp_get_int(stamp))
  // end of [HITundef]
//
| ~HITerror() => auxstr(hval, "postiats_error")
//
end // end of [aux]

and
auxlst (
  hval: &ulint, hits: hitypelst
) : void = let
in
//
if glist_is_cons (hits) then let
  val hit = glist_head<hit> (hits)
  val hits = glist_tail<hit> (hits)
  val () = aux (hval, hit)
in
  auxlst (hval, hits)
end else ()
//
end // end of [auxlst]

and auxlab (
  hval: &ulint, lhit: labhit
) : void = let
//
val l = lhit.labhit_lab ()
val hit = lhit.labhit_elt ()
val opt = $LAB.label_get_int (l)
val () = (
  case+ opt of
  | ~Some_vt (x) => auxint (hval, x) | ~None_vt () => ()
) : void // end of [val]
val opt = $LAB.label_get_sym (l)
val () = (
  case+ opt of
  | ~Some_vt (x) => auxsym (hval, x) | ~None_vt () => ()
) : void // end of [val]
//
in
  aux (hval, hit)
end // end of [auxlab]

and
auxlablst (
  hval: &ulint, lhits: labhitlst
) : void = let
in
//
if glist_is_cons (lhits) then let
  val lhit = glist_head<labhit> (lhits)
  val lhits = glist_tail<labhit> (lhits)
  val () = auxlab (hval, lhit)
in
  auxlablst (hval, lhits)
end else ()
//
end // end of [auxlablst]

in (* in of [local] *)

implement
hitype_hash (hit) = let
  var hval
    : ulint = 618034ul // HX: randomly chosen
  val () = aux (hval, hit)
in
  hval
end // end of [hitype_hash]

end // end of [local]

(* ****** ****** *)
//
extern
fun
the_hitypemaplst_get (): List0_vt @(hitype, hitype)
//
extern
fun
the_hitypemap_search (hit: hitype): Option_vt (hitype)
extern
fun
the_hitypemap_insert (hit: hitype, hit2: hitype): void
//
(* ****** ****** *)

local

(* ****** ****** *)
//
// HX-2013-01:
// Using hashtable in ATS is really difficult!
//
(* ****** ****** *)
//
staload H =
"libats/SATS/hashtbl_linprb.sats"
staload _(*anon*) =
"libats/DATS/hashtbl_linprb.dats"
//
typedef key = hit
typedef itm = hit(*unnamed*)
//
//
// HX-2026-10: the table of libats/hashtbl_linprb marks an empty slot by a null key
//
implement
$H.hashtbl_linprb_keyitm_is_null<key,itm> (kx) = ($UN.cast{ptr}(kx.0) = the_null_ptr)
//
implement
$H.hash_key<key> (k) = $effmask_all (hitype_hash (k))
implement
$H.equal_key_key<key> (k1, k2) = $effmask_all (eq_hitype_hitype (k1, k2))
//
// HX: the table lives forever (it is never freed)
//
val the_hitypemap =
  $UN.castvwtp0{ptr}($H.hashtbl_make_nil<key,itm> (i2sz(1024)))
//
(* ****** ****** *)
//
// HX: the list of (key, item), newest first, in a cell of the global arena
// (an immutable glist in the cell; a nil list is a null pointer)
//
typedef keyitm = @(hitype, hitype)
//
val the_hitypemaplst = the_garena_alloc (i2sz(8))
//
(* ****** ****** *)

in (* in of [local] *)

(* ****** ****** *)

implement
the_hitypemaplst_get
  ((*void*)) = let
//
val kis = $UN.ptr0_get<glist(keyitm)> (the_hitypemaplst)
val ((*void*)) =
  $UN.ptr0_set<glist(keyitm)> (the_hitypemaplst, glist_nil())
//
fun
loop
(
  kis: glist(keyitm), res: List0_vt(keyitm)
) : List0_vt(keyitm) =
  if glist_is_cons (kis) then
    loop (glist_tail<keyitm> (kis), list_vt_cons (glist_head<keyitm> (kis), res))
  else res
//
in
  loop (kis, list_vt_nil ())
end // end of [the_hitypemaplst_get]

(* ****** ****** *)

implement
the_hitypemap_search
  (hit) = let
//
val tbl = $UN.castvwtp0{$H.hashtbl(key,itm)}(the_hitypemap)
val opt = $H.hashtbl_search_opt<key,itm> (tbl, hit)
val _ = $UN.castvwtp0{ptr}(tbl)
//
in
  opt
end // end of [the_hitypemap_search]

(* ****** ****** *)

implement
the_hitypemap_insert
  (hit, hit2) = let
//
val tbl = $UN.castvwtp0{$H.hashtbl(key,itm)}(the_hitypemap)
val opt = $H.hashtbl_insert_opt<key,itm> (tbl, hit, hit2)
val () = (case+ opt of ~Some_vt _ => () | ~None_vt () => ())
val _ = $UN.castvwtp0{ptr}(tbl)
//
val kis = $UN.ptr0_get<glist(keyitm)> (the_hitypemaplst)
val () =
  $UN.ptr0_set<glist(keyitm)>
    (the_hitypemaplst, glist_cons<keyitm> (@(hit, hit2), kis))
//
in
  // nothing
end // end of [the_hitypemap_insert]

end // end of [local]

(* ****** ****** *)
//
implement
hitype_error() =
  hit_HITerror((*void*))
//
implement
hitype_tybox() = hit_HITnmd("atstype_boxed")
//
implement
hitype_undef(hse) = let
  val s = $STMP.hitype_stamp_make () in hit_HITundef(s, hse)
end // end of [hitype_undef]
//
(* ****** ****** *)
//
extern
fun
emit_s2var
  (out: FILEref, s2v: s2var): void
//
implement
emit_s2var
  (out, s2v) = let
  val sym = s2var_get_sym (s2v)
  val name = $SYM.symbol_get_name (sym)
in
  emit_ident (out, name)
end // end of [emit_s2var]
//
(* ****** ****** *)
//
extern
fun
emit_hitype_app
(
  out: FILEref, hit0: hitype
) : void // end-of-fun
//
implement
emit_hitype_app
  (out, hit0) = let
//
fun aux
(
  out: FILEref, hit0: hitype
) : void = let
in
//
if hit_is_HITapp (hit0) then let
  val-~HITapp
    (hit_fun, hits_arg) = hit_view (hit0)
  val () = aux (out, hit_fun)
  val () = emit_text (out, "(")
  val () = emit_hitypelst_sep (out, hits_arg, ", ")
  val () = emit_text (out, ")")
in
  // nothing
end else if hit_is_HITtyvar (hit0) then let
  val-~HITtyvar (s2v) = hit_view (hit0) in emit_s2var (out, s2v)
end else emit_hitype (out, hit0) // rest-of-hitype
//
end // end of [aux]
//
val knd = hitype_is_tyvarhd (hit0)
//
val () =
if knd > 0
  then emit_text (out, "atstybox_type(")
val () =
if knd < 0
  then emit_text (out, "atstyvar_type(")
//
val () = aux (out, hit0)
//
val () = if knd != 0 then emit_text (out, ")")
//
in
  // nothing
end // end of [emit_hitype_app]
//
(* ****** ****** *)

implement
emit_hitype
  (out, hit0) = let
//
in
//
case+ hit_view (hit0) of
//
| ~HITnmd
    (name) => emit_text (out, name)
  // end of [HITnmd]
//
| ~HITapp (_, _) => emit_hitype_app (out, hit0)
//
| ~HITtyarr
    (hit, _) => {
    val () =
      emit_text (out, "atstyarr_type(")
    // end of [val]
    val ((*void*)) = emit_hitype (out, hit)
    val ((*void*)) = emit_text (out, ")")
  } (* end of [HITtyarr] *)
//
| ~HITtyrec (_) => emit_text (out, "atstyrec_type(*ERROR*)")
| ~HITtysum (_, _) => emit_text (out, "atstysum_type(*ERROR*)")
| ~HITtyexn (_) => emit_text (out, "atstyexn_type(*ERROR*)")
//
| ~HITtyclo (flab) =>
  {
    val () =
      emit_text (out, "atstyclo_type(")
    val ((*void*)) = emit_funlab (out, flab)
    val ((*void*)) = emit_text (out, ")")
  }
//
| ~HITtyvar (s2v) => {
//
    val () =
      emit_text (out, "atstyvar_type(")
    // end of [val]
//
    val () = emit_s2var (out, s2v)
    val ((*closing*)) = emit_RPAREN (out)
//
  } (* end of [HITtyvar] *)
//
| ~HITvararg (hit) =>
  {
//
    val () =
      emit_text(out, "atsvararg_type(")
    // end of [val]
//
    val () = emit_hitype (out, hit)
//
    val ((*closing*)) = emit_RPAREN (out)
//
  } (* end of [HITvararg] *)
//
| ~HITrefarg (knd, hit) => let
    val () = (
      if knd = 0
        then emit_text (out, "atsrefarg0_type(")
        else emit_text (out, "atsrefarg1_type(")
      // end of [if]
    ) : void // end of [val]
    val () = emit_hitype (out, hit)
    val ((*closing*)) = emit_RPAREN (out)
  in
    // nothing
  end // end of [HITrefarg]
//
| ~HITundef (_, hse) => let
    val () =
      emit_text (out, "postiats_undef(")
    val ((*void*)) = fprint_hisexp (out, hse)
    val ((*void*)) = emit_text (out, ")")
  in
    // nothing
  end // end of [HITundef]
//
| ~HITerror () => emit_text (out, "postiats_error()")
//
end // end of [emit_hitype]

implement
emit_hitypelst_sep
  (out, hits, sep) = let
//
fun
auxlst (
  out: FILEref
, xs: hitypelst, sep: string, i: int
) : void = let
in
//
if glist_is_cons (xs) then let
  val x = glist_head<hit> (xs)
  val xs = glist_tail<hit> (xs)
  val () =
    if i > 0 then emit_text (out, sep)
  val () = emit_hitype (out, x)
in
  auxlst (out, xs, sep, i+1)
end else ()
//
end // end of [auxlst]
//
in
  auxlst (out, hits, sep, 0)
end // end of [emit_hitypelst_sep]

(* ****** ****** *)

implement
emit_hisexp
  (out, hse) = let
//
val hit = hisexp_typize (1, hse)
//
in
//
if hit_is_HITundef (hit) then
  (
    emit_text (out, "HITundef("); fprint_hisexp (out, hse); emit_text (out, ")")
  ) (* end of [HITundef] *)
else emit_hitype (out, hit) // non-undef
//
end // end of [emit_hisexp]

(* ****** ****** *)

implement
emit_hisexplst_sep
  (out, hses, sep) = let
//
fun
loop
(
  out: FILEref
, hses: hisexplst, sep: string, i: int
) : void = let
//
in
//
if glist_is_cons (hses) then let
  val hse = glist_head<hisexp> (hses)
  val hses = glist_tail<hisexp> (hses)
  val () =
    if i > 0
      then emit_text (out, sep)
    // end of [if]
  val () = emit_hisexp (out, hse)
in
  loop (out, hses, sep, i+1)
end else ()
//
end // end of [loop]
//
in
  loop (out, hses, sep, 0)
end // end of [emit_hisexplst_sep]

(* ****** ****** *)

implement
emit_hisexp_sel
  (out, hse) = let
//
val hit = hisexp_typize (0, hse)
//
in
//
if hit_is_HITundef (hit) then
  (
    emit_text (out, "HITundef(");
    fprint_hisexp (out, hse); emit_text (out, ")")
  ) // end of [HITundef]
else emit_hitype (out, hit) // non-undef
//
end // end of [emit_hisexp_sel]

(* ****** ****** *)

extern
fun
hitype_gen_tyrec (): hitype
implement
hitype_gen_tyrec () = let
  val n = $STMP.hitype_stamp_make ()
  val name = $STMP.tostring_prefix_stamp ("postiats_tyrec_", n)
in
  hit_HITnmd (name)
end // end of [hitype_gen_tyrec]

extern
fun
hitype_gen_tysum (): hitype
implement
hitype_gen_tysum () = let
  val n = $STMP.hitype_stamp_make ()
  val name = $STMP.tostring_prefix_stamp ("postiats_tysum_", n)
in
  hit_HITnmd (name)
end // end of [hitype_gen_tysum]

extern
fun hitype_gen_tyexn (): hitype
implement
hitype_gen_tyexn () = let
  val n = $STMP.hitype_stamp_make ()
  val name = $STMP.tostring_prefix_stamp ("postiats_tyexn_", n)
in
  hit_HITnmd (name)
end // end of [hitype_gen_tyexn]

(* ****** ****** *)

implement
s2exp_typize
  (flag, s2e0) = let
//
fun
auxlst
(
  flag: int, s2es: s2explst
) : hitypelst =
(
  if glist_is_cons (s2es) then let
    val s2e = glist_head<s2exp> (s2es)
    val s2es = glist_tail<s2exp> (s2es)
    val hit = s2exp_typize(flag, s2e)
    val hits = auxlst(flag, s2es)
  in
    glist_cons<hit> (hit, hits)
  end else glist_nil((*void*))
)
//
fun
auxlstlst_app
(
  flag: int
, hit0: hitype, s2ess: s2explstlst
) : hitype =
(
  if glist_is_cons (s2ess) then let
    val s2es = glist_head<s2explst> (s2ess)
    val s2ess = glist_tail<s2explst> (s2ess)
    val hits_arg = auxlst(flag, s2es)
  in
    auxlstlst_app(flag, hit_HITapp(hit0, hits_arg), s2ess)
  end else hit0
)
//
in
//
case+
s2exp_node_view (s2e0.s2exp_node ())
of (* case+ *)
//
| ~S2Eextype
    (name, s2ess) => let
    val hit0 = hit_HITnmd(name)
  in
    auxlstlst_app(flag, hit0, s2ess)
  end // end of [S2Eextype]
//
| ~S2Eextkind
    (name, s2ess) => hit_HITnmd(name)
  // end of [S2Eextkind]
//
| ~S2EVar(s2V) =>
  (
    s2zexp_typize(flag, s2Var_get_szexp(s2V))
  ) (* end of [S2EVar] *)
//
| ~S2Eat(s2e, s2l) => hitype_error() // HX: view is not type
//
| v (*rest*) => let
    val () = s2exp_node_view_free (v)
    val hse0 = $TYER.s2exp_tyer_shallow($LOC.location_dummy, s2e0)
  in
    hisexp_typize(flag, hse0)
  end (* end of [_] *)
//
end // end of [s2exp_typize]

(* ****** ****** *)

implement
s2zexp_typize
  (flag, s2ze0) = let
//
in
//
case+ s2zexp_view (s2ze0) of
//
| ~S2ZEextype (name, _) => hit_HITnmd (name)
| ~S2ZEextkind (name, _) => hit_HITnmd (name)
| v (*rest*) => let
    val () = s2zexp_view_free (v)
    val hse0 = $TYER.s2zexp_tyer ($LOC.location_dummy, s2ze0)
  in
    hisexp_typize (flag, hse0)
  end // end of [_]
//
end // end of [s2zexp_typize]

(* ****** ****** *)

local

fun
aux
(
  flag: int, hse0: hisexp
) : hitype = let
//
val hnm = hse0.hisexp_name ()
val knd = hnm.hitnam_ptr ()
val fin = hnm.hitnam_fin ()
val name = hnm.hitnam_name ()
//
in
//
if (fin > 0) then hit_HITnmd (name) else
(
case+
hisexp_node_view (hse0.hisexp_node ())
of (* case+ *)
//
| ~HSEcst (s2c) => aux_s2cst (s2c)
//
| ~HSEtybox () => hitype_undef (hse0)
//
| ~HSEapp (_fun, _arg) => let
    val hit_fun = aux(flag, _fun)
    val hits_arg = auxlst(flag, _arg)
  in
    hit_HITapp (hit_fun, hits_arg)
  end // end of [HSEapp]
//
| ~HSEtyabs (sym) => let
    val name =
      $SYM.symbol_get_name (sym) in hit_HITnmd (name)
    // end of [val]
  end // end of [HSEtyabs]
//
| ~HSEextype (_, _) => hitype_undef (hse0)
//
| ~HSEfun (_, _, _) => hitype_undef (hse0)
//
| ~HSEtyarr (_, _) => aux_tyarr (flag, hse0)
//
| ~HSEtyrec (_, _) => aux_tyrec (flag, hse0)
//
| ~HSEtyrecsin (lhse) => let
    val hse = lhse.labhisexp_elt () in aux (flag, hse)
  end // end of [HSEtyrecsin]
//
| ~HSEtysum
    (d2c, _) =>
  (
    if d2con_is_con (d2c)
      then aux_tysum (flag, hse0) else aux_tyexn (flag, hse0)
    // end of [if]
  ) // end of [HSEtysum]
//
| ~HSEtyclo
    (flab) => hit_HITtyclo($UN.cast{funlab}(flab))
  // end of [HSEtyclo]
//
| ~HSEvararg
    (s2e) => let
    val
    hit = s2exp_typize(flag, s2e) in hit_HITvararg(hit)
  end // end of [HSEvararg]
//
| ~HSErefarg
    (knd, hse) => let
    val hit = aux(flag, hse) in hit_HITrefarg(knd, hit)
  end // end of [HSErefarg]
//
| ~HSEs2exp(s2e) => let
    val hit = s2exp_typize(flag, s2e) in
    if hit_is_HITerror (hit) then hitype_undef(hse0) else (hit)
  end // end of [HSEs2exp]
//
| ~HSEs2zexp
    (s2ze) => let
    val hit = s2zexp_typize(flag, s2ze) in
    if hit_is_HITerror (hit) then hitype_undef(hse0) else (hit)
  end // end of [HSEs2zexp]
//
| ~HSEtyvar (s2v) => hit_HITtyvar (s2v)
//
) (* end of [if] *)
//
end // end of [aux]

and
aux_s2cst
  (s2c: s2cst): hitype = let
in
//
if s2cst_is_datype(s2c) then hitype_tybox()
else let
    val sym =
      s2cst_get_sym(s2c)
    val name =
      $SYM.symbol_get_name (sym) in hit_HITnmd(name)
    // end of [val]
  end // end of [_]
//
end // end of [aux_s2cst]

and
aux_tyarr
(
  flag: int, hse0: hisexp
) : hitype = let
//
val-~HSEtyarr
  (hse_elt, dim) = hisexp_node_view (hse0.hisexp_node ())
val hit_elt = aux (flag+1, hse_elt)
//
in
  hit_HITtyarr (hit_elt, dim)
end // end of [aux_tyarr]

and
aux_tyrec
(
  flag: int, hse0: hisexp
) : hitype = let
//
val-~HSEtyrec
  (knd, lxs) = hisexp_node_view (hse0.hisexp_node ())
in
//
case+ tyreckind_view (knd) of
//
| ~TYRECKINDbox() =>
    if flag > 0
      then hitype_tybox()
      else aux_tyrec2 (flag, lxs)
    // end of [if]
| ~TYRECKINDbox_lin() =>
    if flag > 0
      then hitype_tybox ()
      else aux_tyrec2 (flag, lxs)
    // end of [if]
//
| ~TYRECKINDflt0() => aux_tyrec2(flag, lxs)
| ~TYRECKINDflt1(stamp) => aux_tyrec2(flag, lxs)
//
| ~TYRECKINDflt_ext (name) => hit_HITnmd (name)
//
end // end of [aux_tyrec]

and
aux_tyrec2
(
  flag: int, lxs: labhisexplst
) : hitype = let
//
val lys =
  auxlablst(flag, lxs)
//
val hit = hit_HITtyrec(lys)
val opt = the_hitypemap_search(hit)
//
in
//
case+ opt of
| ~None_vt() => let
    val hit2 = hitype_gen_tyrec()
  in
    the_hitypemap_insert(hit, hit2); hit2
  end // end of [None_vt]
//
| ~Some_vt(hit2) => hit2
//
end // end of [aux_tyrec2]

and
aux_tysum
(
  flag: int, hse0: hisexp
) : hitype = let
//
val-~HSEtysum
  (d2c, lxs) = hisexp_node_view (hse0.hisexp_node ())
//
val isbox =
  (if flag > 0 then true else false): bool
//
in
//
if
isbox
then hitype_tybox ()
else let
  val tgd = (
    if d2con_is_tagless (d2c) then 0 else 1
  ) : int // end of [val]
  val lys = auxlablst (flag, lxs)
  val hit0 = hit_HITtysum (tgd, lys)
  val opt = the_hitypemap_search (hit0)
in
  case+ opt of
  | ~None_vt () => let
      val hit1 = hitype_gen_tysum ()
      val () = the_hitypemap_insert (hit0, hit1)
    in
      hit1
    end // end of [None_vt]
  | ~Some_vt (hit0) => hit0
end // end of [else]
//
end // end of [aux_tysum]

and
aux_tyexn
(
  flag: int, hse0: hisexp
) : hitype = let
//
val-~HSEtysum
  (d2c, lxs) = hisexp_node_view (hse0.hisexp_node ())
//
val isbox =
  (if flag > 0 then true else false): bool
//
in
//
if
isbox
then hitype_tybox ()
else let
  val lys = auxlablst (flag, lxs)
  val hit0 = hit_HITtyexn (lys)
  val opt = the_hitypemap_search (hit0)
in
  case+ opt of
  | ~None_vt () => let
      val hit1 = hitype_gen_tyexn ()
      val () = the_hitypemap_insert (hit0, hit1)
    in
      hit1
    end // end of [None_vt]
  | ~Some_vt (hit0) => hit0
end // end of [else]
//
end // end of [aux_tyexn]

and
auxlst
(
  flag: int, xs: hisexplst
) : hitypelst = let
in
//
if glist_is_cons (xs) then let
  val x = glist_head<hisexp> (xs)
  val xs = glist_tail<hisexp> (xs)
  val y = aux (flag+1, x)
  val ys = auxlst (flag, xs)
in
  glist_cons<hit> (y, ys)
end else glist_nil()
//
end // end of [auxlst]

and
auxlablst
(
  flag: int, lxs: labhisexplst
) : labhitlst = let
in
//
if glist_is_cons (lxs) then let
  val lx = glist_head<labhisexp> (lxs)
  val lxs = glist_tail<labhisexp> (lxs)
  val l = lx.labhisexp_lab ()
  val opt = lx.labhisexp_opt ()
  val x = lx.labhisexp_elt ()
  val y = aux (flag+1, x)
  val ly = labhit_new (l, opt, y)
  val lys = auxlablst (flag, lxs)
in
  glist_cons<labhit> (ly, lys)
end else glist_nil()
//
end // end of [auxlablst]

in (* in of [local] *)

implement
hisexp_typize (flag, x) = aux (flag, x)

end // end of [local]

(* ****** ****** *)

local

fun
auxfld
(
  out: FILEref
, lhit: labhit
) : void = let
//
val lab = lhit.labhit_lab ()
val opt = lhit.labhit_opt ()
val hit = lhit.labhit_elt ()
//
var isa: bool = false
var dim: s2explst = glist_nil ()
//
val () = (
//
if hit_is_HITtyarr (hit) then let
  val-~HITtyarr (hit_elt, s2es) = hit_view (hit)
  val () = isa := true
  val () = dim := s2es
in
  emit_hitype (out, hit_elt)
end else emit_hitype (out, hit) // non-tyarr
//
) : void // end of [val]
//
val () = emit_text (out, " ")
//
val () =
if isa then
  emit_text (out, "atstyarr_field(")
// end of [if]
//
val () = (
  if gopt_is_some (opt)
    then emit_text (out, gopt_unsome<string> (opt))
    else emit_labelext (out, 0(*extknd*), lab)
  // end of [if]
) : void // end of [val]
//
val () = (
//
if isa then
  emit_text (out, ") ;") else emit_text (out, " ;")
//
) : void // end of [val]
//
in
  // nothing
end // end of [auxfld]

fun
auxfldlst
(
  out: FILEref
, lhits: labhitlst, i: int
) : void = let
in
//
if glist_is_cons (lhits) then let
  val lhit = glist_head<labhit> (lhits)
  val lhits = glist_tail<labhit> (lhits)
  val () =
    if i > 0 then emit_newline (out)
  // end of [val]
  val () = auxfld (out, lhit)
in
  auxfldlst (out, lhits, i+1)
end else ()
//
end // end of [auxfldlst]

fun
auxkey
(
  out: FILEref, hit: hitype
) : void = let
in
//
if hit_is_HITtyrec (hit) then let
  val-~HITtyrec (lhits) = hit_view (hit)
  val () =
  emit_text (out, "ATSstruct {")
  val () = auxfldlst (out, lhits, 1)
  val ((*closing*)) = emit_text (out, "\n}")
in
  // nothing
end else if hit_is_HITtysum (hit) then let
  val-~HITtysum (tgd, lhits) = hit_view (hit)
  val () =
  emit_text (out, "ATSstruct {\n")
  val () =
  if tgd > 0 then emit_text (out, "// ")
  val () = fprint_string (out, "#if(")
  val () = fprint_int (out, tgd)
  val () = fprint_string (out, ")\n")
  val () = emit_text (out, "int contag ;\n")
  val () =
  if tgd > 0 then emit_text (out, "// ")
  val () = emit_text (out, "#endif")
  val () = auxfldlst (out, lhits, 1)
  val ((*closing*)) = emit_text (out, "\n}")
in
  // nothing
end else if hit_is_HITtyexn (hit) then let
  val-~HITtyexn (lhits) = hit_view (hit)
  val () =
  emit_text (out, "ATSstruct {\n")
  val () =
  emit_text (out, "atstype_int exntag ;\n")
  val () =
  emit_text (out, "atstype_string exnmsg ;")
  val () = auxfldlst (out, lhits, 1)
  val ((*closing*)) = emit_text (out, "\n}")
in
  // nothing
end else emit_text (out, "(**ERROR**)") // non-struct
//
end // end of [auxkey]

in (* in of [local] *)

implement
emit_the_typedeflst
  (out) = let
//
typedef
keyitm = @(hitype, hitype)
//
fun
auxlst
(
  out: FILEref
, kis: List0_vt (keyitm)
) : void = let
in
//
case+ kis of
| ~list_vt_cons
    (ki, kis) => let
//
    val
    tyvar = hitype_tyvar_test(ki.1)
//
    val () =
    if tyvar
      then emit_text(out, "#if(0)\n")
    // end of [if]
//
    val () =
    emit_text(out, "typedef\n")
    val () = auxkey (out, ki.0)
    val () = emit_text (out, " ")
    val () = emit_hitype (out, ki.1)
    val () = emit_text (out, " ;\n")
//
    val () =
    if tyvar
      then emit_text(out, "#endif\n")
    // end of [if]
//
  in
    auxlst (out, kis)
  end // end of [list_vt_cons]
| ~list_vt_nil((*void*)) => ()
//
end // end of [auxlst]
//
val () = emit_text (out, "/*\n")
val () = emit_text (out, "typedefs-for-tyrecs-and-tysums(beg)\n")
val () = emit_text (out, "*/\n")
val () = auxlst (out, the_hitypemaplst_get ())
val () = emit_text (out, "/*\n")
val () = emit_text (out, "typedefs-for-tyrecs-and-tysums(end)\n")
val () = emit_text (out, "*/\n")
//
in
  // nothing
end // end of [emit_the_typedeflst]

end // end of [local]

(* ****** ****** *)

(* end of [pats_ccomp_hitype.dats] *)
