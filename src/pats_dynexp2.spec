# arenagen specification for pats_dynexp2.{sats,dats}: the level-2 dynamic syntax (--compact)
# python3 ../utils/arenagen/arenagen.py --global sats pats_dynexp2.spec > pats_dynexp2_gen.hats
# python3 ../utils/arenagen/arenagen.py --global --compact dats pats_dynexp2.spec > pats_dynexp2_gen_dats.hats
#
# Same conventions as pats_staexp2.spec (see there and PORTING.md, "Level 2 dynamic (dynexp2)").
# The cells of ATS1 that were [ref (struct)] (d2cst, d2var, d2mac) are records with [mut] fields: they live in the
# global arena, are never freed, and their address is their identity. The ATS1 [ref (d2varlst)] of D2Elam_met is the
# record [d2varlstref]. The ATS1 one-constructor datatype [dl0abeled (d2exp)] is the record [labd2exp].
# The ordered lists [lstord (s2var)] and [lstord (d2var)] of a p2at are [s2varord] and [d2varord] (glist underneath).
# [pckind] is an enumeration: a datatype of the sats (no payload), like [funkind].
# [hisexp] and [funlab] are the placeholders (abstypes) of the sats; [filenv] is that of pats_staexp2.sats.
typedef s2varord = lstord(s2var)
typedef d2varord = lstord(d2var)
typedef hisexpopt = gopt(hisexp)
typedef funlabopt = gopt(funlab)
typedef d2cstlst = glist(d2cst)
typedef d2cstopt = gopt(d2cst)
