#
# Arch/Manjaro packaging (packaging/arch): only the PKGBUILD and its
# README are tracked; the sources, the tarball, the package and the
# other build outputs are not
#
packaging/arch/*
!packaging/arch/PKGBUILD
!packaging/arch/README
#

###### end of [.gitignore] ######

#
# generated by the .atxt pipeline (utils/atsdoc/TEST/genall.sh, the DOCUGEN
# and ATS2TUTORIAL Makefiles): what the documents write besides their text
#
**/DOCUGEN/TRYIT/*.dats
**/DOCUGEN/HTML/*.html
**/DOCUGEN/Makefile
**/DOCUGEN/Makefile2
!libats/SATS/DOCUGEN/Makefile
!npm-utils/contrib/atscntrb/atscntrb-hx-libcairo/SATS/DOCUGEN/Makefile
!npm-utils/contrib/atscntrb/atscntrb-hx-libevent/SATS/DOCUGEN/Makefile
!npm-utils/contrib/atscntrb/atscntrb-hx-libsdl2/SATS/DOCUGEN/Makefile
!prelude/SATS/DOCUGEN/DBOOK/Makefile
!utils/atscc/DOCUGEN/Makefile
!utils/atsopt/DOCUGEN/Makefile
!utils/libatslex/SATS/DOCUGEN/Makefile
!utils/tempacc/DOCUGEN/Makefile
!contrib/atscntrb/atscntrb-hx-cstream/SATS/DOCUGEN/Makefile
!contrib/atscntrb/atscntrb-hx-intinf/SATS/DOCUGEN/Makefile
!contrib/atscntrb/atscntrb-hx-libgmp/SATS/DOCUGEN/Makefile
!contrib/atscntrb/atscntrb-hx-libhiredis/SATS/DOCUGEN/Makefile
!doc/BOOK/ATS2FUNCRASH/LECTURE/MYLIB/DOCUGEN/Makefile
doc/BOOK/ATS2TUTORIAL/TEMP/*.dats

#
# the .keeper files of the directories that are ignored
#
!**/.keeper
#
# the .keeper files that the packaging copies into the release tree
#
doc/DISTRIB/ATS-Postiats/contrib/atscntrb/atscntrb-hx-cstream/SATS/DOCUGEN/HTML/.keeper
doc/DISTRIB/ATS-Postiats/contrib/atscntrb/atscntrb-hx-intinf/SATS/DOCUGEN/HTML/.keeper
doc/DISTRIB/ATS-Postiats/contrib/atscntrb/atscntrb-hx-libgmp/SATS/DOCUGEN/HTML/.keeper
doc/DISTRIB/ATS-Postiats/contrib/atscntrb/atscntrb-hx-libjansson/SATS/DOCUGEN/HTML/.keeper
doc/DISTRIB/ATS-Postiats/contrib/atscntrb/atscntrb-hx-libjansson/SATS/DOCUGEN/TRYIT/.keeper
doc/DISTRIB/ATS-Postiats/contrib/atscntrb/atscntrb-hx-libpcre/SATS/DOCUGEN/HTML/.keeper
doc/DISTRIB/ATS-Postiats/contrib/libatscc2js/HTML/Canvas/TEST/.keeper
