#
# A few simple steps to build ATS2
# This is primarily for people wanting to use the
# (unreleased) version of ATS2 available at GitHub:
#
# https://github.com/githwxi/ATS-Postiats
#

######
#
# author: Hongwei Xi (gmhwxiATgmailDOTcom)
# author: Brandon Barker (Brandon.BarkerATgmailDOTcom)
#
######
#
# Note:
#
# ATS1 is no longer needed: the compiler in src/ is written in ATS2 (no GC).
# The first patsopt (stage 0) is any ATS2 compiler or the C bundle of
# src/CBOOT; see src/README. Examples (PATSHOME is the root of this repo):
#
# make -f Makefile_devl PATSOPT=/usr/bin/patsopt \
#   STAGE0HOME=/usr/lib/ats2-postiats-0.4.2 all   # an installed ATS2
# make -C src/CBOOT && \
#   make -f Makefile_devl PATSOPT=$PWD/src/CBOOT/patsopt all
# make -f Makefile_devl all                   # bin/patsopt exists already
#
# (the generated prelude sources, prelude/*/SRCGEN/*.?ats, are in git;
# `make -f codegen/Makefile_atslib` regenerates them with bin/atsdoc (ATS2: `make -f Makefile_devl bin_atsdoc`))
#
######

CPF=cp -f
MVF=mv -f
MAKE=make
#
# PATSHOME is the root of this repository; it defaults to it and it is
# exported so that the sub-makes (the compiler, the tools and the libraries)
# find it without the environment having to be set up beforehand.
#
PATSHOME ?= $(abspath $(CURDIR))
export PATSHOME
#
# the number of parallel jobs of the build of src/ (do not use make -j on this
# Makefile: the steps of utils/atscc must not run in parallel)
JOBS ?= $(shell nproc 2>/dev/null || echo 4)

######
#
all:: bin_patscc
all:: bin_myatscc
all:: lib_patsopt
all:: atslib_update
#
#all:: bin_atspkgreloc
#
######
#
src_cleanall: ; make -C src cleanall
#
######
#
bin_patscc: \
src_patscc; \
$(MVF) utils/atscc/BUILD/patscc bin/patscc
#
src_patscc:: bin_patsopt ; \
make -C utils/atscc -f Makefile copy build clean
#
######
#
# C3NSTRINTKND (gmpknd or intknd): src/Makefile probes <gmp.h> when it is not given
#
######

bin_patsopt: \
src_patsopt; \
$(CPF) src/patsopt bin/patsopt
src_patsopt: \
src_cleanall ; \
make -C src -f Makefile -j$(JOBS) \
$(if $(C3NSTRINTKND),C3NSTRINTKND=$(C3NSTRINTKND)) all
#
######
#
bin_myatscc: \
src_myatscc; \
$(MVF) utils/myatscc/BUILD/myatscc bin/myatscc
src_myatscc: ; \
make -C utils/myatscc -f Makefile copy build clean
#
######
#
lib_patsopt:: bin_patsopt ; \
make -C src -f Makefile -j$(JOBS) \
$(if $(C3NSTRINTKND),C3NSTRINTKND=$(C3NSTRINTKND)) libatsopt.a
lib_patsopt:: ; $(CPF) src/libatsopt.a ccomp/atslib/lib/.
#
######
#
# pats2xhtml (utils/atsynmark) and libatsynmark (utils/libatsynmark), written in
# ATS2 and built on src/libatsopt.a: not part of [all]; use `make -f Makefile_devl
# bin_pats2xhtml` after [all] (it builds bin/pats2xhtml and utils/libatsynmark/BUILD/libatsynmark.a)
#
bin_pats2xhtml: ; \
make -C utils/libatsynmark -f Makefile install && make -C utils/atsynmark -f Makefile build
#
######
#
# atsdoc (utils/atsdoc) and libatsdoc (libatsdoc), written in ATS2 and built on
# src/libatsopt.a: not part of [all]; use `make -f Makefile_devl bin_atsdoc` after [all]
# (it builds bin/atsdoc and ccomp/atslib/lib/libatsdoc.a)
#
bin_atsdoc: ; \
make -C utils/atsdoc -f Makefile build libs
#
######
#
atslib_update:: ; make -C ccomp/atslib -f Makefile
atslib_cleanall:: ; make -C ccomp/atslib -f Makefile clean
#
######
#
bin_atspkgreloc:: \
src_atspkgreloc_curl ; \
$(CPF) utils/atspkgreloc/atspkgreloc_curl bin/atspkgreloc_curl
src_atspkgreloc_curl : ; $(MAKE) -C utils/atspkgreloc atspkgreloc_curl
#
bin_atspkgreloc:: \
src_atspkgreloc_wget ; \
$(CPF) utils/atspkgreloc/atspkgreloc_wget bin/atspkgreloc_wget
src_atspkgreloc_wget : ; $(MAKE) -C utils/atspkgreloc atspkgreloc_wget
#
###### end of [Makefile_devl] ######
