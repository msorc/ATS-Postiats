(*
** ATS-extsolve:
** For solving ATS-constraints
** with external SMT-solvers
*)

(* ****** ****** *)

(*
** Author: Hongwei Xi
** Authoremail: gmhwxiATgmailDOTcom
** Start time: May, 2015
*)

(* ****** ****** *)
//
// HX-2026-10: no GC
// The constraint syntax is kept in an arena:
// every function on it takes the arena (ar: !arena(l))
// and every syntax type is indexed by [l]. The arena
// encoding of the algebraic types is generated by arenagen
// from [patsolve_cnstrnt.spec].
//
(* ****** ****** *)
//
#define
ATS_PACKNAME "PATSOLVE_CNSTRNT"
//
(* ****** ****** *)
//
#staload
"libats/SATS/arena.sats"
//
(* ****** ****** *)
//
abst0ype
stamp_t0ype = int
//
typedef
stamp = stamp_t0ype
//
(* ****** ****** *)
//
fun print_stamp: stamp -> void
and prerr_stamp: stamp -> void
fun fprint_stamp: fprint_type(stamp)
//
overload print with print_stamp
overload prerr with prerr_stamp
overload fprint with fprint_stamp
//
(* ****** ****** *)

fun stamp_make(int): stamp
fun stamp_get_int(stamp): int

(* ****** ****** *)

fun hash_stamp(stamp):<> ulint

(* ****** ****** *)
//
fun
eq_stamp_stamp : (stamp, stamp) -<fun0> bool
fun
neq_stamp_stamp : (stamp, stamp) -<fun0> bool
fun
compare_stamp_stamp : (stamp, stamp) -<fun0> int
//
overload = with eq_stamp_stamp
overload != with neq_stamp_stamp
overload compare with compare_stamp_stamp
//
(* ****** ****** *)

fun the_stamp_getinc(): stamp
fun the_stamp_update(n: stamp): void

(* ****** ****** *)
//
// HX: symbols are interned (in a symbol table)
//
abstype
symbol_type(l:addr) = ptr
typedef
symbol(l:addr) = symbol_type(l)
//
abstype
symtbl_type(l:addr) = ptr
typedef
symtbl(l:addr) = symtbl_type(l)
//
fun
symtbl_make_nil
  {l:addr}(ar: !arena(l)): symtbl(l)
//
fun
symbol_make_name{l:addr}
(
  ar: !arena(l), tbl: symtbl(l), name: NSH(string)
) : symbol(l) // end-of-function
//
fun
symbol_get_name
  {l:addr}(ar: !arena(l), x: symbol(l)): astring(l)
//
fun
fprint_symbol{l:addr}
  (ar: !arena(l), out: FILEref, x: symbol(l)): void
//
fun
eq_symbol_symbol
  {l:addr}(x1: symbol(l), x2: symbol(l)):<> bool
fun
neq_symbol_symbol
  {l:addr}(x1: symbol(l), x2: symbol(l)):<> bool
//
overload = with eq_symbol_symbol
overload != with neq_symbol_symbol
//
(* ****** ****** *)
//
typedef
loc_t(l:addr) = astring(l)
//
fun
location_make{l:addr}
  (ar: !arena(l), rep: NSH(string)): loc_t(l)
//
fun
fprint_location{l:addr}
  (ar: !arena(l), out: FILEref, loc: loc_t(l)): void
//
(* ****** ****** *)
//
abstype
s2cst_type(l:addr) = ptr
typedef
s2cst(l:addr) = s2cst_type(l)
//
abstype
s2var_type(l:addr) = ptr
typedef
s2var(l:addr) = s2var_type(l)
//
abstype
s2Var_type(l:addr) = ptr
typedef
s2Var(l:addr) = s2Var_type(l)
//
(* ****** ****** *)
//
// HX: the generated arena encoding:
// label, s2rt, tyreckind, s2exp, s2exp_node, labs2exp,
// c3nstrkind, s3itm, h3ypo, h3ypo_node, c3nstr, c3nstr_node
// and c3nstropt
//
#include "./patsolve_cnstrnt_gen.hats"
//
(* ****** ****** *)
//
typedef s2rtlst(l:addr) = alist(l, s2rt(l))
typedef s2cstlst(l:addr) = alist(l, s2cst(l))
typedef s2varlst(l:addr) = alist(l, s2var(l))
typedef s2explst(l:addr) = alist(l, s2exp(l))
typedef labs2explst(l:addr) = alist(l, labs2exp(l))
typedef s3itmlst(l:addr) = alist(l, s3itm(l))
typedef s3itmlstlst(l:addr) = alist(l, s3itmlst(l))
//
vtypedef s2cstlst_vt(l:addr) = List0_vt(s2cst(l))
//
(* ****** ****** *)
//
fun
fprint_label{l:addr}
  (ar: !arena(l), out: FILEref, x: label(l)): void
//
(* ****** ****** *)
//
fun s2rt_int{l:addr}(ar: !arena(l)): s2rt(l)
fun s2rt_addr{l:addr}(ar: !arena(l)): s2rt(l)
fun s2rt_bool{l:addr}(ar: !arena(l)): s2rt(l)
fun s2rt_real{l:addr}(ar: !arena(l)): s2rt(l)
fun s2rt_float{l:addr}(ar: !arena(l)): s2rt(l)
fun s2rt_string{l:addr}(ar: !arena(l)): s2rt(l)
//
fun
s2rt_is_impred
  {l:addr}(ar: !arena(l), s2t: s2rt(l)): bool
//
fun
fprint_s2rt{l:addr}
  (ar: !arena(l), out: FILEref, x: s2rt(l)): void
fun
fprint_s2rtlst{l:addr}
  (ar: !arena(l), out: FILEref, xs: s2rtlst(l)): void
//
(* ****** ****** *)
//
abstype
s2rtdat_type(l:addr) = ptr
typedef
s2rtdat(l:addr) = s2rtdat_type(l)
typedef
s2rtdatlst(l:addr) = alist(l, s2rtdat(l))
//
fun
s2rtdat_make{l:addr}
(
  ar: !arena(l)
, name: symbol(l), stamp: stamp, s2cs: s2cstlst(l)
) : s2rtdat(l) // end-of-function
//
fun
s2rtdat_get_name
  {l:addr}(ar: !arena(l), x: s2rtdat(l)): symbol(l)
fun
s2rtdat_get_stamp
  {l:addr}(ar: !arena(l), x: s2rtdat(l)): stamp
fun
s2rtdat_get_sconlst
  {l:addr}(ar: !arena(l), x: s2rtdat(l)): s2cstlst(l)
//
fun
fprint_s2rtdat{l:addr}
  (ar: !arena(l), out: FILEref, x: s2rtdat(l)): void
//
(* ****** ****** *)
//
// HX:
// [extdef] is a null pointer or an astring
//
fun
s2cst_make{l:addr}
(
  ar: !arena(l)
, name: symbol(l), srt: s2rt(l), stamp: stamp, extdef: ptr
) : s2cst(l) // end of [s2cst_make]
//
fun
s2cst_get_srt
  {l:addr}(ar: !arena(l), x: s2cst(l)): s2rt(l)
fun
s2cst_get_name
  {l:addr}(ar: !arena(l), x: s2cst(l)): symbol(l)
fun
s2cst_get_stamp
  {l:addr}(ar: !arena(l), x: s2cst(l)): stamp
fun
s2cst_get_extdef
  {l:addr}(ar: !arena(l), x: s2cst(l)): Option_vt(astring(l))
//
fun
s2cst_get_nused
  {l:addr}(ar: !arena(l), x: s2cst(l)): int
fun
s2cst_incby1_nused
  {l:addr}(ar: !arena(l), x: s2cst(l)): void
//
// HX: for the solver (initially a null pointer)
//
fun
s2cst_get_payload
  {l:addr}(ar: !arena(l), x: s2cst(l)): ptr
fun
s2cst_set_payload
  {l:addr}(ar: !arena(l), x: s2cst(l), payload: ptr): void
//
fun
fprint_s2cst{l:addr}
  (ar: !arena(l), out: FILEref, x: s2cst(l)): void
fun
fprint_s2cstlst{l:addr}
  (ar: !arena(l), out: FILEref, xs: s2cstlst(l)): void
//
(* ****** ****** *)
//
fun
s2var_make{l:addr}
(
  ar: !arena(l), name: symbol(l), srt: s2rt(l), stamp: stamp
) : s2var(l) // end of [s2var_make]
//
fun
s2var_get_srt
  {l:addr}(ar: !arena(l), x: s2var(l)): s2rt(l)
fun
s2var_get_name
  {l:addr}(ar: !arena(l), x: s2var(l)): symbol(l)
fun
s2var_get_stamp
  {l:addr}(ar: !arena(l), x: s2var(l)): stamp
//
fun
s2var_is_impred
  {l:addr}(ar: !arena(l), x: s2var(l)): bool
//
// HX: for the solver (initially a null pointer)
//
fun
s2var_get_payload
  {l:addr}(ar: !arena(l), x: s2var(l)): ptr
fun
s2var_set_payload
  {l:addr}(ar: !arena(l), x: s2var(l), payload: ptr): void
//
fun
fprint_s2var{l:addr}
  (ar: !arena(l), out: FILEref, x: s2var(l)): void
fun
fprint_s2varlst{l:addr}
  (ar: !arena(l), out: FILEref, xs: s2varlst(l)): void
//
(* ****** ****** *)
//
fun
s2Var_make{l:addr}
  (ar: !arena(l), stamp: stamp): s2Var(l)
//
fun
s2Var_get_stamp
  {l:addr}(ar: !arena(l), x: s2Var(l)): stamp
//
fun
fprint_s2Var{l:addr}
  (ar: !arena(l), out: FILEref, x: s2Var(l)): void
//
(* ****** ****** *)
//
fun
fprint_tyreckind{l:addr}
  (ar: !arena(l), out: FILEref, x: tyreckind(l)): void
//
(* ****** ****** *)
//
fun
s2exp_make_node{l:addr}
(
  ar: !arena(l), s2t: s2rt(l), node: s2exp_node(l)
) : s2exp(l) // end of [s2exp_make_node]
//
fun
s2exp_var{l:addr}
  (ar: !arena(l), s2v: s2var(l)): s2exp(l)
fun
s2exp_eqeq{l:addr}
  (ar: !arena(l), s2e1: s2exp(l), s2e2: s2exp(l)): s2exp(l)
//
fun
s2exp_is_impred
  {l:addr}(ar: !arena(l), s2e: s2exp(l)): bool
//
fun
fprint_s2exp{l:addr}
  (ar: !arena(l), out: FILEref, x: s2exp(l)): void
fun
fprint_s2explst{l:addr}
  (ar: !arena(l), out: FILEref, xs: s2explst(l)): void
//
fun
fprint_labs2exp{l:addr}
  (ar: !arena(l), out: FILEref, x: labs2exp(l)): void
fun
fprint_labs2explst{l:addr}
  (ar: !arena(l), out: FILEref, xs: labs2explst(l)): void
//
(* ****** ****** *)
//
fun
h3ypo_make_node{l:addr}
(
  ar: !arena(l), loc: loc_t(l), node: h3ypo_node(l)
) : h3ypo(l) // end of [h3ypo_make_node]
//
fun
c3nstr_make_node{l:addr}
(
  ar: !arena(l)
, loc: loc_t(l), knd: c3nstrkind(l), node: c3nstr_node(l)
) : c3nstr(l) // end of [c3nstr_make_node]
//
(* ****** ****** *)
//
fun
fprint_s3itm{l:addr}
  (ar: !arena(l), out: FILEref, x: s3itm(l)): void
fun
fprint_s3itmlst{l:addr}
  (ar: !arena(l), out: FILEref, xs: s3itmlst(l)): void
fun
fprint_s3itmlstlst{l:addr}
  (ar: !arena(l), out: FILEref, xss: s3itmlstlst(l)): void
//
fun
fprint_h3ypo{l:addr}
  (ar: !arena(l), out: FILEref, x: h3ypo(l)): void
//
fun
fprint_c3nstr{l:addr}
  (ar: !arena(l), out: FILEref, x: c3nstr(l)): void
fun
fprint_c3nstropt{l:addr}
  (ar: !arena(l), out: FILEref, x: c3nstropt(l)): void
//
// HX-2015-05-25:
// pretty-printing
//
fun
fpprint_c3nstr{l:addr}
  (ar: !arena(l), out: FILEref, x: c3nstr(l)): void
//
(* ****** ****** *)

(* end of [patsolve_cnstrnt.sats] *)
