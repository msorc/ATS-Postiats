PATSCC=$(PATSHOME)/bin/patscc
PATSOPT=$(PATSHOME)/bin/patsopt

######
#
LDPATH :=
LDPATH := -L$(PATSHOME)/ccomp/atslib/lib
# LDPATH += -L$(PATSHOME)/utils/libatsopt
# LDPATH += -L$(PATSHOME)/utils/libatsynmark
#
LIBRARY = -latslib
#
ATSRUNTIME=$(ATSHOME)/ccomp/runtime
#
######

MYTEXTING=\
mylib_atexting

######

all:: \
$(MYTEXTING)

######
#
$(MYTEXTING): \
$(MYTEXTING).dats ; \
$(PATSCC) -O2 -o $@ \
-D_GNU_SOURCE -DATS_MEMALLOC_LIBC \
$(MYTEXTING).dats $(LDPATH) $(LIBRARY)
#
######
#
regress:: \
$(MYTEXTING) ; \
./$(MYTEXTING) < ./mylib_dats.atxt > mylib_atxt.dats
#
regress:: \
$(MYTEXTING) ; \
./$(MYTEXTING) < ./mylib_html.atxt > mylib_atxt.html
#
######

RMF=rm -f

######

clean:: ; $(RMF) *~
clean:: ; $(RMF) *_dats.c

######

cleanall:: clean
cleanall:: ; $(RMF) $(MYTEXTING)

