######
#
# A simple Makefile
#
######
#
PATSCC=$(PATSHOMEQ)/bin/patscc
ATSDOC=$(PATSHOMEQ)/bin/atsdoc
#
#LIBATSDOC=$(PATSHOMEQ)/ccomp/atslib/lib
#
######

# PATSHOME is the root of the ATS2 repository (or of an installation of
# ATS2); it defaults to the root of this repository.
PATSHOME ?= $(abspath ../../../..)
export PATSHOME
PATSHOMEQ="$(PATSHOME)"

######

all:: main.db clean

######
#
main.exe: \
main_atxt.dats ; \
  $(PATSCC) -DATS_MEMALLOC_LIBC -o $@ main_atxt.dats -latsdoc -latslib
#
main_atxt.dats: main.atxt ; \
  $(ATSDOC) --outcode $@ -i main.atxt > main_atxt.txt
#
main.db: main.exe ; ./main.exe > $@
#
######

RMF=rm -f

######

testall:: ; $(MAKE) -C 01/CODE testall
testall:: ; $(MAKE) -C 02/CODE testall
testall:: ; $(MAKE) -C 03/CODE testall
testall:: ; $(MAKE) -C 03-10/CODE testall
testall:: ; $(MAKE) -C 04/CODE testall
testall:: ; $(MAKE) -C 04-10/CODE testall
testall:: ; $(MAKE) -C 05/CODE testall
testall:: ; $(MAKE) -C 06/CODE testall
testall:: ; $(MAKE) -C 06-20/CODE testall
testall:: ; $(MAKE) -C 07/CODE testall
testall:: ; $(MAKE) -C 07-10/CODE testall
testall:: ; $(MAKE) -C 08/CODE testall
testall:: ; $(MAKE) -C 08-10/CODE testall
testall:: ; $(MAKE) -C 09/CODE testall
testall:: ; $(MAKE) -C 10/CODE testall
testall:: ; $(MAKE) -C 10-10/CODE testall
testall:: ; $(MAKE) -C 11/CODE testall
testall:: ; $(MAKE) -C 12/CODE testall
testall:: ; $(MAKE) -C 12-10/CODE testall

######

clean:: ; $(RMF) *~
clean:: ; $(RMF) *_?ats.o
clean:: ; $(RMF) *_?ats.c
clean:: ; $(RMF) *_atxt.txt
clean:: ; $(RMF) *_atxt.dats

cleanall:: clean
cleanall:: ; $(RMF) main.db
cleanall:: ; $(RMF) main.exe

