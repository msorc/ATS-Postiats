url=\"https://ats-lang.github.io/DOCUMENT/ATS2FUNCRASH/LECTURE/04-10/CODE/DigitClock.html\">https://ats-lang.github.io/DOCUMENT/ATS2FUNCRASH/LECTURE/04-10/CODE/DigitClock.html</ulink>
")#comment("para")
</listitem>

