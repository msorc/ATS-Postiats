######
#
# A simple Makefile
#
######

PATSHOMEQ="$(PATSHOME)"
PATSCC=$(PATSHOMEQ)/bin/patscc
ATSDOC=$(PATSHOMEQ)/bin/atsdoc
#LIBATSDOC=$(PATSHOMEQ)/ccomp/atslib/lib

######

all:: main.db clean

######

main: main_atxt.dats
	$(PATSCC) -DATS_MEMALLOC_LIBC -o $@ main_atxt.dats -latsdoc
main_atxt.dats: main.atxt
	$(ATSDOC) --outcode $@ -i main.atxt > main_atxt.txt
main.db: main ; ./main > $@

######

RMF=rm -f

######

clean:: ; $(RMF) *~
clean:: ; $(RMF) *_atxt.txt
clean:: ; $(RMF) *_atxt.dats
clean:: ; $(RMF) *_?ats.o
clean:: ; $(RMF) *_?ats.c
clean:: ; $(RMF) main

cleanall:: clean
cleanall:: ; $(RMF) main.db

######
