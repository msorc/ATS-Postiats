##
##
## A Makefile template for compiling ATS programs
##
##

######
#
# PATSHOME is the root of the ATS2 repository or of an installation
# of ATS2; its [bin] directory holds [patscc] and [patsopt].
#
PATSHOMEQ="$(PATSHOME)"
#
######
#
PATSCC=$(PATSHOMEQ)/bin/patscc
PATSOPT=$(PATSHOMEQ)/bin/patsopt
#
######
#
#
# HX: Please uncomment the one you want, or skip it entirely
#
PATSCCFLAGS=
# PATSCCFLAGS=-O2
#
# '-flto' enables link-time optimization such as inlining lib functions
#
# PATSCCFLAGS=-O2 -flto
#
#
######
#
cleanall::
#
######
#
# Please uncomment the following three lines and replace the name [foo]
# with the name of the file you want to compile
#
# foo: foo.dats ; \
#   $(PATSCC) $(PATSCCFLAGS) -o $@ $< || echo $@ ": ERROR!!!"
# cleanall:: ; $(RMF) foo
#
######
#
# You may find these rules useful
#
# %_sats.o: %.sats ; $(PATSCC) $(PATSCCFLAGS) -c $< || echo $@ ": ERROR!!!"
# %_dats.o: %.dats ; $(PATSCC) $(PATSCCFLAGS) -c $< || echo $@ ": ERROR!!!"
#
######
#
RMF=rm -f
#
######
#
clean:: ; $(RMF) *~
clean:: ; $(RMF) *_?ats.o
clean:: ; $(RMF) *_?ats.c
#
cleanall:: clean
#
###### end of [Makefile] ######
