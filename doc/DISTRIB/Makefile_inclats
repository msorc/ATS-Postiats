#
# A simple Makefile
# for packing ATS-includes
#

######
#
SRC=ATS-Postiats
DST=ATS-Postiats-include
#
# SRC2=ATS-Postiats-contrib
# DST2=ATS-Postiats-include/patscontrib
#
######

all:: update
all:: update2

######

CPF=cp -f
CPRF=cp -rf

######
update::
######
update:: ; \
$(CPF) $(SRC)/share/atsmake-pre.mk $(DST)/share/.
update:: ; \
$(CPF) $(SRC)/share/atsmake-post.mk $(DST)/share/.
######
update:: ; \
$(CPF) $(SRC)/share/H/pats_atslib.h $(DST)/share/H/.
######
update:: ; \
$(CPF) $(SRC)/ccomp/runtime/*.h $(DST)/ccomp/runtime/.
update:: ; \
$(CPF) $(SRC)/ccomp/runtime/*.c $(DST)/ccomp/runtime/.
######
update:: ; \
$(CPF) $(SRC)/prelude/CATS/*.cats $(DST)/prelude/CATS/.
######
update:: ; \
$(CPF) $(SRC)/libats/CATS/*.cats $(DST)/libats/CATS/.
######
update:: ; \
$(CPF) $(SRC)/libats/libc/CATS/*.cats $(DST)/libats/libc/CATS/.
update:: ; \
$(CPF) $(SRC)/libats/libc/CATS/sys/*.cats $(DST)/libats/libc/CATS/sys/.
update:: ; \
$(CPF) $(SRC)/libats/libc/CATS/arpa/*.cats $(DST)/libats/libc/CATS/arpa/.
update:: ; \
$(CPF) $(SRC)/libats/libc/CATS/netinet/*.cats $(DST)/libats/libc/CATS/netinet/.
update:: ; \
$(CPF) $(SRC)/libats/libc/CATS/gdbm/*.cats $(DST)/libats/libc/CATS/gdbm/.
#
######
#
# The C code of patscc and myatscc is the output of patsopt: it is
# generated when the package is built (it is not kept in git).
#
######
#
PATSOPT=$(PATSHOME)/bin/patsopt
#
DATS_C_ATSCC=$(DST)/utils/atscc/DATS_C
DATS_C_MYATSCC=$(DST)/utils/myatscc/DATS_C
#
DATS_C::
	$(PATSOPT) --output $(DATS_C_ATSCC)/patscc_dats.c --dynamic $(PATSHOME)/utils/atscc/DATS/patscc.dats
	$(PATSOPT) --output $(DATS_C_ATSCC)/atscc_main_dats.c --dynamic $(PATSHOME)/utils/atscc/DATS/atscc_main.dats
	$(PATSOPT) --output $(DATS_C_ATSCC)/atscc_print_dats.c --dynamic $(PATSHOME)/utils/atscc/DATS/atscc_print.dats
	$(PATSOPT) --output $(DATS_C_MYATSCC)/myatscc_all_dats.c --dynamic $(PATSHOME)/utils/myatscc/DATS/myatscc_main.dats
