%{
//
dynload
"libatsdoc/dynloadall.dats"
//
staload
"libatsdoc/SATS/libatsdoc_atext.sats"
//
#include "utils/atsdoc/HATS/atsdoc_compat.hats"
//
extern
fun
comment(x: string): atext
//
extern
fun packpreamble(): atext
extern
fun packpostamble(): atext
extern
fun packtitle(x: string): atext
//
extern
fun packfilename(x: string): atext
extern
fun packfilename_r(x: string): atext
//
extern
fun packfilesynop(x: string): atext
//
%} // end of [%{]

(* ****** ****** *)

%{
//
implement
comment(x) = atext_nil()
//
%} // end of [%{]

(* ****** ****** *)

%{

implement
packpreamble
  () = let
//
val
out = stdout_ref
//
val () =
fprint_string(out, "\
#!/bin/bash\n\
#\n\
# This script is automatically generated.\n\
#\n\
\n\
SOURCE=./../../contrib/afiber\n\
TARGET=ATS-Postiats/contrib/afiber\n\
\n\
srcget()\n\
{\n\
cp -f ${SOURCE}/$1 ${TARGET}/$1 ;\n\
}\n\
\n\
srcget_r()\n\
{\n\
rm -rf ${TARGET}/$1 ;\n\
cp -rf ${SOURCE}/$1 ${TARGET}/$1 ;\n\
}\n\
\n\
") // end of [val]
//
in
  atext_nil((*void*))
end // end of [packpreamble]

implement
packpostamble
  () = let
val
out = stdout_ref
val () =
fprint_string(out, "\
#\n\
echo \"The contrib/afiber files have been copied.\"\n\
#\n\
# end of the automatically generated script\n\
#\n\
")
in
  atext_nil((*void*))
end // end of [packpostamble]

implement
packtitle
  (x) = atext_nil()
//
implement
packfilename
  (x) = let
//
val
out = stdout_ref
//
val () =
fprintf (
  out, "srcget \"%s\" ;\n", @(x)
) (* fprintf *)
//
in
  atext_nil((*void*))
end // end of [packfilename]
//
implement
packfilename_r
  (x) = let
//
val
out =
stdout_ref
//
val () =
fprintf (
  out, "srcget_r \"%s\" ;\n", @(x)
) (* fprintf *)
//
in
  atext_nil((*void*))
end // end of [packfilename_r]
//
implement
packfilesynop(x) = atext_nil()
//
%} // end of [%{]

(* ****** ****** *)

#packpreamble()

(* ****** ****** *)

#packtitle("contrib/afiber")

(* ****** ****** *)

#packfilename("README.md")
#packfilename("mylibies.hats")
#packfilename_r("CATS")
#packfilename_r("SATS")
#packfilename_r("DATS")
#packfilename_r("TEST")

(* ****** ****** *)

#packpostamble()

(* ****** ****** *)

%{
//
implement main0() = () where { }
//
%} // end of [%{]

(* ****** ****** *)

(* end of [contrib_afiber.atxt] *)
