(* SPDX-FileCopyrightText: 2026 Mikhail Sorochan *)
(* SPDX-License-Identifier: MIT *)
(*
** HX-2026-10: no GC
** Shared (nonlinear) data in an arena: the
** syntax tree below shares a subtree, and all of
** it is released at once when the arena is freed.
** (The arena encoding of [exp] is generated by
** arenagen from the following specification:
**
**   type exp
**     EXPint (int)
**     EXPvar (astring(l))
**     EXPadd (exp(l), exp(l))
**     EXPlet (astring(l), exp(l), exp(l))
** )
*)
#include "share/atspre_staload.hats"
staload UN = "prelude/SATS/unsafe.sats"
staload "libats/SATS/arena.sats"
staload _ = "libats/DATS/arena.dats"
//
(* ****** ****** *)
//
// HX: the generated interface
//
abstype
exp_type(l:addr) = ptr
typedef
exp(l:addr) = exp_type(l)

//
datavtype
exp_view(l:addr) =
  | EXPint of (int)
  | EXPvar of (astring(l))
  | EXPadd of (exp(l), exp(l))
  | EXPlet of (astring(l), exp(l), exp(l))
//
extern
fun
exp_encode{l:addr}(ar: !arena(l), v: exp_view(l)): exp(l)
extern
fun
exp_view{l:addr}(ar: !arena(l), x: exp(l)): exp_view(l)
extern
fun
exp_view_free{l:addr}(v: exp_view(l)): void
extern
fun
exp_tag{l:addr}(ar: !arena(l), x: exp(l)): int
extern
fun
exp_EXPint{l:addr}(ar: !arena(l), a0: int): exp(l)
extern
fun
exp_EXPvar{l:addr}(ar: !arena(l), a0: astring(l)): exp(l)
extern
fun
exp_EXPadd{l:addr}(ar: !arena(l), a0: exp(l), a1: exp(l)): exp(l)
extern
fun
exp_EXPlet{l:addr}(ar: !arena(l), a0: astring(l), a1: exp(l), a2: exp(l)): exp(l)
//
(* ****** ****** *)
//
// HX: the generated implementation
//
implement
exp_EXPint
  {l}(ar, a0) = let
val p = arena_alloc(ar, i2sz(32))
val () = $UN.ptr0_set<int>(p, 0)
val () = $UN.ptr0_set<int>(ptr_add<byte>(p, 8), a0)
in
  $UN.cast{exp(l)}(p)
end // end of [exp_EXPint]

implement
exp_EXPvar
  {l}(ar, a0) = let
val p = arena_alloc(ar, i2sz(32))
val () = $UN.ptr0_set<int>(p, 1)
val () = $UN.ptr0_set<astring(l)>(ptr_add<byte>(p, 8), a0)
in
  $UN.cast{exp(l)}(p)
end // end of [exp_EXPvar]

implement
exp_EXPadd
  {l}(ar, a0, a1) = let
val p = arena_alloc(ar, i2sz(32))
val () = $UN.ptr0_set<int>(p, 2)
val () = $UN.ptr0_set<exp(l)>(ptr_add<byte>(p, 8), a0)
val () = $UN.ptr0_set<exp(l)>(ptr_add<byte>(p, 16), a1)
in
  $UN.cast{exp(l)}(p)
end // end of [exp_EXPadd]

implement
exp_EXPlet
  {l}(ar, a0, a1, a2) = let
val p = arena_alloc(ar, i2sz(32))
val () = $UN.ptr0_set<int>(p, 3)
val () = $UN.ptr0_set<astring(l)>(ptr_add<byte>(p, 8), a0)
val () = $UN.ptr0_set<exp(l)>(ptr_add<byte>(p, 16), a1)
val () = $UN.ptr0_set<exp(l)>(ptr_add<byte>(p, 24), a2)
in
  $UN.cast{exp(l)}(p)
end // end of [exp_EXPlet]

implement
exp_encode
  {l}(ar, v) =
(
case+ v of
| ~EXPint(a0) => exp_EXPint(ar, a0)
| ~EXPvar(a0) => exp_EXPvar(ar, a0)
| ~EXPadd(a0, a1) => exp_EXPadd(ar, a0, a1)
| ~EXPlet(a0, a1, a2) => exp_EXPlet(ar, a0, a1, a2)
) (* end of [exp_encode] *)

implement
exp_tag
  (ar, x) = $UN.ptr0_get<int>($UN.cast{ptr}(x))

implement
exp_view
  {l}(ar, x) = let
//
val p = $UN.cast{ptr}(x)
val tag = $UN.ptr0_get<int>(p)
//
in
//
case+ tag of
| 0 => EXPint($UN.ptr0_get<int>(ptr_add<byte>(p, 8)))
| 1 => EXPvar($UN.ptr0_get<astring(l)>(ptr_add<byte>(p, 8)))
| 2 => EXPadd($UN.ptr0_get<exp(l)>(ptr_add<byte>(p, 8)), $UN.ptr0_get<exp(l)>(ptr_add<byte>(p, 16)))
| _ => EXPlet($UN.ptr0_get<astring(l)>(ptr_add<byte>(p, 8)), $UN.ptr0_get<exp(l)>(ptr_add<byte>(p, 16)), $UN.ptr0_get<exp(l)>(ptr_add<byte>(p, 24)))
//
end // end of [exp_view]

implement
exp_view_free
  (v) =
(
case+ v of
| ~EXPint(_) => ()
| ~EXPvar(_) => ()
| ~EXPadd(_, _) => ()
| ~EXPlet(_, _, _) => ()
) (* end of [exp_view_free] *)

(* ****** ****** *)
//
// HX: an environment maps names to values
//
typedef env(l:addr) = alist(l, @(astring(l), int))
//
fun
env_find{l:addr}
(
  ar: !arena(l), env: env(l), x: astring(l)
) : int =
(
case+
alist_uncons(ar, env)
of // case+
| ~None_vt() => 0
| ~Some_vt(kvs) =>
  (
    if astring_compare(ar, kvs.0.0, x) = 0
      then kvs.0.1 else env_find(ar, kvs.1, x)
    // end of [if]
  )
) (* end of [env_find] *)
//
fun
eval{l:addr}
(
  ar: !arena(l), env: env(l), e: exp(l)
) : int =
(
case+ exp_view(ar, e) of
| ~EXPint(i) => i
| ~EXPvar(x) => env_find(ar, env, x)
| ~EXPadd(e1, e2) => eval(ar, env, e1) + eval(ar, env, e2)
| ~EXPlet(x, e1, e2) =>
    eval(ar, alist_cons(ar, @(x, eval(ar, env, e1)), env), e2)
) (* end of [eval] *)
//
fun
fprint_exp{l:addr}
(
  ar: !arena(l), out: FILEref, e: exp(l)
) : void =
(
case+ exp_view(ar, e) of
| ~EXPint(i) => fprint_int(out, i)
| ~EXPvar(x) => astring_fprint(ar, out, x)
| ~EXPadd(e1, e2) =>
  (
    fprint(out, "(");
    fprint_exp(ar, out, e1); fprint(out, " + "); fprint_exp(ar, out, e2);
    fprint(out, ")")
  )
| ~EXPlet(x, e1, e2) =>
  (
    fprint(out, "let "); astring_fprint(ar, out, x);
    fprint(out, " = "); fprint_exp(ar, out, e1);
    fprint(out, " in "); fprint_exp(ar, out, e2)
  )
) (* end of [fprint_exp] *)
//
implement
main0 () = {
//
val ar = arena_make_nil()
//
val x = astring_make(ar, "x")
// [e12] is shared by two parent nodes
val e12 = exp_EXPadd(ar, exp_EXPint(ar, 1), exp_EXPint(ar, 2))
val ex = exp_EXPvar(ar, x)
val e = exp_EXPlet(ar, x, e12, exp_EXPadd(ar, ex, e12))
//
val () = (fprint_exp(ar, stdout_ref, e); print_newline())
val () = println! ("value = ", eval(ar, alist_nil(), e))
val () = println! ("nodes = ", exp_tag(ar, e), " (tag of the root)")
//
val () = arena_free(ar) // everything is released here
//
} (* end of [main0] *)
